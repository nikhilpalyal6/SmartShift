                                            <!-- Panel: Info Settings -->
                                            <StackPanel x:Name="DocxInfoSettingsPanel" Visibility="Collapsed">
                                                <TextBlock Text="Word Document Information" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
