<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design System Colors: Warm Dark Obsidian & Sunset Glassmorphism -->
    <Color x:Key="WindowBgColor">#090D15</Color>
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />

    <!-- Ambient Dark Gradient for Window Background -->
    <LinearGradientBrush x:Key="WindowBgGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#080B12" Offset="0" />
        <GradientStop Color="#0F131C" Offset="0.5" />
        <GradientStop Color="#0A0D15" Offset="1" />
    </LinearGradientBrush>

    <!-- Translucent Layered Surfaces -->
    <Color x:Key="SurfaceColor">#11151F</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />

    <Color x:Key="SurfaceAltColor">#161B26</Color>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />

    <Color x:Key="SurfaceElevatedColor">#1D2331</Color>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />

    <!-- Premium Glassmorphism Translucent Surface Brushes -->
    <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0131722" Offset="0" />
        <GradientStop Color="#E60D1018" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EE161B27" Offset="0" />
        <GradientStop Color="#E610141E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2212738" Offset="0" />
        <GradientStop Color="#E6151B27" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardSelectedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2271D15" Offset="0" />
        <GradientStop Color="#E61B130E" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassSidebarBrush" Color="#EE0B0E17" />
    <SolidColorBrush x:Key="CardBrush" Color="#131722" />

    <!-- Thin, Low-Contrast Borders with Specular Tint -->
    <Color x:Key="BorderColor">#202636</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <Color x:Key="BorderLightColor">#364156</Color>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#181D29" />

    <!-- Accents: Vibrant Sunset Coral-Orange to Fiery Amber Gradient (Harmonized with Radial Petal) -->
    <Color x:Key="AccentColor">#F97316</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2BF97316" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#4DEA580C" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F97316" Offset="0" />
        <GradientStop Color="#EA580C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RadialActiveGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F97316" Offset="0" />
        <GradientStop Color="#EA580C" Offset="1" />
    </LinearGradientBrush>

    <!-- Semantic Feedback Colors -->
    <Color x:Key="OkColor">#10B981</Color>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="#1F10B981" />
    <SolidColorBrush x:Key="OkBgBrush" Color="#0D241B" />

    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0" />
        <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="WarnColor">#F59E0B</Color>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#2BF59E0B" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#261608" />

    <Color x:Key="DangerColor">#EF4444</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2BEF4444" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#260E12" />

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#64748B" />

