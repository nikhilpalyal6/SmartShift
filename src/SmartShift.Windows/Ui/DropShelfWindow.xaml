<Window x:Class="SmartShift.Windows.Ui.DropShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartShift Drop Shelf"
        Width="360"
        Height="280"
        MinWidth="280"
        MinHeight="200"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        AllowsTransparency="False"
        Background="#F4F6FB"
        AllowDrop="True">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   FontWeight="SemiBold"
                   FontSize="16"
                   Text="Drop Shelf (inspect only)" />
        <TextBlock x:Name="SummaryText"
                   DockPanel.Dock="Top"
                   Margin="0,8,0,8"
                   TextWrapping="Wrap"
                   Text="Drop files here. Originals are never moved or copied." />
        <ListBox x:Name="FileList" />
    </DockPanel>
</Window>
