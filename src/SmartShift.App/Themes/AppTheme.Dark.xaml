<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme color mappings aligned with AppTheme dark navy design system -->
    <Color x:Key="WindowBgColor">#080C14</Color>
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />

    <LinearGradientBrush x:Key="WindowBgGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#080C14" Offset="0" />
        <GradientStop Color="#0D1322" Offset="0.5" />
        <GradientStop Color="#090E1A" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="SurfaceColor">#111827</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />

    <Color x:Key="SurfaceAltColor">#152035</Color>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />

    <Color x:Key="SurfaceElevatedColor">#1B2742</Color>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />

    <!-- Premium Glassmorphism Translucent Surface Brushes -->
    <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E610192A" Offset="0" />
        <GradientStop Color="#D90D1424" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EE142036" Offset="0" />
        <GradientStop Color="#E6101A2C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F21C2B47" Offset="0" />
        <GradientStop Color="#E615223A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardSelectedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2182B4D" Offset="0" />
        <GradientStop Color="#E612203A" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassSidebarBrush" Color="#EE0B101E" />
    <SolidColorBrush x:Key="CardBrush" Color="#131D31" />

    <Color x:Key="BorderColor">#1E2C48</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <Color x:Key="BorderLightColor">#2A3C62</Color>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#162238" />

    <Color x:Key="AccentColor">#3B82F6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2846" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#333B82F6" />

    <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#64748B" />

    <Color x:Key="OkColor">#10B981</Color>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="#073B2E" />
    <SolidColorBrush x:Key="OkBgBrush" Color="#0A231C" />

    <Color x:Key="WarnColor">#F59E0B</Color>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#54280B" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#261608" />

    <Color x:Key="DangerColor">#EF4444</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#591717" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#260E12" />
</ResourceDictionary>