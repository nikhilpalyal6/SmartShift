                                    <!-- Back / Close Button -->
                                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="CloseDocBuilder_Click"
                                            Padding="10,6" Margin="0,0,14,0" ToolTip="Return to single-file workspace">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Workspace" FontWeight="SemiBold" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Right Action Buttons -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Click="OpenOutputs_Click"
                                                Padding="12,6" Margin="0,0,8,0" ToolTip="Open the SmartShift output directory in Windows Explorer">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconFolderGeometry}" Fill="{DynamicResource MutedBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="Open Outputs" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Build / Export Document Button -->
                                        <Button x:Name="DocBuilderExportBtn" Style="{StaticResource PrimaryButton}" Click="ExportDocument_Click"
                                                Padding="16,6" ToolTip="Generate document with current settings">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconDocumentGeometry}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock x:Name="DocBuilderExportBtnText" Text="Build PDF" FontWeight="Bold" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Mode Switcher & Title in Center/Left -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDocumentGeometry}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="Document Builder" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,14,0" />

                                        <!-- Mode Toggle Buttons -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="DocBuilderModePdfBtn" Style="{StaticResource PrimaryButton}" Padding="10,4" Click="DocBuilderModePdf_Click" ToolTip="Assemble images into one PDF document">
                                                    <TextBlock Text="PDF Document" FontSize="11" FontWeight="SemiBold" />
                                                </Button>
                                                <Button x:Name="DocBuilderModePptxBtn" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="2,0,0,0" Click="DocBuilderModePptx_Click" ToolTip="Assemble images into one PowerPoint (PPTX) presentation">
                                                    <TextBlock Text="PowerPoint (PPTX)" FontSize="11" FontWeight="SemiBold" />
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Item count pill -->
                                        <Border x:Name="DocBuilderCountBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="DocBuilderCountText" Text="0 images" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Main Content (3 Columns: Ordered Collection, Live Preview Canvas, Settings Panel) -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <!-- Left Column: Ordered Collection & Sequencing -->
                                    <ColumnDefinition Width="340" MinWidth="280" MaxWidth="440" />
                                    <!-- Center Column: Document Layout & Page Preview -->
                                    <ColumnDefinition Width="*" MinWidth="400" />
                                    <!-- Right Column: Settings & Configuration -->
                                    <ColumnDefinition Width="320" MinWidth="270" MaxWidth="400" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Ordered Image Collection Panel -->
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,1,0" Padding="14">
                                    <DockPanel LastChildFill="True">
                                        <!-- Collection Header -->
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <TextBlock Text="Page / Slide Sequence" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource PrimaryButton}" Click="DocBuilderAddImages_Click" Padding="10,4" Margin="0,0,6,0"
                                                        ToolTip="Add JPEG, PNG, or WebP images to the document">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlusGeometry}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" />
                                                        <TextBlock Text="Add Images" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Click="DocBuilderClearCollection_Click" Padding="8,4"
                                                        ToolTip="Clear image collection. Disk files are never deleted.">
                                                    <TextBlock Text="Clear" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Help Note -->
                                        <Border DockPanel.Dock="Top" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                                            <TextBlock Text="Use the arrows to reorder pages/slides. Originals are never modified."
                                                       Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" LineHeight="14" />
                                        </Border>

                                        <!-- Empty Placeholder -->
                                        <Border x:Name="DocBuilderEmptyPlaceholder" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Center" Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconUploadGeometry}" Fill="{DynamicResource MutedBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,0,10" HorizontalAlignment="Center" />
                                                <TextBlock Text="No images selected" FontWeight="SemiBold" FontSize="12.5" TextAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="Add images using the button above or drag files from Explorer." Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <Button Style="{StaticResource PrimaryButton}" Content="Add Images" Click="DocBuilderAddImages_Click" HorizontalAlignment="Center" Padding="14,6" />
                                            </StackPanel>
                                        </Border>

                                        <!-- ListBox of Collection Items -->
                                        <ListBox x:Name="DocBuilderFileList" BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="DocBuilderFileList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <!-- Sequence Number Badge -->
                                                                <ColumnDefinition Width="Auto" />
                                                                <!-- File Info -->
                                                                <ColumnDefinition Width="*" />
                                                                <!-- Reorder & Remove Buttons -->
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Sequence Badge -->
                                                            <Border Grid.Column="0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PositionText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>

                                                            <!-- File Information Block -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11.5"
                                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <Border Background="{Binding FormatTagBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding Extension}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Sequence Manipulation Controls -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Move Up -->
                                                                <Button Style="{StaticResource GhostButton}" Padding="4" Margin="0,0,2,0"
                                                                        Click="DocBuilderMoveUp_Click" Tag="{Binding}" IsEnabled="{Binding CanMoveUp}"
                                                                        ToolTip="Move up / earlier in document">
                                                                    <Path Data="M7 14l5-5 5 5z" Fill="{DynamicResource TextBrush}" Width="11" Height="11" Stretch="Uniform" />
                                                                </Button>
                                                                <!-- Move Down -->
                                                                <Button Style="{StaticResource GhostButton}" Padding="4" Margin="0,0,4,0"
                                                                        Click="DocBuilderMoveDown_Click" Tag="{Binding}" IsEnabled="{Binding CanMoveDown}"
                                                                        ToolTip="Move down / later in document">
                                                                    <Path Data="M7 10l5 5 5-5z" Fill="{DynamicResource TextBrush}" Width="11" Height="11" Stretch="Uniform" />
                                                                </Button>
                                                                <!-- Remove Item -->
                                                                <Button Style="{StaticResource GhostButton}" Padding="4"
                                                                        Click="DocBuilderRemoveItem_Click" Tag="{Binding}" ToolTip="Remove from document">
                                                                    <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="9" Height="9" Stretch="Uniform" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <!-- Column 1: Document Live Preview Canvas -->
                                <Border Grid.Column="1" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,1,0" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Top Preview Meta Banner -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Interactive Render Canvas -->
                                            <RowDefinition Height="*" />
                                            <!-- Bottom Paging & Info Toolbar -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Preview Meta Banner -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Document Layout Preview" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                                <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DocBuilderPreviewMetaText" Text="PDF â€¢ A4 Portrait â€¢ Contain" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Preview Render Canvas Container -->
                                        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                            <Grid>
                                                <!-- When preview has an image -->
                                                <Image x:Name="DocBuilderPreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <!-- Placeholder when no items or preview loading -->
                                                <Border x:Name="DocBuilderPreviewPlaceholder" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconDocumentGeometry}" Fill="{DynamicResource MutedBrush}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,10" HorizontalAlignment="Center" />
                                                        <TextBlock Text="Add images to view page preview" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Bottom Paging Toolbar -->
                                        <DockPanel Grid.Row="2" Margin="0,12,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DockPanel.Dock="Top">
                                                <!-- Previous Page Button -->
                                                <Button x:Name="DocBuilderPrevPageBtn" Style="{StaticResource SecondaryButton}" Click="DocBuilderPrevPage_Click" Padding="10,5" Margin="0,0,10,0" ToolTip="Previous page/slide">
                                                    <Path Data="M15 18l-6-6 6-6" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform" />
                                                </Button>

                                                <!-- Page Indicator Text -->
                                                <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DocBuilderPageIndicatorText" Text="Page 1 of 1" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                                                </Border>

                                                <!-- Next Page Button -->
                                                <Button x:Name="DocBuilderNextPageBtn" Style="{StaticResource SecondaryButton}" Click="DocBuilderNextPage_Click" Padding="10,5" Margin="10,0,0,0" ToolTip="Next page/slide">
                                                    <Path Data="M9 18l6-6-6-6" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>

                                <!-- Column 2: Document Configuration Panel -->
                                <Border Grid.Column="2" Padding="16">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- Document Naming -->
                                            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Document Output Name" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                                    <TextBox x:Name="DocBuilderDocNameBox" Text="SmartShift-Document" Margin="0,0,0,6" />
                                                    <TextBlock Text="Collision-safe naming guarantees no existing file is overwritten." Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- PDF SETTINGS PANEL -->
                                            <StackPanel x:Name="DocBuilderPdfSettingsPanel" Visibility="Visible">
                                                <!-- Page Sizing -->
                                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="Page Sizing" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <WrapPanel>
                                                            <Button x:Name="DocPdfSizeA4Btn" Style="{StaticResource PrimaryButton}" Content="A4" Padding="10,5" Margin="0,0,4,4" Click="DocPdfSize_Click" Tag="A4" FontSize="11" />
                                                            <Button x:Name="DocPdfSizeLetterBtn" Style="{StaticResource SecondaryButton}" Content="US Letter" Padding="10,5" Margin="0,0,4,4" Click="DocPdfSize_Click" Tag="Letter" FontSize="11" />
                                                            <Button x:Name="DocPdfSizeMatchBtn" Style="{StaticResource SecondaryButton}" Content="Match Image" Padding="10,5" Margin="0,0,4,4" Click="DocPdfSize_Click" Tag="ImageMatch" FontSize="11" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Page Orientation -->
                                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="Page Orientation" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <WrapPanel>
                                                            <Button x:Name="DocPdfOrientPortraitBtn" Style="{StaticResource PrimaryButton}" Content="Portrait" Padding="10,5" Margin="0,0,4,4" Click="DocPdfOrient_Click" Tag="Portrait" FontSize="11" />
                                                            <Button x:Name="DocPdfOrientLandscapeBtn" Style="{StaticResource SecondaryButton}" Content="Landscape" Padding="10,5" Margin="0,0,4,4" Click="DocPdfOrient_Click" Tag="Landscape" FontSize="11" />
                                                            <Button x:Name="DocPdfOrientAutoBtn" Style="{StaticResource SecondaryButton}" Content="Auto per image" Padding="10,5" Margin="0,0,4,4" Click="DocPdfOrient_Click" Tag="Auto" FontSize="11" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Image Placement -->
                                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="Image Placement" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <WrapPanel>
                                                            <Button x:Name="DocPdfPlacementContainBtn" Style="{StaticResource PrimaryButton}" Content="Fit (Contain)" Padding="10,5" Margin="0,0,4,4" Click="DocPdfPlacement_Click" Tag="Contain" FontSize="11" />
                                                            <Button x:Name="DocPdfPlacementFillBtn" Style="{StaticResource SecondaryButton}" Content="Fill (Crop)" Padding="10,5" Margin="0,0,4,4" Click="DocPdfPlacement_Click" Tag="FillCrop" FontSize="11" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Page Margins -->
                                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="Page Margins" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <WrapPanel>
                                                            <Button x:Name="DocPdfMargin0Btn" Style="{StaticResource SecondaryButton}" Content="None (0)" Padding="8,4" Margin="0,0,4,4" Click="DocPdfMargin_Click" Tag="0" FontSize="10.5" />
                                                            <Button x:Name="DocPdfMargin18Btn" Style="{StaticResource SecondaryButton}" Content="Compact (18pt)" Padding="8,4" Margin="0,0,4,4" Click="DocPdfMargin_Click" Tag="18" FontSize="10.5" />
                                                            <Button x:Name="DocPdfMargin36Btn" Style="{StaticResource PrimaryButton}" Content="Standard (36pt)" Padding="8,4" Margin="0,0,4,4" Click="DocPdfMargin_Click" Tag="36" FontSize="10.5" />
                                                            <Button x:Name="DocPdfMargin72Btn" Style="{StaticResource SecondaryButton}" Content="Generous (72pt)" Padding="8,4" Margin="0,0,4,4" Click="DocPdfMargin_Click" Tag="72" FontSize="10.5" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Background Color -->
                                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="Page Background" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <WrapPanel>
                                                            <Button x:Name="DocPdfBgWhiteBtn" Style="{StaticResource PrimaryButton}" Content="White" Padding="10,5" Margin="0,0,4,4" Click="DocPdfBg_Click" Tag="#FFFFFF" FontSize="11" />
                                                            <Button x:Name="DocPdfBgBlackBtn" Style="{StaticResource SecondaryButton}" Content="Black" Padding="10,5" Margin="0,0,4,4" Click="DocPdfBg_Click" Tag="#000000" FontSize="11" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- PPTX SETTINGS PANEL -->
                                            <StackPanel x:Name="DocBuilderPptxSettingsPanel" Visibility="Collapsed">
                                                <!-- Slide Sizing -->
                                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="Slide Sizing" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <WrapPanel>
                                                            <Button x:Name="DocPptxSize16x9Btn" Style="{StaticResource PrimaryButton}" Content="16:9 Widescreen" Padding="10,5" Margin="0,0,4,4" Click="DocPptxSize_Click" Tag="Widescreen16x9" FontSize="11" />
                                                            <Button x:Name="DocPptxSize4x3Btn" Style="{StaticResource SecondaryButton}" Content="4:3 Standard" Padding="10,5" Margin="0,0,4,4" Click="DocPptxSize_Click" Tag="Standard4x3" FontSize="11" />
                                                            <Button x:Name="DocPptxSizeMatchBtn" Style="{StaticResource SecondaryButton}" Content="Match Image" Padding="10,5" Margin="0,0,4,4" Click="DocPptxSize_Click" Tag="ImageMatch" FontSize="11" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Slide Image Placement -->
                                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="Slide Placement" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <WrapPanel>
                                                            <Button x:Name="DocPptxPlacementContainBtn" Style="{StaticResource PrimaryButton}" Content="Fit (Contain)" Padding="10,5" Margin="0,0,4,4" Click="DocPptxPlacement_Click" Tag="Contain" FontSize="11" />
                                                            <Button x:Name="DocPptxPlacementFillBtn" Style="{StaticResource SecondaryButton}" Content="Fill (Crop)" Padding="10,5" Margin="0,0,4,4" Click="DocPptxPlacement_Click" Tag="FillCrop" FontSize="11" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Slide Background Color -->
                                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="Slide Background" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <WrapPanel>
                                                            <Button x:Name="DocPptxBgWhiteBtn" Style="{StaticResource PrimaryButton}" Content="White" Padding="10,5" Margin="0,0,4,4" Click="DocPptxBg_Click" Tag="#FFFFFF" FontSize="11" />
                                                            <Button x:Name="DocPptxBgBlackBtn" Style="{StaticResource SecondaryButton}" Content="Black" Padding="10,5" Margin="0,0,4,4" Click="DocPptxBg_Click" Tag="#000000" FontSize="11" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Progress Status Card -->
                                            <Border x:Name="DocBuilderProgressBlock" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock x:Name="DocBuilderStatusText" Text="Building documentâ€¦" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                                    <ProgressBar x:Name="DocBuilderProgressBar" Height="4" Minimum="0" Maximum="100" Value="0"
                                                                 Foreground="{DynamicResource AccentGradient}" Background="{DynamicResource SurfaceAltBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Result Card (When Build Succeeds) -->
                                            <Border x:Name="DocBuilderResultCard" Background="{DynamicResource OkBgBrush}" BorderBrush="{DynamicResource OkBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="14" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="Document Created Successfully!" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" FontSize="12.5" Margin="0,0,0,4" />
                                                    <TextBlock x:Name="DocBuilderResultPathText" Text="C:\Outputs\SmartShift-Document.pdf" FontSize="11" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource PrimaryButton}" Content="Open File" Click="DocBuilderOpenResult_Click" Padding="10,5" Margin="0,0,6,0" FontSize="11" />
                                                        <Button Style="{StaticResource SecondaryButton}" Content="Show in Folder" Click="DocBuilderRevealResult_Click" Padding="10,5" FontSize="11" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================================================== -->
                <!-- FULL WORKSPACE BATCH IMAGE PROCESSING STUDIO OVERLAY -->
                <!-- ==================================================== -->
                <Grid Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="95" x:Name="BatchStudioHost" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Top Studio Toolbar -->
                                <RowDefinition Height="Auto" />
                                <!-- Main Studio Workspace (Queue List + Settings & Results) -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Toolbar -->
                            <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="14,10">
                                <DockPanel LastChildFill="True">
                                    <!-- Back / Close Button -->
                                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="CloseBatchStudio_Click"
                                            Padding="10,6" Margin="0,0,14,0" ToolTip="Return to single-file workspace">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Workspace" FontWeight="SemiBold" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Right: Open Output Folder -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="OpenOutputs_Click"
                                            Padding="12,6" Margin="8,0,0,0" ToolTip="Open the SmartShift output directory in Windows Explorer">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconFolderGeometry}" Fill="{DynamicResource MutedBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Open Outputs" FontSize="11.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Center/Left info: Title & Queue badge -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconQueueGeometry}" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="Batch Image Studio" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />
                                        <Border x:Name="BatchStudioQueueCountBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="BatchStudioQueueCountText" Text="0 images" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Main Content: Left Queue List + Right Operations & Progress -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <!-- Left Queue Panel -->
                                    <ColumnDefinition Width="420" MinWidth="340" MaxWidth="520" />
                                    <!-- Splitter -->
                                    <ColumnDefinition Width="6" />
                                    <!-- Right Settings & Progress Panel -->
                                    <ColumnDefinition Width="*" MinWidth="450" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Batch File Queue -->
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,1,0" Padding="14">
                                    <DockPanel LastChildFill="True">
                                        <!-- Queue Subheader & Action Buttons -->
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Queued Images" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>

                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource PrimaryButton}" Click="BatchAddImages_Click" Padding="10,4" Margin="0,0,6,0"
                                                        ToolTip="Add JPEG, PNG, or WebP images to the batch queue">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlusGeometry}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" />
                                                        <TextBlock Text="Add Images" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Click="BatchClearQueue_Click" Padding="8,4"
                                                        ToolTip="Clear all files from the batch queue. Disk files are not deleted.">
                                                    <TextBlock Text="Clear" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Policy Cue -->
                                        <Border DockPanel.Dock="Top" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                                            <TextBlock Text="Supported: JPEG, PNG, WebP. Duplicates excluded. Originals are never modified."
                                                       Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" LineHeight="14" />
                                        </Border>

                                        <!-- Empty Queue Cue -->
                                        <Border x:Name="BatchEmptyQueuePlaceholder" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Center" Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconUploadGeometry}" Fill="{DynamicResource MutedBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,0,10" HorizontalAlignment="Center" />
                                                <TextBlock Text="No images in batch queue" FontWeight="SemiBold" FontSize="12.5" TextAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="Click '+ Add Images' or drop image files onto the window." Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <Button Style="{StaticResource PrimaryButton}" Content="Add Images" Click="BatchAddImages_Click" HorizontalAlignment="Center" Padding="14,6" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Batch Files ListBox -->
                                        <ListBox x:Name="BatchFileList" BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="BatchFileList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- File Information Block -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <Border Background="{Binding FormatTagBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding Extension}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource MutedText}" FontSize="10.5" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Status Pill -->
                                                            <Border Grid.Column="1" Background="{Binding StatusBackgroundBrush}" CornerRadius="5" Padding="7,2" Margin="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="SemiBold" />
                                                            </Border>

                                                            <!-- Remove Button -->
                                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="4"
                                                                    Click="BatchRemoveItem_Click" Tag="{Binding}" ToolTip="Remove from batch queue">
                                                                <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="9" Height="9" Stretch="Uniform" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <!-- GridSplitter -->
                                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                                <!-- Column 2: Right Configuration & Operations Panel -->
                                <Border Grid.Column="2" Padding="18">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- Section: Optimization Preset -->
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                <TextBlock Text="OPTIMIZATION PRESET" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="BatchPresetCombo" SelectionChanged="BatchPresetCombo_SelectionChanged"
                                                          FontSize="11.5" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Save Preset" Click="BatchSavePreset_Click"
                                                        Padding="10,4" FontSize="11" ToolTip="Save current configuration as a preset" />
                                            </Grid>

                                            <!-- Section: Operation Selection -->
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                <TextBlock Text="BATCH OPERATION" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="Select Operation for All Queued Images" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />

                                            <WrapPanel Margin="0,0,0,14">
                                                <Button x:Name="BatchOpCompressBtn" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="0,0,6,6"
                                                        Click="BatchOperationSelect_Click" Tag="image.compress">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconCompressGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="Compress" FontWeight="SemiBold" FontSize="11.5" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BatchOpConvertBtn" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,6,6"
                                                        Click="BatchOperationSelect_Click" Tag="image.convert">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconConvertGeometry}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="Convert Format" FontWeight="SemiBold" FontSize="11.5" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BatchOpResizeBtn" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,6,6"
                                                        Click="BatchOperationSelect_Click" Tag="image.resize">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconResizeGeometry}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="Resize" FontWeight="SemiBold" FontSize="11.5" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BatchOpMetadataBtn" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,6,6"
                                                        Click="BatchOperationSelect_Click" Tag="image.metadata.strip">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconShieldGeometry}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="Remove Metadata" FontWeight="SemiBold" FontSize="11.5" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>

                                            <!-- Dynamic Settings Host -->
                                            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <!-- PANEL: COMPRESS -->
                                                    <StackPanel x:Name="BatchCompressSettingsPanel" Visibility="Visible">
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBlock Text="Compression Quality" FontWeight="SemiBold" FontSize="12" />
                                                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2">
                                                                <TextBlock x:Name="BatchCompressQualityBadge" Text="80%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                        </DockPanel>
                                                        <Slider x:Name="BatchCompressQualitySlider" Minimum="1" Maximum="100" Value="80"
                                                                ValueChanged="BatchCompressQualitySlider_ValueChanged" Margin="0,0,0,8" />
                                                        <WrapPanel Margin="0,0,0,6">
                                                            <Button Style="{StaticResource SecondaryButton}" Content="Lossless (95%)" Padding="7,3" Margin="0,0,4,4" Click="BatchPreset_Click" Tag="95" FontSize="10.5" />
                                                            <Button Style="{StaticResource SecondaryButton}" Content="High (80%)" Padding="7,3" Margin="0,0,4,4" Click="BatchPreset_Click" Tag="80" FontSize="10.5" />
                                                            <Button Style="{StaticResource SecondaryButton}" Content="Medium (65%)" Padding="7,3" Margin="0,0,4,4" Click="BatchPreset_Click" Tag="65" FontSize="10.5" />
                                                            <Button Style="{StaticResource SecondaryButton}" Content="Compact (45%)" Padding="7,3" Margin="0,0,4,4" Click="BatchPreset_Click" Tag="45" FontSize="10.5" />
                                                        </WrapPanel>
                                                        <TextBlock Text="Re-encodes images at chosen quality level. PNG recompression uses lossless zlib filters." Style="{StaticResource MutedText}" FontSize="10.5" LineHeight="14" />
                                                    </StackPanel>

                                                    <!-- PANEL: CONVERT -->
                                                    <StackPanel x:Name="BatchConvertSettingsPanel" Visibility="Collapsed">
                                                        <TextBlock Text="Target Format" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <WrapPanel Margin="0,0,0,10">
                                                            <Button x:Name="BatchTargetWebpBtn" Style="{StaticResource PrimaryButton}" Content="WebP" Padding="12,5" Margin="0,0,6,4" Click="BatchTargetFormat_Click" Tag="webp" FontSize="11.5" />
                                                            <Button x:Name="BatchTargetPngBtn" Style="{StaticResource SecondaryButton}" Content="PNG" Padding="12,5" Margin="0,0,6,4" Click="BatchTargetFormat_Click" Tag="png" FontSize="11.5" />
                                                            <Button x:Name="BatchTargetJpegBtn" Style="{StaticResource SecondaryButton}" Content="JPEG" Padding="12,5" Margin="0,0,6,4" Click="BatchTargetFormat_Click" Tag="jpeg" FontSize="11.5" />
                                                        </WrapPanel>
                                                        <StackPanel x:Name="BatchConvertQualityPanel">
                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBlock Text="Encoding Quality" FontWeight="SemiBold" FontSize="11.5" />
                                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock x:Name="BatchConvertQualityBadge" Text="85%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                                </Border>
                                                            </DockPanel>
                                                            <Slider x:Name="BatchConvertQualitySlider" Minimum="1" Maximum="100" Value="85"
                                                                    ValueChanged="BatchConvertQualitySlider_ValueChanged" Margin="0,0,0,6" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="BatchConvertHintText" Text="WebP offers modern compression with alpha support." Style="{StaticResource MutedText}" FontSize="10.5" />
                                                    </StackPanel>

                                                    <!-- PANEL: RESIZE -->
                                                    <StackPanel x:Name="BatchResizeSettingsPanel" Visibility="Collapsed">
                                                        <TextBlock Text="Target Dimensions" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Width (px)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                                                                <TextBox x:Name="BatchResizeWidthBox" Text="1280" FontSize="11.5" Padding="6,4" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="Ã—" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6" FontSize="12" />
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Height (px)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                                                                <TextBox x:Name="BatchResizeHeightBox" Text="720" FontSize="11.5" Padding="6,4" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <CheckBox x:Name="BatchResizeKeepAspectCheck" Content="Lock aspect ratio (scales height proportionally)" IsChecked="True" FontSize="11" Margin="0,0,0,8" />
                                                        <TextBlock Text="Scale Presets (longest edge):" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,4" />
                                                        <WrapPanel Margin="0,0,0,6">
                                                            <Button Style="{StaticResource SecondaryButton}" Content="720px" Padding="6,3" Margin="0,0,4,4" Click="BatchResizePreset_Click" Tag="720" FontSize="10.5" />
                                                            <Button Style="{StaticResource SecondaryButton}" Content="1080px" Padding="6,3" Margin="0,0,4,4" Click="BatchResizePreset_Click" Tag="1080" FontSize="10.5" />
                                                            <Button Style="{StaticResource SecondaryButton}" Content="1440px" Padding="6,3" Margin="0,0,4,4" Click="BatchResizePreset_Click" Tag="1440" FontSize="10.5" />
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <!-- PANEL: METADATA -->
                                                    <StackPanel x:Name="BatchMetadataSettingsPanel" Visibility="Collapsed">
                                                        <TextBlock Text="EXIF, GPS &amp; Camera Data Removal" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                                        <TextBlock Text="Normalizes pixel orientation and decodes/re-encodes the image without carrying forward EXIF, GPS coordinates, camera serials, or thumbnail chunks. Transparency and pixel data are preserved."
                                                                   Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                                                    </StackPanel>

                                                    <!-- Target File Size Optimization (Bounded Search) -->
                                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                                                        <StackPanel>
                                                            <CheckBox x:Name="BatchEnableTargetSizeCheck" Content="Target File Size Optimization (Bounded Search)"
                                                                      FontWeight="SemiBold" FontSize="11.5"
                                                                      Checked="BatchEnableTargetSizeCheck_Toggled" Unchecked="BatchEnableTargetSizeCheck_Toggled" Margin="0,0,0,6" />
                                                            <StackPanel x:Name="BatchTargetSizeInputPanel" Visibility="Collapsed">
                                                                <DockPanel Margin="0,0,0,6">
                                                                    <TextBlock Text="Target Size:" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <TextBox x:Name="BatchTargetSizeBox" Text="500" Width="80" FontSize="11.5" Padding="6,3" Margin="0,0,6,0" />
                                                                    <ComboBox x:Name="BatchTargetSizeUnitCombo" SelectedIndex="0" Width="65" Height="28" FontSize="11">
                                                                        <ComboBoxItem Content="KB" />
                                                                        <ComboBoxItem Content="MB" />
                                                                    </ComboBox>
                                                                </DockPanel>
                                                                <TextBlock Text="Performs bounded search (max 7 iterations) to hit target size without altering dimensions. Rejects impossible targets if quality floor is reached."
                                                                           Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" LineHeight="14" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Section: Output Naming Template -->
                                            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <TextBlock Text="OUTPUT FILE NAMING TEMPLATE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                                                    <TextBox x:Name="BatchNamingTemplateBox" Text="{}{name}_{n:D2}.{ext}" FontSize="11.5" Padding="8,5"
                                                             TextChanged="BatchNamingTemplateBox_TextChanged" Margin="0,0,0,6" />
                                                    <WrapPanel Margin="0,0,0,6">
                                                        <TextBlock Text="Insert token:" Style="{StaticResource MutedText}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <Button Style="{StaticResource SecondaryButton}" Content="{}{name}" Padding="5,2" Margin="0,0,4,2" Click="BatchNamingToken_Click" Tag="{}{name}" FontSize="10" />
                                                        <Button Style="{StaticResource SecondaryButton}" Content="{}{n:D2}" Padding="5,2" Margin="0,0,4,2" Click="BatchNamingToken_Click" Tag="{}{n:D2}" FontSize="10" />
                                                        <Button Style="{StaticResource SecondaryButton}" Content="{}{n:D3}" Padding="5,2" Margin="0,0,4,2" Click="BatchNamingToken_Click" Tag="{}{n:D3}" FontSize="10" />
                                                        <Button Style="{StaticResource SecondaryButton}" Content="{}{date}" Padding="5,2" Margin="0,0,4,2" Click="BatchNamingToken_Click" Tag="{}{date}" FontSize="10" />
                                                        <Button Style="{StaticResource SecondaryButton}" Content="{}{ext}" Padding="5,2" Margin="0,0,4,2" Click="BatchNamingToken_Click" Tag="{}{ext}" FontSize="10" />
                                                    </WrapPanel>
                                                    <TextBlock x:Name="BatchNamingPreviewText" Text="Preview: photo_01.webp" Style="{StaticResource MutedText}" FontSize="10.5" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Strip Metadata Option -->
                                            <CheckBox x:Name="BatchStripMetadataCheck" Content="Strip EXIF, GPS and camera metadata (preserves visual orientation in pixels)"
                                                      FontSize="11" Margin="0,0,0,16" />

                                            <!-- Concurrency & Output Settings -->
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Concurrency Selector -->
                                                <Border Grid.Column="0" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="Execution Concurrency" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton x:Name="BatchSequentialRadio" Content="Sequential" IsChecked="True" FontSize="11" Margin="0,0,12,0"
                                                                         ToolTip="Processes one image at a time (lowest memory usage)" />
                                                            <RadioButton x:Name="BatchParallelRadio" Content="Parallel (2 Workers)" FontSize="11"
                                                                         ToolTip="Processes two images simultaneously with bounded concurrency" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Output Info -->
                                                <Border Grid.Column="2" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="Output Location" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4" />
                                                        <TextBlock Text="SmartShift\Outputs" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" />
                                                        <TextBlock Text="Atomic .partial writes, collision-free naming" Style="{StaticResource MutedText}" FontSize="10" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Validation Error Text -->
                                            <TextBlock x:Name="BatchValidationErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" />

                                            <!-- Action Buttons: Start, Retry Failed & Cancel -->
                                            <WrapPanel Margin="0,0,0,16">
                                                <Button x:Name="BatchStartButton" Style="{StaticResource PrimaryButton}" Click="StartBatchProcess_Click"
                                                        Padding="20,9" Margin="0,0,10,6" ToolTip="Start processing all images in the batch queue">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlayGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                                                        <TextBlock Text="Start Batch Process" FontWeight="Bold" FontSize="12.5" />
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="BatchRetryFailedButton" Style="{StaticResource SecondaryButton}" Click="BatchRetryFailed_Click"
                                                        Padding="16,9" Margin="0,0,10,6" Visibility="Collapsed" ToolTip="Retry only the files that failed in the previous batch run">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconRefreshGeometry}" Fill="{DynamicResource WarnBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="Retry Failed Files" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource WarnBrush}" />
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="BatchCancelButton" Style="{StaticResource SecondaryButton}" Click="CancelBatchProcess_Click"
                                                        Padding="16,9" Margin="0,0,0,6" IsEnabled="False" ToolTip="Cancel the active batch process safely">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource DangerBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="Cancel Batch" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>

                                            <!-- Live Progress Card -->
                                            <Border x:Name="BatchProgressCard" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock x:Name="BatchProgressTitle" Text="Processing batchâ€¦" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock x:Name="BatchProgressPercentText" DockPanel.Dock="Right" Text="0%" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
                                                    </DockPanel>

                                                    <ProgressBar x:Name="BatchProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                                                 Foreground="{DynamicResource AccentGradient}" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,0,8" />

                                                    <TextBlock x:Name="BatchProgressStatusText" Text="Initializingâ€¦" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />

                                                    <!-- Counters -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{DynamicResource OkSoftBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                                            <TextBlock x:Name="BatchProgressSucceededText" Text="âœ“ 0 Succeeded" Foreground="{DynamicResource OkBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                                            <TextBlock x:Name="BatchProgressFailedText" Text="âœ• 0 Failed" Foreground="{DynamicResource DangerBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="4" Padding="8,2">
                                                            <TextBlock x:Name="BatchProgressCancelledText" Text="âŠ˜ 0 Cancelled" Foreground="{DynamicResource WarnBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Final Summary Card -->
                                            <Border x:Name="BatchSummaryCard" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource IconCheckGeometry}" Fill="{DynamicResource OkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock x:Name="BatchSummaryTitleText" Text="Batch Processing Complete" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="BatchSummaryDetailText" Text="All files completed." Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,10" />
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Open Output Folder" Click="OpenOutputs_Click" HorizontalAlignment="Left" Padding="14,6" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Selected Item Result Inspector -->
                                            <Border x:Name="BatchSelectedInspectorCard" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="16" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="ITEM DETAILS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
                                                    <TextBlock x:Name="BatchInspectorFileName" Text="photo.jpg" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="BatchInspectorStatusMessage" Text="Completed successfully" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,10" TextWrapping="Wrap" />

                                                    <!-- Metadata Inspection Block -->
                                                    <Border x:Name="BatchInspectorMetadataCard" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                                        <StackPanel>
                                                            <TextBlock Text="METADATA &amp; ORIENTATION" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
                                                            <TextBlock x:Name="BatchInspectorMetaDims" Text="Dimensions: 1920 × 1080 px (16:9)" FontSize="10.5" Margin="0,0,0,2" />
                                                            <TextBlock x:Name="BatchInspectorMetaFormat" Text="Format: JPEG | Color: Bgra8888" FontSize="10.5" Margin="0,0,0,2" />
                                                            <TextBlock x:Name="BatchInspectorMetaExif" Text="EXIF / Orientation: TopLeft (0°)" FontSize="10.5" Margin="0,0,0,2" />
                                                            <TextBlock x:Name="BatchInspectorMetaTags" Text="Markers: EXIF, GPS Location" FontSize="10.5" Style="{StaticResource MutedText}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <StackPanel x:Name="BatchInspectorOutputBlock" Margin="0,0,0,8" Visibility="Collapsed">
                                                        <TextBlock Text="Output File:" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2" />
                                                        <TextBlock x:Name="BatchInspectorOutputPath" Text="C:\Outputs\photo-compressed.jpg" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button x:Name="BatchInspectorOpenFileBtn" Style="{StaticResource SecondaryButton}" Content="Open Image" Click="BatchInspectorOpenFile_Click" Padding="10,5" Margin="0,0,6,0" FontSize="11" />
                                                            <Button x:Name="BatchInspectorRevealBtn" Style="{StaticResource SecondaryButton}" Content="Show in Folder" Click="BatchInspectorReveal_Click" Padding="10,5" FontSize="11" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================================================== -->
                <!-- FULL WORKSPACE TEXT-TO-PRESENTATION STUDIO OVERLAY   -->
                                <!-- PDF MERGE STUDIO HOST                                        -->
                <!-- ============================================================ -->
                <Grid Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="94" x:Name="PdfMergeStudioHost" Visibility="Collapsed"
                      Background="{DynamicResource SurfaceBrush}">
                    <Grid.RowDefinitions>
                        <!-- Top Header Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Main Studio Area -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="16,10">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="ClosePdfMergeStudio_Click"
                                    Padding="10,6" Margin="0,0,16,0" ToolTip="Close PDF Merge Studio and return to workspace">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="Close Studio" FontSize="11.5" />
                                </StackPanel>
                            </Button>

                            <!-- Merge Action Button on Right -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="PdfMergeSummaryBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,12,0">
                                    <TextBlock x:Name="PdfMergeSummaryText" Text="0 files · 0 pages" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Button x:Name="PdfMergeExecuteBtn" Style="{StaticResource PrimaryButton}" Click="PdfMergeExecute_Click"
                                        Padding="16,8" ToolTip="Combine all queued PDF documents in exact order">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconExportGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="Merge PDFs" FontWeight="Bold" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Studio Identity -->
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="PDF MERGE STUDIO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock Text="Multi-Document PDF Combiner" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>
                                <TextBlock Text="Reorder pages, validate document integrity, and merge safely into a single valid PDF" Style="{StaticResource MutedText}" FontSize="11" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Main Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Queue List -->
                            <ColumnDefinition Width="380" MinWidth="300" MaxWidth="500" />
                            <!-- Splitter -->
                            <ColumnDefinition Width="6" />
                            <!-- Column 2: Document Inspection Preview & Settings -->
                            <ColumnDefinition Width="*" MinWidth="400" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Queue List -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,1,0" Padding="14">
                            <DockPanel LastChildFill="True">
                                <!-- Queue Toolbar -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="PdfMergeRemoveDupBtn" Style="{StaticResource GhostButton}" Padding="6,4" Margin="0,0,4,0"
                                                Click="PdfMergeRemoveDuplicates_Click" ToolTip="Remove duplicate file entries">
                                            <TextBlock Text="Deduplicate" FontSize="10.5" />
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="6,4" Click="PdfMergeClearQueue_Click" ToolTip="Clear all documents from merge queue">
                                            <TextBlock Text="Clear All" FontSize="10.5" Foreground="{DynamicResource DangerBrush}" />
                                        </Button>
                                    </StackPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Padding="10,5" Click="PdfMergeAddFiles_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconUploadGeometry}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Add PDFs" FontSize="11.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>

                                <!-- Drag & Drop Cue -->
                                <Border DockPanel.Dock="Top" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10"
                                        AllowDrop="True" Drop="PdfMergeDropZone_Drop" DragOver="PdfMergeDropZone_DragOver">
                                    <TextBlock Text="Drag and drop PDF files here, or use the Add PDFs button above. Final page order follows this list exactly."
                                               Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" LineHeight="14" />
                                </Border>

                                <!-- Empty Placeholder -->
                                <Border x:Name="PdfMergeEmptyPlaceholder" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconDocumentGeometry}" Fill="{DynamicResource MutedBrush}" Width="28" Height="28" Stretch="Uniform" Margin="0,0,0,10" HorizontalAlignment="Center" />
                                        <TextBlock Text="No PDF documents in queue" FontWeight="SemiBold" FontSize="13" TextAlignment="Center" Margin="0,0,0,4" />
                                        <TextBlock Text="Add at least 2 PDF documents to begin merging." Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="Select PDF Files" Click="PdfMergeAddFiles_Click" HorizontalAlignment="Center" Padding="14,6" />
                                    </StackPanel>
                                </Border>

                                <!-- Document List -->
                                <ListBox x:Name="PdfMergeQueueList" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="PdfMergeQueueList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Position Badge -->
                                                    <Border Grid.Column="0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PositionText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>

                                                    <!-- Details -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <Border Background="{Binding StatusBackgroundBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding PageCountText}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <!-- Error hint if invalid -->
                                                        <TextBlock Text="{Binding ErrorReason}" Foreground="{DynamicResource DangerBrush}" FontSize="9.5" TextWrapping="Wrap"
                                                                   Visibility="{Binding ErrorVisibility}" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <!-- Actions: Up, Down, Remove -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource GhostButton}" Padding="4" Margin="0,0,2,0"
                                                                Click="PdfMergeMoveUp_Click" Tag="{Binding}" IsEnabled="{Binding CanMoveUp}" ToolTip="Move up / earlier in sequence">
                                                            <Path Data="M7 14l5-5 5 5z" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Uniform" />
                                                        </Button>
                                                        <Button Style="{StaticResource GhostButton}" Padding="4" Margin="0,0,4,0"
                                                                Click="PdfMergeMoveDown_Click" Tag="{Binding}" IsEnabled="{Binding CanMoveDown}" ToolTip="Move down / later in sequence">
                                                            <Path Data="M7 10l5 5 5-5z" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Uniform" />
                                                        </Button>
                                                        <Button Style="{StaticResource GhostButton}" Padding="4"
                                                                Click="PdfMergeRemoveItem_Click" Tag="{Binding}" ToolTip="Remove from merge queue">
                                                            <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="9" Height="9" Stretch="Uniform" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Splitter -->
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                        <!-- Column 2: Document Inspection Preview & Settings -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Preview Area -->
                                    <RowDefinition Height="*" />
                                    <!-- Settings & Output Area -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Preview Area -->
                                <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Preview Toolbar -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Preview Viewport -->
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Preview Toolbar -->
                                        <Border Grid.Row="0" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1" Padding="10,6">
                                            <DockPanel LastChildFill="False">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="INSPECTION PREVIEW:" Style="{StaticResource MutedText}" FontSize="9.5" FontWeight="Bold" Margin="0,0,8,0" />
                                                    <TextBlock x:Name="PdfMergePreviewTitle" Text="Select a document to inspect" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                </StackPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostButton}" Padding="6,2" Click="PdfMergePrevPage_Click" Margin="0,0,4,0" ToolTip="Previous page">
                                                        <TextBlock Text="◀ Prev" FontSize="10.5" />
                                                    </Button>
                                                    <TextBlock x:Name="PdfMergePageCounter" Text="Page 1 of 1" FontSize="11" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="4,0,8,0" />
                                                    <Button Style="{StaticResource GhostButton}" Padding="6,2" Click="PdfMergeNextPage_Click" ToolTip="Next page">
                                                        <TextBlock Text="Next ▶" FontSize="10.5" />
                                                    </Button>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Preview Viewport -->
                                        <ScrollViewer Grid.Row="1" x:Name="PdfMergePreviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#080C14">
                                            <Grid MinHeight="260">
                                                <Border x:Name="PdfMergePageContainer" Background="White" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image x:Name="PdfMergePreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <TextBlock x:Name="PdfMergePreviewEmptyText" Text="Select a valid PDF from the list to preview individual pages."
                                                           Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Settings & Action Area -->
                                <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Output File Name:" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Grid.Column="1" x:Name="PdfMergeOutputNameBox" Text="Merged_Document.pdf" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="16,7" Click="PdfMergeExecute_Click">
                                                <TextBlock Text="Merge Documents" FontWeight="Bold" FontSize="12" />
                                            </Button>
                                        </Grid>

                                        <!-- Progress Bar -->
                                        <StackPanel x:Name="PdfMergeProgressHost" Visibility="Collapsed" Margin="0,0,0,10">
                                            <ProgressBar x:Name="PdfMergeProgressBar" Height="4" Margin="0,0,0,6" IsIndeterminate="False" Minimum="0" Maximum="100" />
                                            <DockPanel>
                                                <Button x:Name="PdfMergeCancelBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cancel" Padding="6,2" Click="PdfMergeCancel_Click" />
                                                <TextBlock x:Name="PdfMergeProgressText" Text="Merging documents…" Style="{StaticResource MutedText}" FontSize="11" />
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Result Card -->
                                        <Border x:Name="PdfMergeResultCard" Background="{DynamicResource OkBgBrush}" BorderBrush="{DynamicResource OkBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12" Visibility="Collapsed">
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource PrimaryButton}" Padding="10,5" Margin="0,0,6,0" Click="PdfMergeOpenResult_Click">
                                                        <TextBlock Text="Open PDF" FontSize="11" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Style="{StaticResource SecondaryButton}" Padding="10,5" Click="PdfMergeRevealResult_Click">
                                                        <TextBlock Text="Reveal in Explorer" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="PdfMergeResultTitle" Text="PDF Merge Completed Successfully" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OkBrush}" />
                                                    <TextBlock x:Name="PdfMergeResultDetail" Text="Combined 3 files into 24 pages." Style="{StaticResource MutedText}" FontSize="11" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============================================================ -->
                <!-- PDF SPLIT STUDIO HOST                                        -->
                <!-- ============================================================ -->
                <Grid Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="95" x:Name="PdfSplitStudioHost" Visibility="Collapsed"
                      Background="{DynamicResource SurfaceBrush}">
                    <Grid.RowDefinitions>
                        <!-- Top Header Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Main Studio Area -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="16,10">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="ClosePdfSplitStudio_Click"
                                    Padding="10,6" Margin="0,0,16,0" ToolTip="Close PDF Split Studio and return to workspace">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="Close Studio" FontSize="11.5" />
                                </StackPanel>
                            </Button>

                            <!-- Document Info / Summary Badges on Right -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="PdfSplitHeaderFileSize" Text="—" FontSize="11" Style="{StaticResource MutedText}" />
                                </Border>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10,4">
                                    <TextBlock x:Name="PdfSplitHeaderPageCount" Text="—" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Studio Identity -->
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="PDF SPLIT STUDIO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock x:Name="PdfSplitHeaderFileName" Text="No Document Selected" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="PdfSplitHeaderStatus" Text="Extract selected page ranges or split every page into individual documents" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Main Studio Area (2 Columns) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Preview and Selection (Left) -->
                            <ColumnDefinition Width="*" MinWidth="380" />
                            <!-- Splitter -->
                            <ColumnDefinition Width="6" />
                            <!-- Column 2: Configuration & Planned Outputs (Right) -->
                            <ColumnDefinition Width="420" MinWidth="340" MaxWidth="560" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Page Preview and Page Navigation -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,1,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Preview Controls Toolbar -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Page Preview Container -->
                                    <RowDefinition Height="*" />
                                    <!-- Page Selection Checkbox & Quick Actions -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Preview Toolbar: Prev, Counter, Next, Selection Badge -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <TextBlock x:Name="PdfSplitSelectionCountText" Text="0 pages selected" FontSize="11" Style="{StaticResource MutedText}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" Click="PdfSplitPrevPage_Click" Padding="8,5" Margin="0,0,6,0" ToolTip="Previous page">
                                            <TextBlock Text="◀ Prev" FontSize="11" />
                                        </Button>
                                        <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,6,0">
                                            <TextBlock x:Name="PdfSplitPageCounter" Text="Page 0 of 0" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                                        </Border>
                                        <Button Style="{StaticResource SecondaryButton}" Click="PdfSplitNextPage_Click" Padding="8,5" ToolTip="Next page">
                                            <TextBlock Text="Next ▶" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Page Preview Container (Image display) -->
                                <Border Grid.Row="1" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <Grid>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <Image x:Name="PdfSplitPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </ScrollViewer>
                                        <TextBlock x:Name="PdfSplitPreviewEmptyText" Text="No page preview available"
                                                   Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="12" Visibility="Visible" TextAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <!-- Bottom Selection Bar -->
                                <Border Grid.Row="2" Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}" Content="Select All" Click="PdfSplitSelectAll_Click" Margin="0,0,6,0" Padding="8,4" FontSize="11" />
                                            <Button Style="{StaticResource GhostButton}" Content="Clear Selection" Click="PdfSplitClearSelection_Click" Padding="8,4" FontSize="11" Foreground="{DynamicResource DangerBrush}" />
                                        </StackPanel>
                                        <CheckBox x:Name="PdfSplitPageSelectCheck" Content="Include page in selection"
                                                  Click="PdfSplitPageSelectCheck_Click" VerticalAlignment="Center" FontSize="11.5" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Splitter -->
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                        <!-- Column 2: Configuration & Execution Panel -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- Splitting Mode Selector Card -->
                                    <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="SPLITTING MODE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />
                                            <RadioButton x:Name="PdfSplitModeExtractRadio" GroupName="PdfSplitModeGroup" IsChecked="True"
                                                         Checked="PdfSplitMode_Checked" Margin="0,0,0,8">
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="Extract Selected Page Ranges" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Text="Extract specific pages or continuous ranges (e.g. 1-3, 5, 8-10) into separate PDFs" Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </RadioButton>

                                            <RadioButton x:Name="PdfSplitModeEveryRadio" GroupName="PdfSplitModeGroup"
                                                         Checked="PdfSplitMode_Checked">
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="Split Every Page" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Text="Export each page as an individual 1-page PDF document" Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>

                                    <!-- Mode A: Range Input Panel -->
                                    <StackPanel x:Name="PdfSplitModeExtractPanel" Margin="0,0,0,14">
                                        <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="PAGE RANGES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                                                <TextBlock Text="Specify pages or ranges separated by commas (e.g. 1-3, 5, 8-10, or 'all'):" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                <TextBox x:Name="PdfSplitRangeBox" FontSize="12"
                                                         TextChanged="PdfSplitRangeBox_TextChanged" Margin="0,0,0,6" />
                                                <TextBlock x:Name="PdfSplitRangeValidationText" Foreground="{DynamicResource DangerBrush}" FontSize="11"
                                                           Visibility="Collapsed" Margin="0,0,0,4" TextWrapping="Wrap" />
                                                <TextBlock Text="Note: Overlapping ranges and duplicate pages will be rejected. Page ordering and vector graphics are strictly preserved." Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Mode B: Split Every Page Info Panel -->
                                    <StackPanel x:Name="PdfSplitModeEveryPanel" Visibility="Collapsed" Margin="0,0,0,14">
                                        <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="EVERY-PAGE SPLIT PLAN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                                                <TextBlock x:Name="PdfSplitEveryTotalNote" Text="Will generate individual 1-page PDF file(s)." FontSize="11.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                                                <TextBlock Text="Each page will be extracted into a numbered PDF file with zero-padded formatting (e.g., _page_001.pdf)." Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Output Destination Card -->
                                    <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="OUTPUT DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Browse..."
                                                        Click="PdfSplitBrowseDir_Click" Padding="10,6" Margin="8,0,0,0" />
                                                <TextBox x:Name="PdfSplitOutputDirBox" FontSize="11" IsReadOnly="True" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Planned Output Plan Preview -->
                                    <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="PLANNED OUTPUT FILES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                                            <ItemsControl x:Name="PdfSplitPlannedOutputsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                                            <DockPanel LastChildFill="True">
                                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="6,2">
                                                                    <TextBlock Text="{Binding PagesDescription}" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                                                </Border>
                                                                <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Progress Block -->
                                    <Border x:Name="PdfSplitProgressHost" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                                        <StackPanel>
                                            <ProgressBar x:Name="PdfSplitProgressBar" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,8" />
                                            <TextBlock x:Name="PdfSplitProgressText" Text="Splitting PDF..." Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,8" />
                                            <Button x:Name="PdfSplitCancelBtn" Style="{StaticResource SecondaryButton}" Click="PdfSplitCancel_Click" Content="Cancel Split" HorizontalAlignment="Left" Padding="10,4" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Result Feedback Card -->
                                    <Border x:Name="PdfSplitResultCard" Background="{DynamicResource OkBgBrush}" BorderBrush="{DynamicResource OkBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="PdfSplitResultTitle" Text="PDF Split Completed Successfully" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource OkBrush}" Margin="0,0,0,4" />
                                            <TextBlock x:Name="PdfSplitResultDetail" Text="Generated 3 output files." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="PdfSplitOpenFolderBtn" Style="{StaticResource PrimaryButton}" Content="Open Output Folder" Click="PdfSplitOpenFolder_Click" Padding="10,5" Margin="0,0,8,0" />
                                                <Button x:Name="PdfSplitOpenFirstBtn" Style="{StaticResource SecondaryButton}" Content="Open Result PDF" Click="PdfSplitOpenFirst_Click" Padding="10,5" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Primary Action Footer -->
                                    <Button x:Name="PdfSplitExecuteBtn" Style="{StaticResource PrimaryButton}" Click="PdfSplitExecute_Click"
                                            Padding="16,10" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconSplitGeometry}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                                            <TextBlock x:Name="PdfSplitExecuteBtnText" Text="Extract Selected Ranges" FontWeight="Bold" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============================================================ -->
                <!-- PDF PAGE ORGANIZER STUDIO HOST                               -->
                <!-- ============================================================ -->
                <Grid Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="95" x:Name="PdfOrganizeStudioHost" Visibility="Collapsed"
                      Background="{DynamicResource SurfaceBrush}">
                    <Grid.RowDefinitions>
                        <!-- Top Header Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Action Toolbar -->
                        <RowDefinition Height="Auto" />
                        <!-- Main Studio Area -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="16,10">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="ClosePdfOrganizeStudio_Click"
                                    Padding="10,6" Margin="0,0,16,0" ToolTip="Close PDF Page Organizer and return to workspace">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="Close Studio" FontSize="11.5" />
                                </StackPanel>
                            </Button>

                            <!-- Document Badges on Right -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="PdfOrganizeHeaderFileSize" Text="—" FontSize="11" Style="{StaticResource MutedText}" />
                                </Border>
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="PdfOrganizeHeaderPageCount" Text="0 pages" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="PdfOrganizeHeaderSelectionCount" Text="0 selected" FontSize="11" Style="{StaticResource MutedText}" />
                                </Border>
                                <Border x:Name="PdfOrganizeHeaderModifiedBadge" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="PdfOrganizeHeaderModifiedText" Text="Original state" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                </Border>
                                <Button x:Name="PdfOrganizeHeaderResetBtn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeReset_Click"
                                        Padding="8,5" ToolTip="Reset document to original order and orientations">
                                    <TextBlock Text="Reset" FontSize="11" />
                                </Button>
                            </StackPanel>

                            <!-- Studio Identity -->
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="PDF PAGE ORGANIZER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock x:Name="PdfOrganizeHeaderFileName" Text="No Document Selected" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="PdfOrganizeHeaderStatus" Text="Reorder, rotate, delete, and organize PDF pages visually before safe export" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Action Toolbar -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="14,8">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Selection Controls -->
                            <Button x:Name="PdfOrganizeSelectAllBtn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeSelectAll_Click" Padding="8,4" Margin="0,0,6,0" ToolTip="Select all pages">
                                <TextBlock Text="Select All" FontSize="11" />
                            </Button>
                            <Button x:Name="PdfOrganizeClearSelBtn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeClearSelection_Click" Padding="8,4" Margin="0,0,12,0" ToolTip="Clear selection">
                                <TextBlock Text="Clear Selection" FontSize="11" />
                            </Button>

                            <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <!-- Reorder Move Controls -->
                            <Button x:Name="PdfOrganizeMoveLeftBtn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeMoveLeft_Click" Padding="8,4" Margin="0,0,6,0" ToolTip="Move selected page(s) left / earlier">
                                <TextBlock Text="◀ Move Left" FontSize="11" />
                            </Button>
                            <Button x:Name="PdfOrganizeMoveRightBtn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeMoveRight_Click" Padding="8,4" Margin="0,0,12,0" ToolTip="Move selected page(s) right / later">
                                <TextBlock Text="Move Right ▶" FontSize="11" />
                            </Button>

                            <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <!-- Rotation Controls -->
                            <Button x:Name="PdfOrganizeRotateCcwBtn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeRotateCcw_Click" Padding="8,4" Margin="0,0,6,0" ToolTip="Rotate selected page(s) 90° counterclockwise">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRotateCcwGeometry}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" />
                                    <TextBlock Text="Rotate 90° CCW" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PdfOrganizeRotateCwBtn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeRotateCw_Click" Padding="8,4" Margin="0,0,6,0" ToolTip="Rotate selected page(s) 90° clockwise">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRotateCwGeometry}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" />
                                    <TextBlock Text="Rotate 90° CW" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PdfOrganizeRotate180Btn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeRotate180_Click" Padding="8,4" Margin="0,0,12,0" ToolTip="Rotate selected page(s) 180°">
                                <TextBlock Text="Rotate 180°" FontSize="11" />
                            </Button>

                            <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <!-- Delete Selected -->
                            <Button x:Name="PdfOrganizeDeleteBtn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeDeleteSelected_Click" Padding="8,4" Margin="0,0,12,0" ToolTip="Delete selected page(s)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrashGeometry}" Fill="#EF4444" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                    <TextBlock Text="Delete Selected" FontSize="11" Foreground="#EF4444" />
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <!-- Undo / Redo -->
                            <Button x:Name="PdfOrganizeUndoBtn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeUndo_Click" Padding="8,4" Margin="0,0,6,0" ToolTip="Undo last change">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconUndoGeometry}" Fill="{DynamicResource TextBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                    <TextBlock Text="Undo" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PdfOrganizeRedoBtn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeRedo_Click" Padding="8,4" Margin="0,0,12,0" ToolTip="Redo change">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRedoGeometry}" Fill="{DynamicResource TextBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                    <TextBlock Text="Redo" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <!-- Reset to Original -->
                            <Button x:Name="PdfOrganizeResetBtn" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeReset_Click" Padding="8,4" ToolTip="Discard all changes and restore original pages">
                                <TextBlock Text="Reset Changes" FontSize="11" />
                            </Button>
                        </WrapPanel>
                    </Border>

                    <!-- Main Studio Area (2 Columns) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Thumbnail Grid (Left) -->
                            <ColumnDefinition Width="*" MinWidth="440" />
                            <!-- Splitter -->
                            <ColumnDefinition Width="6" />
                            <!-- Column 2: Large Preview & Export (Right) -->
                            <ColumnDefinition Width="420" MinWidth="340" MaxWidth="580" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Page Thumbnail Grid -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Grid header info -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Pages in Output Document (Drag to reorder)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="Click thumbnail to preview · Checkbox to select multiple" FontSize="11" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                </DockPanel>

                                <!-- Scrollable Thumbnail Cards -->
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PdfOrganizePagesList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="150" Height="220" Margin="6" CornerRadius="8"
                                                        Background="{DynamicResource GlassCardBrush}"
                                                        BorderThickness="2" Cursor="Hand"
                                                        PreviewMouseLeftButtonDown="PdfOrganizeCard_PreviewMouseLeftButtonDown"
                                                        MouseMove="PdfOrganizeCard_MouseMove"
                                                        DragOver="PdfOrganizeCard_DragOver"
                                                        Drop="PdfOrganizeCard_Drop"
                                                        MouseLeftButtonUp="PdfOrganizeCard_Click"
                                                        ToolTip="Click to preview. Drag to reorder.">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid Margin="6">
                                                        <Grid.RowDefinitions>
                                                            <!-- Card Header (Checkbox + Badges) -->
                                                            <RowDefinition Height="Auto" />
                                                            <!-- Thumbnail Preview Area -->
                                                            <RowDefinition Height="*" />
                                                            <!-- Card Bottom Quick Actions -->
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Card Header -->
                                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Click="PdfOrganizeItemCheckbox_Click"
                                                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <Border DockPanel.Dock="Right" Background="{DynamicResource GlassPanelBrush}" CornerRadius="4" Padding="5,1">
                                                                <TextBlock Text="{Binding OriginalDisplay}" FontSize="9.5" Style="{StaticResource MutedText}" />
                                                            </Border>
                                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="5,1" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding PositionDisplay}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                        </DockPanel>

                                                        <!-- Thumbnail Image Area -->
                                                        <Border Grid.Row="1" Background="#0A0F1D" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,2,0,4" ClipToBounds="True">
                                                            <Grid>
                                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Image.LayoutTransform>
                                                                        <RotateTransform Angle="{Binding RotationDegrees}" />
                                                                    </Image.LayoutTransform>
                                                                </Image>

                                                                <!-- Rotation Badge Overlay if rotated -->
                                                                <Border Background="#D90F172A" CornerRadius="4" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRotated}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding RotationDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Card Bottom Quick Actions -->
                                                        <UniformGrid Grid.Row="2" Columns="4" Margin="0,2,0,0">
                                                            <Button Style="{StaticResource SecondaryButton}" Click="PdfOrganizeItemMoveLeft_Click" Padding="2,2" Margin="1,0" ToolTip="Move left">
                                                                <TextBlock Text="◀" FontSize="9" />
                                                            </Button>
                                                            <Button Style="{StaticResource SecondaryButton}" Click="PdfOrganizeItemMoveRight_Click" Padding="2,2" Margin="1,0" ToolTip="Move right">
                                                                <TextBlock Text="▶" FontSize="9" />
                                                            </Button>
                                                            <Button Style="{StaticResource SecondaryButton}" Click="PdfOrganizeItemRotateCw_Click" Padding="2,2" Margin="1,0" ToolTip="Rotate 90° CW">
                                                                <Path Data="{StaticResource IconRotateCwGeometry}" Fill="{DynamicResource TextBrush}" Width="9" Height="9" Stretch="Uniform" />
                                                            </Button>
                                                            <Button Style="{StaticResource SecondaryButton}" Click="PdfOrganizeItemDelete_Click" Padding="2,2" Margin="1,0" ToolTip="Delete page">
                                                                <Path Data="{StaticResource IconTrashGeometry}" Fill="#EF4444" Width="9" Height="9" Stretch="Uniform" />
                                                            </Button>
                                                        </UniformGrid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Splitter -->
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

                        <!-- Column 2: Large Preview & Export Settings -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1,0,0,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Preview Header Toolbar -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Preview Display -->
                                    <RowDefinition Height="*" />
                                    <!-- Page Meta Info -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Export Section -->
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Preview Header Toolbar -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" Click="PdfOrganizeZoomOut_Click" Padding="6,3" Margin="0,0,4,0" ToolTip="Zoom Out">
                                            <TextBlock Text="−" FontSize="11" FontWeight="Bold" />
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="PdfOrganizeZoomFit_Click" Padding="6,3" Margin="0,0,4,0" ToolTip="Fit to Preview Window">
                                            <TextBlock Text="Fit" FontSize="10" />
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="PdfOrganizeZoomIn_Click" Padding="6,3" ToolTip="Zoom In">
                                            <TextBlock Text="+" FontSize="11" FontWeight="Bold" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Navigation Buttons -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" Click="PdfOrganizePrevPage_Click" Padding="8,4" Margin="0,0,6,0" ToolTip="Previous page">
                                            <TextBlock Text="◀ Prev" FontSize="11" />
                                        </Button>
                                        <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                                            <TextBlock x:Name="PdfOrganizePreviewPageIndicator" Text="Page 0 of 0" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" />
                                        </Border>
                                        <Button Style="{StaticResource SecondaryButton}" Click="PdfOrganizeNextPage_Click" Padding="8,4" ToolTip="Next page">
                                            <TextBlock Text="Next ▶" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Large Preview Display Container -->
                                <Border Grid.Row="1" Background="#0A0F1D" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8" ClipToBounds="True">
                                    <ScrollViewer x:Name="PdfOrganizeLargePreviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="PdfOrganizePreviewCanvas">
                                            <Image x:Name="PdfOrganizeLargePreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.LayoutTransform>
                                                    <RotateTransform x:Name="PdfOrganizeLargePreviewRotateTransform" Angle="0" />
                                                </Image.LayoutTransform>
                                            </Image>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>

                                <!-- Page Meta Info -->
                                <Border Grid.Row="2" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                                    <TextBlock x:Name="PdfOrganizePreviewDimensionsText" Text="Dimensions: —" FontSize="11" Style="{StaticResource MutedText}" TextAlignment="Center" />
                                </Border>

                                <!-- Export Section -->
                                <Border Grid.Row="3" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Export Organized PDF" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />

                                        <!-- Output Folder -->
                                        <TextBlock Text="Destination Folder" FontSize="11" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PdfOrganizeOutputDirBox" FontSize="11" Padding="8,6" />
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="PdfOrganizeBrowseOutputDir_Click" Padding="10,6" Margin="6,0,0,0" ToolTip="Select destination folder">
                                                <TextBlock Text="Browse…" FontSize="11" />
                                            </Button>
                                        </Grid>

                                        <!-- Custom File Name -->
                                        <TextBlock Text="Output Filename" FontSize="11" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                        <TextBox x:Name="PdfOrganizeOutputFileNameBox" FontSize="11" Padding="8,6" Margin="0,0,0,12" />

                                        <!-- Progress Bar -->
                                        <ProgressBar x:Name="PdfOrganizeProgressBar" Height="6" Margin="0,0,0,6" Visibility="Collapsed" IsIndeterminate="False" Maximum="100" />
                                        <TextBlock x:Name="PdfOrganizeProgressText" Text="" FontSize="11" Style="{StaticResource MutedText}" Margin="0,0,0,8" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />

                                        <!-- Success Banner -->
                                        <Border x:Name="PdfOrganizeSuccessBanner" Background="{DynamicResource OkSoftBrush}" BorderBrush="{DynamicResource OkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="PdfOrganizeSuccessMessage" Text="PDF exported successfully!" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource OkBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource SecondaryButton}" Click="PdfOrganizeRevealOutput_Click" Padding="8,4" Margin="0,0,6,0">
                                                        <TextBlock Text="Reveal in Explorer" FontSize="10.5" />
                                                    </Button>
                                                    <Button Style="{StaticResource SecondaryButton}" Click="PdfOrganizeOpenOutput_Click" Padding="8,4">
                                                        <TextBlock Text="Open PDF" FontSize="10.5" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Export Button -->
                                        <Button x:Name="PdfOrganizeExportBtn" Style="{StaticResource PrimaryButton}" Click="PdfOrganizeExport_Click" Padding="16,10" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconExportGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                                                <TextBlock x:Name="PdfOrganizeExportBtnText" Text="Export Organized PDF" FontWeight="Bold" FontSize="12.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================================================== -->
                <Grid Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="96" x:Name="PresentationStudioHost" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Top Studio Toolbar -->
                                <RowDefinition Height="Auto" />
                                <!-- Notification / Overflow Banner -->
                                <RowDefinition Height="Auto" />
                                <!-- Main Studio Workspace -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Toolbar -->
                            <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="14,10">
                                <DockPanel LastChildFill="True">
                                    <!-- Back / Close Button -->
                                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="ClosePresentationStudio_Click"
                                            Padding="10,6" Margin="0,0,14,0" ToolTip="Return to main workspace">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Close Studio" FontWeight="SemiBold" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Switch Mode Tabs -->
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,14,0">
                                        <Button x:Name="PresTabOutlineBtn" Style="{StaticResource SecondaryButton}" Content="1. Outline Review"
                                                Click="PresTabOutline_Click" Padding="12,5" Margin="0,0,4,0" FontSize="11.5" FontWeight="SemiBold" />
                                        <Button x:Name="PresTabEditorBtn" Style="{StaticResource PrimaryButton}" Content="2. Slide Editor"
                                                Click="PresTabEditor_Click" Padding="12,5" FontSize="11.5" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <!-- Right Action Buttons -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Click="PresImportDocument_Click"
                                                Padding="10,5" Margin="0,0,6,0" ToolTip="Import document (TXT, Markdown, DOCX, PDF)">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconUploadGeometry}" Fill="{DynamicResource TextBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" />
                                                <TextBlock Text="Import File" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}" Click="PresNewBlank_Click"
                                                Padding="10,5" Margin="0,0,8,0" ToolTip="Start new blank presentation">
                                            <TextBlock Text="New Blank" FontSize="11.5" />
                                        </Button>
                                        <Button x:Name="PresExportPptxBtn" Style="{StaticResource PrimaryButton}" Click="PresExportPptx_Click"
                                                Padding="14,6" ToolTip="Export presentation to editable PowerPoint (.pptx)">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconExportGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="Export PPTX" FontWeight="Bold" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Title & Aspect Ratio -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,10,0">
                                        <Path Data="{StaticResource IconPresentationGeometry}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="Title:" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBox x:Name="PresDeckTitleBox" Width="220" Margin="0,0,12,0" TextChanged="PresDeckTitleBox_TextChanged"
                                                 VerticalAlignment="Center" FontSize="12" Padding="6,3" />

                                        <!-- Aspect Ratio Selector -->
                                        <Border Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="4,2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="PresAspect16x9Btn" Style="{StaticResource PrimaryButton}" Content="16:9" Padding="8,2" FontSize="10.5" Click="PresAspect16x9_Click" />
                                                <Button x:Name="PresAspect4x3Btn" Style="{StaticResource SecondaryButton}" Content="4:3" Padding="8,2" FontSize="10.5" Margin="2,0,0,0" Click="PresAspect4x3_Click" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Unsaved Changes Badge -->
                                        <Border x:Name="PresUnsavedBadge" Background="{DynamicResource WarnSoftBrush}" CornerRadius="4" Padding="6,2" Visibility="Collapsed" VerticalAlignment="Center">
                                            <TextBlock Text="Unsaved Changes" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Alert / Overflow Notification Banner -->
                            <Border Grid.Row="1" x:Name="PresOverflowBanner" Background="#33EA580C" BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="0,0,0,1" Padding="12,6" Visibility="Collapsed">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Split Slide"
                                            Click="PresSplitSlide_Click" Padding="10,3" FontSize="11" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconAlertGeometry}" Fill="{DynamicResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock x:Name="PresOverflowBannerText" Text="Slide content may exceed printable bounds." FontSize="11" Foreground="{DynamicResource TextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Main Content Area: View 1 (Outline Review) or View 2 (Slide Editor) -->
                            <Grid Grid.Row="2">
                                <!-- VIEW 1: OUTLINE REVIEW -->
                                <Grid x:Name="PresOutlineView" Visibility="Collapsed" Margin="20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Outline Header & Settings -->
                                    <Border Grid.Row="0" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="DOCUMENT OUTLINE &amp; SLIDE DIVISION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="PresOutlineSourceFileText" Text="Imported Document" FontWeight="Bold" FontSize="14" Margin="0,0,12,0" />
                                                    <TextBlock x:Name="PresOutlineCharCountText" Text="0 characters" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Controls -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox x:Name="PresOutlineTitleSlideCheck" Content="Title Slide" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />
                                                <CheckBox x:Name="PresOutlineHeadingsAsTitlesCheck" Content="Headings as Titles" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />

                                                <TextBlock Text="Density:" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <RadioButton x:Name="PresDensityCompactRadio" Content="Compact" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <RadioButton x:Name="PresDensityStandardRadio" Content="Standard" IsChecked="True" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <RadioButton x:Name="PresDensitySpaciousRadio" Content="Spacious" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                <Button Style="{StaticResource SecondaryButton}" Content="Regenerate" Click="PresRegenerateOutline_Click" Padding="10,4" FontSize="11" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Scanned PDF / Warning Banner in Outline -->
                                    <Border Grid.Row="0" x:Name="PresOutlineWarningBanner" Background="#33DC2626" BorderBrush="{DynamicResource DangerBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconAlertGeometry}" Fill="{DynamicResource DangerBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                            <TextBlock x:Name="PresOutlineWarningText" Text="Warning" FontSize="11.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Outline Slides List -->
                                    <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="8">
                                        <ListBox x:Name="PresOutlineDraftList" BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="65" />
                                                                <ColumnDefinition Width="200" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Sequence -->
                                                            <Border Grid.Column="0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SequenceText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                                            </Border>

                                                            <!-- Editable Title -->
                                                            <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="12" />

                                                            <!-- Summary of bullets -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding SummaryText}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="{Binding ProvenanceText}" Style="{StaticResource MutedText}" FontSize="9.5" Margin="0,2,0,0" />
                                                            </StackPanel>

                                                            <!-- Reorder & Actions -->
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource GhostButton}" Padding="4" Margin="0,0,2,0"
                                                                        Click="PresOutlineMoveUp_Click" Tag="{Binding}" IsEnabled="{Binding CanMoveUp}" ToolTip="Move up">
                                                                    <Path Data="M7 14l5-5 5 5z" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Uniform" />
                                                                </Button>
                                                                <Button Style="{StaticResource GhostButton}" Padding="4" Margin="0,0,4,0"
                                                                        Click="PresOutlineMoveDown_Click" Tag="{Binding}" IsEnabled="{Binding CanMoveDown}" ToolTip="Move down">
                                                                    <Path Data="M7 10l5 5 5-5z" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Uniform" />
                                                                </Button>
                                                                <Button Style="{StaticResource GhostButton}" Padding="4"
                                                                        Click="PresOutlineDelete_Click" Tag="{Binding}" ToolTip="Delete this draft slide">
                                                                    <Path Data="{StaticResource IconTrashGeometry}" Fill="{DynamicResource DangerBrush}" Width="10" Height="10" Stretch="Uniform" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <!-- Bottom Action Bar -->
                                    <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="+ Add Slide Section" Click="PresOutlineAddDraft_Click" Padding="14,7" FontSize="12" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Open in Slide Editor â†’" Click="PresOutlineProceed_Click" Padding="20,7" FontSize="12.5" FontWeight="Bold" />
                                    </DockPanel>
                                </Grid>

                                <!-- VIEW 2: INTERACTIVE SLIDE EDITOR -->
                                <Grid x:Name="PresEditorView" Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <!-- Column 0: Slide Thumbnails List (250px) -->
                                        <ColumnDefinition Width="250" />
                                        <!-- Splitter -->
                                        <ColumnDefinition Width="6" />
                                        <!-- Column 2: Central WYSIWYG Slide Viewport & Editor (*) -->
                                        <ColumnDefinition Width="*" MinWidth="420" />
                                        <!-- Splitter -->
                                        <ColumnDefinition Width="6" />
                                        <!-- Column 4: Properties & Theme Sidebar (290px) -->
                                        <ColumnDefinition Width="290" />
                                    </Grid.ColumnDefinitions>

                                    <!-- COLUMN 0: SLIDE NAVIGATION & THUMBNAILS -->
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,1,0" Padding="12,10">
                                        <DockPanel LastChildFill="True">
                                            <!-- Navigation Header -->
                                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <TextBlock x:Name="PresSlideCountHeader" Text="SLIDES (0)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ Add" Click="PresAddSlideDropdown_Click" Padding="8,3" FontSize="11" />
                                            </DockPanel>

                                            <!-- Slides List -->
                                            <ListBox x:Name="PresSlideThumbnailsList" BorderThickness="0" Background="Transparent"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     SelectionChanged="PresSlideThumbnailsList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Slide Number Badge -->
                                                                <Border Grid.Column="0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="3,1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding SlideNumberText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                                                </Border>

                                                                <!-- Title & Layout -->
                                                                <StackPanel Grid.Column="1" Margin="6,0,4,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                            <TextBlock Text="{Binding LayoutBadge}" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding SummaryPreview}" Style="{StaticResource MutedText}" FontSize="9.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Quick Actions -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource GhostButton}" Padding="2" Margin="0,0,1,0"
                                                                            Click="PresSlideMoveUp_Click" Tag="{Binding}" IsEnabled="{Binding CanMoveUp}" ToolTip="Move up">
                                                                        <Path Data="M7 14l5-5 5 5z" Fill="{DynamicResource TextBrush}" Width="9" Height="9" Stretch="Uniform" />
                                                                    </Button>
                                                                    <Button Style="{StaticResource GhostButton}" Padding="2" Margin="0,0,2,0"
                                                                            Click="PresSlideMoveDown_Click" Tag="{Binding}" IsEnabled="{Binding CanMoveDown}" ToolTip="Move down">
                                                                        <Path Data="M7 10l5 5 5-5z" Fill="{DynamicResource TextBrush}" Width="9" Height="9" Stretch="Uniform" />
                                                                    </Button>
                                                                    <Button Style="{StaticResource GhostButton}" Padding="2" Margin="0,0,2,0"
                                                                            Click="PresSlideDuplicate_Click" Tag="{Binding}" ToolTip="Duplicate slide">
                                                                        <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Fill="{DynamicResource TextBrush}" Width="9" Height="9" Stretch="Uniform" />
                                                                    </Button>
                                                                    <Button Style="{StaticResource GhostButton}" Padding="2"
                                                                            Click="PresSlideDelete_Click" Tag="{Binding}" ToolTip="Delete slide">
                                                                        <Path Data="{StaticResource IconTrashGeometry}" Fill="{DynamicResource DangerBrush}" Width="9" Height="9" Stretch="Uniform" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>

                                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                                    <!-- COLUMN 2: CENTER WYSIWYG PREVIEW & INLINE EDITING -->
                                    <Border Grid.Column="2" Background="{DynamicResource WindowBgGradient}" Padding="16,12">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <!-- Current Slide Position & Toolbar -->
                                                <DockPanel Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="PresEditorSlideIndexText" Text="Slide 1 of 1" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />
                                                        <TextBlock x:Name="PresEditorSlideLayoutText" Text="Title and Content" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Slide Op Buttons -->
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource SecondaryButton}" Content="Split Slide" Click="PresSplitSlide_Click" Padding="8,4" Margin="0,0,6,0" FontSize="11" ToolTip="Split overlong bullet points into two slides" />
                                                        <Button Style="{StaticResource SecondaryButton}" Content="Merge Next" Click="PresMergeWithNext_Click" Padding="8,4" Margin="0,0,6,0" FontSize="11" ToolTip="Merge next slide into this one" />
                                                        <Button Style="{StaticResource SecondaryButton}" Content="Insert Local Image" Click="PresInsertImage_Click" Padding="8,4" Margin="0,0,6,0" FontSize="11" ToolTip="Add image from disk" />
                                                        <Button x:Name="PresRemoveImageBtn" Style="{StaticResource GhostButton}" Content="Remove Image" Click="PresRemoveImage_Click" Padding="8,4" FontSize="11" Visibility="Collapsed" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- LIVE WYSIWYG SLIDE CANVAS CONTAINER -->
                                                <Border x:Name="PresSlideCanvasOuterBorder" Background="#080C14" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14" HorizontalAlignment="Center">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5" />
                                                    </Border.Effect>

                                                    <!-- Exact aspect-ratio canvas box (default 640x360 for 16:9) -->
                                                    <Border x:Name="PresSlidePreviewBox" Width="640" Height="360" CornerRadius="4" ClipToBounds="True" Background="#080C14" Padding="24">
                                                        <Grid x:Name="PresSlidePreviewContentGrid">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- Slide Title -->
                                                            <TextBlock Grid.Row="0" x:Name="PresSlidePreviewTitle" Text="Presentation Title"
                                                                       FontWeight="Bold" FontSize="20" Foreground="#F9FAFB" FontFamily="Segoe UI"
                                                                       TextWrapping="Wrap" Margin="0,0,0,12" />

                                                            <!-- Layout 1: Standard & 2-Col & Image Body Area -->
                                                            <Grid Grid.Row="1" x:Name="PresSlideDefaultBodyGrid">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" x:Name="PresSlideCol1Def" />
                                                                    <ColumnDefinition Width="*" x:Name="PresSlideCol2Def" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Column 1 Content (Bullets or Paragraph) -->
                                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                    <TextBlock x:Name="PresSlidePreviewSubtitle" Text="" FontSize="14" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                                                                    <TextBlock x:Name="PresSlidePreviewParagraph" Text="" FontSize="12" Foreground="#F9FAFB" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
                                                                    <ItemsControl x:Name="PresSlidePreviewPrimaryBullets">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                                    <TextBlock Text="â€¢" Foreground="#EA580C" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" />
                                                                                    <TextBlock Text="{Binding}" Foreground="#F9FAFB" FontSize="11.5" TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                                <!-- Column 2 Content (Second column or Image) -->
                                                                <StackPanel Grid.Column="1" x:Name="PresSlidePreviewCol2Container" Margin="8,0,0,0" Visibility="Collapsed">
                                                                    <ItemsControl x:Name="PresSlidePreviewSecondaryBullets">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                                    <TextBlock Text="â€¢" Foreground="#EA580C" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" />
                                                                                    <TextBlock Text="{Binding}" Foreground="#F9FAFB" FontSize="11.5" TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <!-- Slide Image Preview -->
                                                                    <Image x:Name="PresSlidePreviewImage" Stretch="Uniform" MaxHeight="220" HorizontalAlignment="Center" Visibility="Collapsed" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Slide Footer (Provenance) -->
                                                            <TextBlock Grid.Row="2" x:Name="PresSlidePreviewProvenanceText" Text=""
                                                                       FontSize="8.5" Foreground="#6B7280" HorizontalAlignment="Right" Margin="0,8,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </Border>

                                                <!-- INLINE TEXT EDITORS -->
                                                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="14">
                                                    <StackPanel>
                                                        <TextBlock Text="EDIT SLIDE CONTENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />

                                                        <!-- Slide Title Input -->
                                                        <TextBlock Text="Slide Title" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
                                                        <TextBox x:Name="PresEditSlideTitleBox" TextChanged="PresEditSlideTitleBox_TextChanged" Margin="0,0,0,10" FontSize="12" Padding="8,4" />

                                                        <!-- Primary Content (Bullets or Paragraph) -->
                                                        <TextBlock x:Name="PresEditPrimaryContentLabel" Text="Bullet Points (One per line)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
                                                        <TextBox x:Name="PresEditPrimaryContentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85"
                                                                 TextChanged="PresEditPrimaryContentBox_TextChanged" Margin="0,0,0,10" FontSize="11.5" Padding="8,6" />

                                                        <!-- Secondary Column Content (When TwoColumn layout) -->
                                                        <StackPanel x:Name="PresEditSecondaryBlock" Visibility="Collapsed">
                                                            <TextBlock Text="Column 2 Items (One per line)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
                                                            <TextBox x:Name="PresEditSecondaryContentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                                                     TextChanged="PresEditSecondaryContentBox_TextChanged" Margin="0,0,0,10" FontSize="11.5" Padding="8,6" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>

                                    <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

                                    <!-- COLUMN 4: PROPERTIES & THEME CUSTOMIZATION -->
                                    <Border Grid.Column="4" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1,0,0,0" Padding="14,10">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <!-- Layout Section -->
                                                <TextBlock Text="SLIDE LAYOUT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                                                <WrapPanel Margin="0,0,0,14">
                                                    <Button x:Name="PresLayoutTitleBtn" Style="{StaticResource SecondaryButton}" Content="Title" Padding="6,3" Margin="0,0,3,3" Click="PresLayout_Click" Tag="Title" FontSize="10" />
                                                    <Button x:Name="PresLayoutContentBtn" Style="{StaticResource PrimaryButton}" Content="Content" Padding="6,3" Margin="0,0,3,3" Click="PresLayout_Click" Tag="TitleAndContent" FontSize="10" />
                                                    <Button x:Name="PresLayoutDividerBtn" Style="{StaticResource SecondaryButton}" Content="Divider" Padding="6,3" Margin="0,0,3,3" Click="PresLayout_Click" Tag="SectionDivider" FontSize="10" />
                                                    <Button x:Name="PresLayoutTwoColBtn" Style="{StaticResource SecondaryButton}" Content="2-Col" Padding="6,3" Margin="0,0,3,3" Click="PresLayout_Click" Tag="TwoColumn" FontSize="10" />
                                                    <Button x:Name="PresLayoutTextImgBtn" Style="{StaticResource SecondaryButton}" Content="Text+Img" Padding="6,3" Margin="0,0,3,3" Click="PresLayout_Click" Tag="TextWithImage" FontSize="10" />
                                                    <Button x:Name="PresLayoutImgFocusBtn" Style="{StaticResource SecondaryButton}" Content="Img Focus" Padding="6,3" Margin="0,0,3,3" Click="PresLayout_Click" Tag="ImageFocused" FontSize="10" />
                                                    <Button x:Name="PresLayoutBlankBtn" Style="{StaticResource SecondaryButton}" Content="Blank" Padding="6,3" Margin="0,0,3,3" Click="PresLayout_Click" Tag="Blank" FontSize="10" />
                                                </WrapPanel>

                                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                                                <!-- Theme Section -->
                                                <TextBlock Text="THEME SELECTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                                                <StackPanel Margin="0,0,0,14">
                                                    <Button x:Name="PresThemeDarkSlateBtn" Style="{StaticResource PrimaryButton}" Content="Dark Slate (SmartShift)" Click="PresTheme_Click" Tag="Dark Slate" Padding="8,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" FontSize="11" />
                                                    <Button x:Name="PresThemeModernMinimalBtn" Style="{StaticResource SecondaryButton}" Content="Modern Minimal (Light)" Click="PresTheme_Click" Tag="Modern Minimal" Padding="8,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" FontSize="11" />
                                                    <Button x:Name="PresThemeClassicNavyBtn" Style="{StaticResource SecondaryButton}" Content="Classic Navy" Click="PresTheme_Click" Tag="Classic Navy" Padding="8,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" FontSize="11" />
                                                    <Button x:Name="PresThemeVibrantSunsetBtn" Style="{StaticResource SecondaryButton}" Content="Vibrant Sunset" Click="PresTheme_Click" Tag="Vibrant Sunset" Padding="8,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" FontSize="11" />
                                                    <Button x:Name="PresThemeForestGreenBtn" Style="{StaticResource SecondaryButton}" Content="Forest Green" Click="PresTheme_Click" Tag="Forest Green" Padding="8,4" Margin="0,0,0,4" HorizontalContentAlignment="Left" FontSize="11" />
                                                </StackPanel>

                                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />

                                                <!-- Typography & Appearance -->
                                                <TextBlock Text="TYPOGRAPHY &amp; STYLE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
                                                
                                                <TextBlock Text="Font Family" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                                <ComboBox x:Name="PresFontFamilyCombo" SelectionChanged="PresFontFamilyCombo_SelectionChanged" Margin="0,0,0,8" FontSize="11">
                                                    <ComboBoxItem Content="Segoe UI" IsSelected="True" />
                                                    <ComboBoxItem Content="Calibri" />
                                                    <ComboBoxItem Content="Arial" />
                                                    <ComboBoxItem Content="Georgia" />
                                                    <ComboBoxItem Content="Consolas" />
                                                </ComboBox>

                                                <TextBlock Text="Title Font Size" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                                <Slider x:Name="PresTitleSizeSlider" Minimum="24" Maximum="54" Value="36" ValueChanged="PresTitleSizeSlider_ValueChanged" Margin="0,0,0,8" />

                                                <TextBlock Text="Body Font Size" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                                <Slider x:Name="PresBodySizeSlider" Minimum="12" Maximum="28" Value="18" ValueChanged="PresBodySizeSlider_ValueChanged" Margin="0,0,0,8" />

                                                <TextBlock Text="Alignment" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Button x:Name="PresAlignLeftBtn" Style="{StaticResource PrimaryButton}" Content="Left" Padding="8,2" FontSize="10.5" Click="PresAlignLeft_Click" />
                                                    <Button x:Name="PresAlignCenterBtn" Style="{StaticResource SecondaryButton}" Content="Center" Padding="8,2" FontSize="10.5" Margin="4,0,0,0" Click="PresAlignCenter_Click" />
                                                </StackPanel>

                                                <!-- Color Overrides -->
                                                <TextBlock Text="Background Color (Hex)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                                <TextBox x:Name="PresBgColorBox" Text="#080C14" Margin="0,0,0,6" FontSize="11" TextChanged="PresColorBox_TextChanged" />

                                                <TextBlock Text="Accent Color (Hex)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                                <TextBox x:Name="PresAccentColorBox" Text="#EA580C" Margin="0,0,0,14" FontSize="11" TextChanged="PresColorBox_TextChanged" />

                                                <!-- Source Provenance Card -->
                                                <Border x:Name="PresProvenanceCard" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10" Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="SOURCE PROVENANCE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" />
                                                        <TextBlock x:Name="PresProvenanceCardText" Text="" Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Bottom Progress and Result Floating Blocks -->
                            <!-- Progress Block -->
                            <Border Grid.Row="2" x:Name="PresProgressBlock" Background="#E6080C14" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="PresProgressStatusText" Text="Generating PowerPoint presentationâ€¦" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8" />
                                    <ProgressBar x:Name="PresProgressBar" Height="4" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,12" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Click="PresCancelExport_Click" HorizontalAlignment="Right" Padding="12,4" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <!-- Success Result Card -->
                            <Border Grid.Row="2" x:Name="PresResultCard" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource OkBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="20" Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center" Width="480" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Path Data="{StaticResource IconCheckGeometry}" Fill="{DynamicResource OkBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="PowerPoint Presentation Exported!" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Your presentation was generated with editable slides and native text objects." Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,8" />
                                    <TextBlock x:Name="PresResultPathText" Text="C:\Outputs\Presentation.pptx" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Open Presentation" Click="PresOpenResult_Click" Padding="14,6" Margin="0,0,8,0" FontSize="11.5" FontWeight="SemiBold" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Show in Folder" Click="PresRevealResult_Click" Padding="14,6" Margin="0,0,8,0" FontSize="11.5" />
                                        <Button Style="{StaticResource GhostButton}" Content="Dismiss" Click="PresDismissResult_Click" Padding="10,6" FontSize="11.5" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- SIDEBAR FLYOUT: RECENT RESULTS / WORKFLOW STUDIO -->
        <!-- ========================================== -->
        <Border x:Name="RecentResultsFlyout" Grid.Row="1" Grid.RowSpan="2"
                Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Margin="70,10,20,20" Padding="18"
                HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="760" MaxHeight="680" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.6" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hidden legacy elements for backward compatibility -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="RecentFileNameText" />
                    <TextBlock x:Name="RecentFilePathText" />
                    <Button x:Name="RecentOpenBtn" />
                    <Button x:Name="RecentFolderBtn" />
                </StackPanel>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="CloseRecentFlyout_Click" Padding="4">
                        <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Workflow &amp; Output Management" Style="{StaticResource SectionHeading}" Margin="0,0,10,0" />
                        <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock x:Name="HistoryCountBadge" Text="0 operations" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Tab Strip & Global Actions -->
                <DockPanel Grid.Row="1" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Content="Open Output Folder" Click="OpenOutputs_Click" Padding="10,5" Margin="0,0,6,0" FontSize="11" />
                        <Button Style="{StaticResource GhostButton}" Content="Clear History" Click="ClearHistory_Click" Padding="10,5" FontSize="11" Foreground="{DynamicResource DangerBrush}" ToolTip="Clear history records (disk files are never deleted)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HistoryTabBtn" Style="{StaticResource PrimaryButton}" Content="Processing History &amp; Outputs" Click="HistoryTab_Click" Padding="12,5" Margin="0,0,8,0" FontSize="11.5" />
                        <Button x:Name="WorkflowsTabBtn" Style="{StaticResource SecondaryButton}" Content="Saved Workflows" Click="WorkflowsTab_Click" Padding="12,5" FontSize="11.5" />
                    </StackPanel>
                </DockPanel>

                <!-- History & Outputs View Panel -->
                <Grid x:Name="HistoryViewPanel" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HistorySearchBox" Grid.Column="0" Margin="0,0,8,0" Padding="8,5"
                                 TextChanged="HistorySearchBox_TextChanged" />
                        <ComboBox x:Name="HistoryStatusFilterCombo" Grid.Column="1" Margin="0,0,8,0"
                                  SelectionChanged="HistoryFilter_SelectionChanged" />
                        <ComboBox x:Name="HistoryCategoryFilterCombo" Grid.Column="2"
                                  SelectionChanged="HistoryFilter_SelectionChanged" />
                    </Grid>

                    <!-- List & Inspector Columns -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: List -->
                        <Border Grid.Column="0" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,10,0">
                            <Grid>
                                <ListBox x:Name="HistoryListBox"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="HistoryListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6" Background="Transparent">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <DockPanel Grid.Row="0">
                                                        <Border DockPanel.Dock="Right" Background="{Binding StatusBackgroundBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding ActionName}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="1" Text="{Binding PrimaryInputFileName}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    <DockPanel Grid.Row="2" Margin="0,3,0,0">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding FormattedDuration}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                                                        <TextBlock Text="{Binding FormattedTimestamp}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Empty Placeholder -->
                                <Border x:Name="HistoryEmptyPlaceholder" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="No operations found" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="13" />
                                        <TextBlock Text="Run actions or adjust filters to see history." FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Right: Details Inspector Card -->
                        <Border x:Name="HistoryInspectorCard" Grid.Column="1" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock x:Name="HistoryInspectorStatusText" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock x:Name="HistoryInspectorActionName" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <!-- Timestamps and Duration -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Execution Time" Style="{StaticResource MutedText}" FontSize="10.5" />
                                            <TextBlock x:Name="HistoryInspectorTimestamp" FontWeight="Medium" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Duration" Style="{StaticResource MutedText}" FontSize="10.5" />
                                            <TextBlock x:Name="HistoryInspectorDuration" FontWeight="Medium" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Input File -->
                                    <TextBlock Text="Input File" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                    <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                                        <TextBlock x:Name="HistoryInspectorInputPath" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <!-- Output File & Availability -->
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock x:Name="HistoryInspectorOutputStatus" DockPanel.Dock="Right" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="Output File" Style="{StaticResource MutedText}" FontSize="10.5" />
                                    </DockPanel>
                                    <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock x:Name="HistoryInspectorSize" DockPanel.Dock="Right" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="HistoryInspectorOutputPath" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>

                                    <!-- Output Actions -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button x:Name="HistoryInspectorOpenBtn" Style="{StaticResource SecondaryButton}" Content="Open File" Click="HistoryItemOpen_Click" Padding="10,4" Margin="0,0,6,0" FontSize="11" />
                                        <Button x:Name="HistoryInspectorRevealBtn" Style="{StaticResource SecondaryButton}" Content="Show in Folder" Click="HistoryItemReveal_Click" Padding="10,4" Margin="0,0,6,0" FontSize="11" />
                                        <Button x:Name="HistoryInspectorCopyBtn" Style="{StaticResource GhostButton}" Content="Copy Path" Click="HistoryItemCopyPath_Click" Padding="8,4" FontSize="11" />
                                    </StackPanel>

                                    <!-- Error / Failure Diagnostics -->
                                    <Border x:Name="HistoryInspectorErrorBlock" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Failure Reason" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4" />
                                            <TextBlock x:Name="HistoryInspectorErrorText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                                            <Button x:Name="HistoryInspectorRetryBtn" Style="{StaticResource PrimaryButton}" Content="↻ Retry Operation" Click="HistoryItemRetry_Click" Padding="10,4" HorizontalAlignment="Left" FontSize="11" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Delete Entry Record -->
                                    <Button Style="{StaticResource GhostButton}" Content="Remove from History" Click="HistoryItemDelete_Click" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Padding="6,3" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Saved Workflows View Panel -->
                <Grid x:Name="WorkflowsViewPanel" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="+ Save Current as Workflow" Click="SaveCurrentAsWorkflow_Click" Padding="10,4" FontSize="11" />
                        <TextBlock Text="Reusable presets for repeated batch and single operations:" Style="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Workflows List -->
                        <Border Grid.Column="0" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,10,0">
                            <ListBox x:Name="WorkflowsListBox"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="WorkflowsListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6" Background="Transparent">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <DockPanel Grid.Row="0">
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CategoryBadgeText}" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Right: Workflow Inspector Card -->
                        <Border x:Name="WorkflowInspectorCard" Grid.Column="1" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="WorkflowInspectorCategory" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock x:Name="WorkflowInspectorName" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock x:Name="WorkflowInspectorDesc" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <TextBlock Text="Preset Options" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                <Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,14">
                                    <TextBlock x:Name="WorkflowInspectorOptions" FontSize="11" TextWrapping="Wrap" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Style="{StaticResource PrimaryButton}" Content="▶ Run on Selected File" Click="RunWorkflowOnCurrentFile_Click" Padding="12,5" Margin="0,0,6,0" FontSize="11" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Duplicate" Click="DuplicateWorkflow_Click" Padding="10,5" Margin="0,0,6,0" FontSize="11" />
                                    <Button x:Name="WorkflowInspectorDeleteBtn" Style="{StaticResource GhostButton}" Content="Delete" Click="DeleteWorkflow_Click" Padding="8,5" FontSize="11" Foreground="{DynamicResource DangerBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- SIDEBAR FLYOUT: SETTINGS & PRIVACY         -->
        <!-- ========================================== -->
        <Border x:Name="SettingsFlyout" Grid.Row="1" Grid.RowSpan="2"
                Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Margin="70,10,20,20" Padding="20"
                HorizontalAlignment="Left" VerticalAlignment="Top" Width="420" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.6" />
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="CloseSettingsFlyout_Click" Padding="4">
                        <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <TextBlock Text="Settings &amp; Architecture" Style="{StaticResource SectionHeading}" />
                </DockPanel>
                <!-- Privacy Guarantee -->
                <Border Background="{DynamicResource OkBgBrush}" BorderBrush="{DynamicResource OkBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="100% Local-First Guarantee" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="All document and image operations are executed directly on your local hardware. No files, logs, or metrics leave your device."
                                   Style="{StaticResource MutedText}" FontSize="11.5" />
                    </StackPanel>
                </Border>
                <!-- Output Folder -->
                <TextBlock Text="Output Directory" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="SettingsOutputDirBox" IsReadOnly="True" Margin="0,0,0,8" />
                <Button Style="{StaticResource SecondaryButton}" Content="Open Outputs in Explorer" Click="OpenOutputs_Click" Margin="0,0,0,16" />
                <!-- Engine Details -->
                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Active Local Engines" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <TextBlock Text="â€¢ Images: SkiaSharp (JPEG, PNG, WebP)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                        <TextBlock Text="â€¢ PDF Preview &amp; Export: PDFium / Docnet.Core" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                        <TextBlock Text="â€¢ PDF Compression &amp; Office Export: UglyToad.PdfPig &amp; OpenXml" Style="{StaticResource MutedText}" FontSize="11" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- LOADING / INGEST OVERLAY                   -->
        <!-- ========================================== -->
        <Border x:Name="LoadingOverlay" Background="#D9080C14" Visibility="Collapsed" IsHitTestVisible="True"
                Grid.Row="0" Grid.RowSpan="3" CornerRadius="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="50" Height="50" CornerRadius="25" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,0,14" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconUploadGeometry}" Fill="{DynamicResource AccentBrush}" Width="22" Height="22" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="LoadingTitle" Foreground="White" FontSize="16" FontWeight="SemiBold" Text="Inspecting filesâ€¦" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadingDetail" Foreground="#94A3B8" Margin="0,6,0,0" Text="Reading file headers. Originals are never moved." HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
