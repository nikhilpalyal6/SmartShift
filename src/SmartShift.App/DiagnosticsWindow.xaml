<Window x:Class="SmartShift.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartShift diagnostics"
        Width="720"
        Height="480"
        MinWidth="520"
        MinHeight="320">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TitleText}" Text="Development diagnostics" />
        <TextBlock DockPanel.Dock="Top"
                   Style="{StaticResource MutedText}"
                   Margin="0,6,0,12"
                   Text="These controls are not part of the normal workflow. The observe-only hook never reads OLE file payloads. The cursor probe can intercept Explorer drops — leave it off unless you are testing interception." />
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Style="{StaticResource SecondaryButton}" Content="Show Phase 0 Drop Shelf" Click="ShowShelf_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="Hide Phase 0 Drop Shelf" Click="HideShelf_Click" />
            <ToggleButton x:Name="HookToggle" Content="Observe-only mouse hook" Margin="0,0,8,0" Padding="12,8" Checked="HookToggle_Checked" Unchecked="HookToggle_Unchecked" />
            <ToggleButton x:Name="ProbeToggle" Content="Cursor drop probe" Padding="12,8" Checked="ProbeToggle_Checked" Unchecked="ProbeToggle_Unchecked" />
        </WrapPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="0,0,0,8" Text="Hook off. Probe off." />
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" Text="Local log" />
                <TextBox x:Name="LogBox"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="12"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="NoWrap" />
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
