<Window x:Class="SmartShift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartShift — Unified File Workspace"
        Width="1260"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgGradient}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Compact Top Navigation Bar -->
            <RowDefinition Height="Auto" />
            <!-- Notification Banner -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- TOP NAVIGATION BAR                         -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,9">
            <DockPanel LastChildFill="False">
                <!-- Brand Title and Identity -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <!-- Brand Icon with subtle gradient glow -->
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentGradient}" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#EA580C" BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
                        </Border.Effect>
                        <Path Data="{StaticResource IconConvertGeometry}" Fill="White" Width="17" Height="17" Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SmartShift" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}" />
                            <!-- Local Privacy Indicator Badge -->
                            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource OkBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="LOCAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Your private file workspace · Zero cloud uploads" Style="{StaticResource MutedText}" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Top Right Utility Actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Browse Files Action -->
                    <Button Style="{StaticResource PrimaryButton}" Click="BrowseFiles_Click"
                            ToolTip="Browse your computer to add images or PDFs" Margin="0,0,8,0" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlusGeometry}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Browse files" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Open Output Folder Button -->
                    <Button x:Name="OpenOutputsBtn" Style="{StaticResource SecondaryButton}" Content="Open output folder" Click="OpenOutputs_Click"
                            ToolTip="Opens the SmartShift output folder in Windows File Explorer" Margin="0,0,8,0">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolderGeometry}" Fill="{DynamicResource MutedBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                    <AccessText Text="Output folder" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- Locate Last Result Button -->
                    <Button x:Name="RevealResultButton" Style="{StaticResource SecondaryButton}" Content="Locate last result"
                            Click="RevealResult_Click" Visibility="Collapsed" Margin="0,0,8,0"
                            ToolTip="Selects the last processed output file in Windows File Explorer">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconExternalGeometry}" Fill="{DynamicResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                    <AccessText Text="Locate last result" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- Diagnostics Button -->
                    <Button x:Name="DiagnosticsButton" Style="{StaticResource GhostButton}" Content="Diagnostics"
                            Click="Diagnostics_Click" Visibility="Collapsed" ToolTip="Developer Diagnostics Window">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconInfoGeometry}" Fill="{DynamicResource MutedBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                    <AccessText Text="Diagnostics" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================== -->
        <!-- NOTIFICATION BANNER                        -->
        <!-- ========================================== -->
        <Border x:Name="Banner" Grid.Row="1" Margin="16,8,16,0" CornerRadius="10" BorderThickness="1"
                BorderBrush="#2610B981" Padding="16,9" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="CloseBanner_Click" Padding="4" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                </Button>
                <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="Medium" FontSize="12.5" />
            </DockPanel>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN APPLICATION BODY                      -->
        <!-- ========================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Compact Sidebar Navigation -->
                <ColumnDefinition x:Name="SidebarColDef" Width="64" />
                <!-- Workspace Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource GlassSidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,12">
                <DockPanel LastChildFill="False">
                    <!-- Top Navigation Items -->
                    <StackPanel DockPanel.Dock="Top">
                        <!-- Workspace Item -->
                        <Button x:Name="NavWorkspaceBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavWorkspace_Click" Tag="Active" Margin="0,0,0,6"
                                ToolTip="File Workspace &amp; Processing">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHomeGeometry}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                <TextBlock x:Name="NavWorkspaceText" Text="Workspace" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Queue Item -->
                        <Button x:Name="NavQueueBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavQueue_Click" Margin="0,0,0,6"
                                ToolTip="Current Processing Queue">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconQueueGeometry}" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                    <TextBlock x:Name="NavQueueText" Text="Queue" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                                </StackPanel>
                                <Border x:Name="NavQueueBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-2,0">
                                    <TextBlock x:Name="NavQueueBadgeText" Text="0" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Recent Files / Results -->
                        <Button x:Name="NavRecentBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavRecent_Click" Margin="0,0,0,6"
                                ToolTip="Recent Results (Current Session)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHistoryGeometry}" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                <TextBlock x:Name="NavRecentText" Text="Recent" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Settings & Privacy -->
                        <Button x:Name="NavSettingsBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavSettings_Click"
                                ToolTip="Settings &amp; Local Engine Status">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettingsGeometry}" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                <TextBlock x:Name="NavSettingsText" Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Sidebar Controls -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <!-- Privacy Lock Indicator -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="6" Margin="0,0,0,8" ToolTip="All operations executed locally">
                            <Path Data="{StaticResource IconLockGeometry}" Fill="{DynamicResource OkBrush}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" />
                        </Border>

                        <!-- Sidebar Toggle Expand/Collapse -->
                        <Button Style="{StaticResource GhostButton}" Click="ToggleSidebar_Click" ToolTip="Expand or collapse sidebar" Padding="6" HorizontalAlignment="Center">
                            <Path Data="M9 5l7 7-7 7" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- WORKSPACE CONTENT AREA (3 Responsive Columns) -->
            <Grid Grid.Column="1" Margin="14">
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Left File Shelf & Drop Zone -->
                    <ColumnDefinition Width="310" MinWidth="260" MaxWidth="400" />
                    <!-- Splitter -->
                    <ColumnDefinition Width="10" />
                    <!-- Column 2: Center Contextual Action & Preview Workspace -->
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <!-- Splitter -->
                    <ColumnDefinition Width="10" />
                    <!-- Column 4: Right Action Settings & Results -->
                    <ColumnDefinition Width="360" MinWidth="320" MaxWidth="460" />
                </Grid.ColumnDefinitions>

                <!-- ========================================== -->
                <!-- COLUMN 0: LEFT FILE SHELF                  -->
                <!-- ========================================== -->
                <Border Grid.Column="0" Style="{StaticResource Card}" x:Name="DropZone" Padding="12">
                    <DockPanel>
                        <!-- Shelf Header -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Workspace Files" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                                <Border x:Name="QueueCountBadge" Background="{DynamicResource SurfaceElevatedBrush}"
                                        CornerRadius="9" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="QueueCountText" Text="0 files" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                </Border>
                            </StackPanel>

                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear queue"
                                    Click="ClearQueue_Click" HorizontalAlignment="Right"
                                    ToolTip="Removes all items from this list. Does not delete any files on disk.">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconTrashGeometry}" Fill="{DynamicResource MutedBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                            <AccessText Text="Clear" FontSize="11.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </DockPanel>

                        <!-- Shelf Status Subhead -->
                        <TextBlock x:Name="QueueSummary" DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                   Text="Drop files to begin." />

                        <!-- Compact Drop Cue when files exist -->
                        <Border x:Name="CompactDropCue" DockPanel.Dock="Top" Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="9,7" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconUploadGeometry}" Fill="{DynamicResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Drop more files to add" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Batch Action Button when multiple images exist in queue -->
                        <Button x:Name="ShelfBatchButton" DockPanel.Dock="Top" Style="{StaticResource PrimaryButton}"
                                Click="OpenBatchStudio_Click" Padding="10,7" Margin="0,0,0,10" Visibility="Collapsed"
                                ToolTip="Open Batch Image Studio to process multiple images in one batch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconQueueGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock x:Name="ShelfBatchButtonText" Text="Batch Process Images" FontWeight="SemiBold" FontSize="11.5" />
                            </StackPanel>
                        </Button>

                        <!-- Queue List & Empty State Host -->
                        <Grid>
                            <!-- Large Empty State Drop Area -->
                            <Border x:Name="EmptyState" Background="{DynamicResource GlassCardBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1.5"
                                    CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,10">
                                <StackPanel HorizontalAlignment="Center" Margin="14,24">
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,0,12" HorizontalAlignment="Center">
                                        <TextBlock Text="DROP FILES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock Text="Drop files here" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="Drag images or PDFs from Explorer."
                                               Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,0,0,14" />

                                    <!-- Browse Files Button inside Drop Zone -->
                                    <Button Style="{StaticResource PrimaryButton}" Click="BrowseFiles_Click" HorizontalAlignment="Center" Padding="16,7" Margin="0,0,0,16">
                                        <TextBlock Text="Browse Files" FontSize="12" FontWeight="SemiBold" />
                                    </Button>

                                    <!-- Supported File Type Badges -->
                                    <WrapPanel HorizontalAlignment="Center">
                                        <Border Background="#162238" CornerRadius="4" Padding="6,2.5" Margin="2">
                                            <TextBlock Text="PNG" FontSize="9.5" FontWeight="Bold" Foreground="#60A5FA" />
                                        </Border>
                                        <Border Background="#162238" CornerRadius="4" Padding="6,2.5" Margin="2">
                                            <TextBlock Text="JPEG" FontSize="9.5" FontWeight="Bold" Foreground="#FBBF24" />
                                        </Border>
                                        <Border Background="#162238" CornerRadius="4" Padding="6,2.5" Margin="2">
                                            <TextBlock Text="WEBP" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>
                                        <Border Background="#162238" CornerRadius="4" Padding="6,2.5" Margin="2">
                                            <TextBlock Text="PDF" FontSize="9.5" FontWeight="Bold" Foreground="#F87171" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="Original files are never overwritten." FontSize="10" Foreground="{DynamicResource SubtleBrush}" TextAlignment="Center" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- File List -->
                            <ListBox x:Name="FileList" Visibility="Collapsed" SelectionChanged="FileList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Real Thumbnail / Vector Icon -->
                                                    <ColumnDefinition Width="42" />
                                                    <!-- Metadata -->
                                                    <ColumnDefinition Width="*" />
                                                    <!-- Remove button -->
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Real Thumbnail or Type-Specific Icon Container -->
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6"
                                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        ClipToBounds="True" Margin="0,0,10,0" HorizontalAlignment="Left">
                                                    <Grid>
                                                        <!-- When real thumbnail is available -->
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />

                                                        <!-- Vector fallback icon when no thumbnail -->
                                                        <Path Data="{Binding CategoryIconKey, Converter={x:Null}}"
                                                              Fill="{Binding FormatTagBrush}"
                                                              Width="18" Height="18" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                </Border>

                                                <!-- File Information Block -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Background="{Binding FormatTagBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Extension}" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Remove button -->
                                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="4"
                                                        Click="RemoveFile_Click" Tag="{Binding}" ToolTip="Remove from list. Disk file is unchanged.">
                                                    <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Grid Splitter -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- ========================================== -->
                <!-- COLUMN 2: CENTER ACTION & PREVIEW AREA     -->
                <!-- ========================================== -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid x:Name="RadialWorkspaceHost">
                        <!-- Warm sunset aura behind radial petal wheel -->
                        <Ellipse Width="540" Height="540" IsHitTestVisible="False" Opacity="0.18"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#F97316" Offset="0" />
                                    <GradientStop Color="#EA580C" Offset="0.45" />
                                    <GradientStop Color="#00EA580C" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- When No File Selected: Guidance State -->
                        <Border x:Name="EmptyRadialPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Visible" MaxWidth="440" Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="32,36">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="WORKSPACE READY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <TextBlock Text="Unified File Workspace" FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Select a file from the shelf on the left or drop an image or PDF to inspect properties and run local operations."
                                           Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,22" />
                                <Button Style="{StaticResource PrimaryButton}" Click="BrowseFiles_Click" HorizontalAlignment="Center" Padding="20,9">
                                    <TextBlock Text="Browse Files to Start" FontSize="12.5" FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Selected File Workspace Host (Smart Header + Smart Circle) -->
                        <Grid x:Name="SmartCircleWorkspaceGrid">
                            <Grid.RowDefinitions>
                                <!-- Top Compact File Info Bar -->
                                <RowDefinition Height="Auto" />
                                <!-- Smart Circle Interactive Orbit Canvas -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Compact File Info Bar -->
                            <Border x:Name="CenterFileHeaderBar" Grid.Row="0" Background="{DynamicResource GlassPanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9"
                                    Visibility="Collapsed">
                                <DockPanel LastChildFill="True">
                                    <!-- Quick Action for PDF: View Document -->
                                    <Button DockPanel.Dock="Right" x:Name="HeroOpenPdfBtn" Style="{StaticResource SecondaryButton}"
                                            Click="HeroOpenPdf_Click" Visibility="Collapsed" VerticalAlignment="Center" Padding="11,5"
                                            ToolTip="Open interactive PDF document viewer">
                                        <TextBlock Text="View Document" FontSize="11.5" FontWeight="SemiBold" />
                                    </Button>

                                    <!-- Quick Action for Image: Edit Image -->
                                    <Button DockPanel.Dock="Right" x:Name="HeroEditImageBtn" Style="{StaticResource PrimaryButton}"
                                            Click="HeroEditImage_Click" Visibility="Collapsed" VerticalAlignment="Center" Padding="12,5" Margin="0,0,8,0"
                                            ToolTip="Open interactive image editor to crop, rotate, flip &amp; resize">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCropGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Edit Image" FontSize="11.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Hotkey hint -->
                                    <TextBlock DockPanel.Dock="Right" Text="Press 1–7 to select action" FontSize="11" Foreground="{DynamicResource SubtleBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <!-- File Info & Specs -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="HeroFileNameText" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border x:Name="HeroFormatBadge" CornerRadius="3" Padding="5,1.5" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,6,0">
                                                <TextBlock x:Name="HeroFormatText" Text="FILE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock x:Name="HeroFileSizeText" Text="" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="HeroDimensionsText" Text="" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Active Smart Circle Orbital Canvas -->
                            <Canvas Grid.Row="1" x:Name="RadialMenuCanvas" Visibility="Collapsed"
                                    SizeChanged="RadialMenuCanvas_SizeChanged">

                                <!-- Smart Dynamic Connecting Beam (Preserved hidden for safety) -->
                                <Line x:Name="SmartConnectingBeam"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      IsHitTestVisible="False" />

                                <!-- Outer Framing Track -->
                                <Ellipse x:Name="OrbitalRing" Stroke="#40FDE68A"
                                         StrokeThickness="1" IsHitTestVisible="False" />

                                <!-- Inner Concentric Hub Rim (Golden Amber Specular Rim) -->
                                <Ellipse x:Name="InnerOrbitalRing" Stroke="#B3F59E0B"
                                         StrokeThickness="2" IsHitTestVisible="False" />

                                <!-- Ambient Breathing Halo behind Center Core -->
                                <Ellipse x:Name="CenterCoreHalo" IsHitTestVisible="False" Opacity="0.32">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#80F97316" Offset="0" />
                                            <GradientStop Color="#40EA580C" Offset="0.5" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#EA580C" BlurRadius="36" ShadowDepth="0" Opacity="0.65" />
                                    </Ellipse.Effect>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.22" To="0.52" Duration="0:0:2.4">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>

                                <!-- Center Selected File Viewport Container (Smart Core - Mathematically Circular) -->
                                <Border x:Name="CenterPreviewContainer"
                                        Background="#E6111827"
                                        BorderBrush="#80F59E0B"
                                        BorderThickness="2"
                                        CornerRadius="105"
                                        ClipToBounds="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.75" />
                                    </Border.Effect>
                                    <Border.OpacityMask>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="Black" Offset="0.98" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.OpacityMask>
                                    <Grid>
                                        <!-- Center Image Preview -->
                                        <Image x:Name="CenterPreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />

                                        <!-- Center PDF / Document Placeholder -->
                                        <StackPanel x:Name="CenterDocumentPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Border Width="50" Height="50" CornerRadius="12" Background="{DynamicResource DangerSoftBrush}"
                                                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                                    Margin="0,0,0,8" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconPdfGeometry}" Fill="{DynamicResource DangerBrush}" Width="26" Height="26" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock x:Name="CenterDocFormat" Text="PDF Document" FontWeight="Bold" FontSize="13.5" TextAlignment="Center" />
                                            <TextBlock x:Name="CenterDocVersion" Text="%PDF-1.7" Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Top Format Pill Floating Inside Core -->
                                        <Border Background="#E6080C14" BorderBrush="#80F59E0B" BorderThickness="1"
                                                CornerRadius="8" Padding="9,3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
                                            <TextBlock x:Name="CenterPreviewLabel" Text="Source Preview" FontSize="10" FontWeight="SemiBold" Foreground="#FDE68A" />
                                        </Border>

                                        <!-- Bottom Active Action Status Capsule Inside Core -->
                                        <Border x:Name="CenterActiveActionPill" Background="#F2EA580C" BorderBrush="#FFFFFFFF" BorderThickness="1"
                                                CornerRadius="12" Padding="11,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#EA580C" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="CenterActiveActionText" Text="Ready" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Dropover Radial Petal Wheel Actions Control -->
                                <ItemsControl x:Name="RadialActionsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="0" />
                                            <Setter Property="Canvas.Top" Value="0" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DropoverPetalStyle}"
                                                    Click="RadialAction_Click"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding IsAvailable}"
                                                    AutomationProperties.Name="{Binding FullTitle}">
                                                <Button.ToolTip>
                                                    <ToolTip Background="#111827" BorderBrush="#34466D" Foreground="White">
                                                        <StackPanel MaxWidth="240">
                                                            <TextBlock Text="{Binding FullTitle}" FontWeight="Bold" FontSize="13" />
                                                            <TextBlock Text="{Binding GoalTitle}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,4" />
                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" />
                                                            <Border Background="{Binding BadgeBrush}" CornerRadius="4" Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeForeground}" FontSize="10" FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Fallback / Hidden reference for test compatibility -->
                                <ItemsControl x:Name="ModernActionCardsControl" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>

                        <!-- Native PDF Preview Host Overlay -->
                        <Grid x:Name="PdfPreviewHost" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}">
                            <Grid.RowDefinitions>
                                <!-- Top Preview Toolbar -->
                                <RowDefinition Height="Auto" />
                                <!-- Viewport Canvas / ScrollViewer -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="12,8">
                                <DockPanel LastChildFill="False">
                                    <!-- Close Preview Button -->
                                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="ClosePreview_Click" Padding="10,5" Margin="0,0,12,0" ToolTip="Close preview (Esc)">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource TextBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Close Preview" FontWeight="SemiBold" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Page Navigation Controls -->
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PdfPrevPageBtn" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" Click="PdfPrevPage_Click" ToolTip="Previous page (Left Arrow)">
                                            <Path Data="M15 19l-7-7 7-7" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform" />
                                        </Button>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                            <TextBlock Text="Page" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11.5" />
                                            <TextBox x:Name="PdfCurrentPageBox" Width="44" Text="1" TextAlignment="Center" KeyDown="PdfCurrentPageBox_KeyDown" LostFocus="PdfCurrentPageBox_LostFocus" VerticalAlignment="Center" />
                                            <TextBlock x:Name="PdfTotalPagesText" Text="of 1" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11.5" />
                                        </StackPanel>

                                        <Button x:Name="PdfNextPageBtn" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="6,0,12,0" Click="PdfNextPage_Click" ToolTip="Next page (Right Arrow)">
                                            <Path Data="M9 5l7 7-7 7" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>

                                    <Rectangle DockPanel.Dock="Left" Width="1" Fill="{DynamicResource BorderBrush}" Margin="0,4,12,4" />

                                    <!-- Zoom & Fit Controls -->
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PdfZoomOutBtn" Style="{StaticResource SecondaryButton}" Content="−" Padding="9,3" Margin="0,0,4,0" Click="PdfZoomOut_Click" ToolTip="Zoom out (-)" FontWeight="Bold" />
                                        <TextBlock x:Name="PdfZoomLevelText" Text="100%" Width="48" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                                        <Button x:Name="PdfZoomInBtn" Style="{StaticResource SecondaryButton}" Content="+" Padding="9,3" Margin="4,0,10,0" Click="PdfZoomIn_Click" ToolTip="Zoom in (+)" FontWeight="Bold" />

                                        <Button x:Name="PdfFitPageBtn" Style="{StaticResource SecondaryButton}" Content="Fit Page" Padding="8,4" Margin="0,0,4,0" Click="PdfFitPage_Click" ToolTip="Fit entire page in window" FontSize="11" />
                                        <Button x:Name="PdfFitWidthBtn" Style="{StaticResource SecondaryButton}" Content="Fit Width" Padding="8,4" Margin="0,0,0,0" Click="PdfFitWidth_Click" ToolTip="Fit page to window width" FontSize="11" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Viewport ScrollViewer -->
                            <ScrollViewer Grid.Row="1" x:Name="PdfPreviewScrollViewer"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          Background="#080C14" SizeChanged="PdfPreviewScrollViewer_SizeChanged">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                    <!-- Paper Sheet Card -->
                                    <Border x:Name="PdfPageContainer" Background="White"
                                            BorderBrush="#334155" BorderThickness="1" CornerRadius="3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.5" />
                                        </Border.Effect>
                                        <Image x:Name="PdfPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <!-- Loading Overlay -->
                            <Border Grid.Row="1" x:Name="PdfPreviewLoadingOverlay" Background="#99080C14" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar Width="120" Height="4" IsIndeterminate="True" Foreground="{DynamicResource AccentGradient}" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,0,10" />
                                    <TextBlock Text="Rendering page…" Foreground="{DynamicResource TextBrush}" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Error Overlay -->
                            <Border Grid.Row="1" x:Name="PdfPreviewErrorOverlay" Background="#F0080C14" Visibility="Collapsed" Padding="32">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource DangerSoftBrush}" Margin="0,0,0,14" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconAlertGeometry}" Fill="{DynamicResource DangerBrush}" Width="26" Height="26" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock x:Name="PdfPreviewErrorTitle" Text="Preview Unavailable" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8" />
                                    <TextBlock x:Name="PdfPreviewErrorMessage" Style="{StaticResource MutedText}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Return to Workspace" Click="ClosePreview_Click" HorizontalAlignment="Center" Padding="14,6" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Grid Splitter -->
                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- ========================================== -->
                <!-- COLUMN 4: RIGHT ACTION DETAILS & RESULTS   -->
                <!-- ========================================== -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- No Action Selected View -->
                            <Border x:Name="NoActionPlaceholder" Visibility="Visible" Margin="0,20"
                                    Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="20,24">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="8,3" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <TextBlock Text="CONFIGURATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock Text="Action Settings" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="Select an action from the deck or press keys 1–7 to configure parameters."
                                               Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </Border>

                            <!-- Action Selected Configuration Panel -->
                            <StackPanel x:Name="ActionConfigPanel" Visibility="Collapsed">
                                <!-- Action Header Title & Badges -->
                                <DockPanel Margin="0,0,0,6">
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource OkSoftBrush}" x:Name="ActionAvailabilityBadge"
                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="ActionAvailabilityText" Text="Available" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" />
                                    </Border>
                                    <TextBlock x:Name="ActionTitleText" Text="Compress Image" FontSize="16" FontWeight="Bold" />
                                </DockPanel>

                                <TextBlock x:Name="ActionGoalText" Text="Reduce image size for uploading" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,6" />
                                <TextBlock x:Name="ActionDescText" Style="{StaticResource MutedText}" Margin="0,0,0,14" />

                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,14" />

                                <!-- ========================================== -->
                                <!-- Dynamic Options Container                  -->
                                <!-- ========================================== -->
                                <StackPanel x:Name="OptionsContainer" Margin="0,0,0,16">
                                    <!-- Compress Image Options View -->
                                    <StackPanel x:Name="CompressOptionsView" Visibility="Collapsed">
                                        <TextBlock Text="Compression Quality" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="CompressQualitySlider" Grid.Column="0" Minimum="1" Maximum="100" Value="80"
                                                    ValueChanged="CompressQualitySlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox x:Name="CompressQualityBox" Grid.Column="1" Text="80" TextAlignment="Center"
                                                     TextChanged="CompressQualityBox_TextChanged" />
                                        </Grid>

                                        <!-- Format explanatory note -->
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                                            <TextBlock x:Name="CompressFormatNote" Style="{StaticResource MutedText}" FontSize="11" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Convert to WebP Options View -->
                                    <StackPanel x:Name="WebpOptionsView" Visibility="Collapsed">
                                        <TextBlock Text="WebP Quality" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="WebpQualitySlider" Grid.Column="0" Minimum="1" Maximum="100" Value="80"
                                                    ValueChanged="WebpQualitySlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox x:Name="WebpQualityBox" Grid.Column="1" Text="80" TextAlignment="Center"
                                                     TextChanged="WebpQualityBox_TextChanged" />
                                        </Grid>

                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10">
                                            <TextBlock Text="Converts to modern WebP. Full alpha transparency is preserved. Setting quality to 100 activates lossless WebP mode."
                                                       Style="{StaticResource MutedText}" FontSize="11" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Resize Options View -->
                                    <StackPanel x:Name="ResizeOptionsView" Visibility="Collapsed">
                                        <TextBlock Text="Target Dimensions" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Width (px)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBox x:Name="ResizeWidthBox" Text="1920" TextChanged="ResizeWidthBox_TextChanged" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="×" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Height (px)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBox x:Name="ResizeHeightBox" Text="1080" />
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox x:Name="ResizeKeepAspectCheck" Content="Keep aspect ratio" IsChecked="True"
                                                  Checked="ResizeKeepAspectCheck_Changed" Unchecked="ResizeKeepAspectCheck_Changed" Margin="0,0,0,10" />

                                        <!-- Quick Resize Presets -->
                                        <TextBlock Text="Quick Presets" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button Style="{StaticResource SecondaryButton}" Content="25%" Padding="8,4" Margin="0,0,6,4" Click="Preset25_Click" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="50%" Padding="8,4" Margin="0,0,6,4" Click="Preset50_Click" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="75%" Padding="8,4" Margin="0,0,6,4" Click="Preset75_Click" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="1080p" Padding="8,4" Margin="0,0,6,4" Click="Preset1080p_Click" />
                                            <Button Style="{StaticResource SecondaryButton}" Content="720p" Padding="8,4" Margin="0,0,6,4" Click="Preset720p_Click" />
                                        </WrapPanel>

                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                            <TextBlock Text="Max dimension 8,192 px per side (40 MP max). Uses Mitchell cubic resampling for high-fidelity scaling."
                                                       Style="{StaticResource MutedText}" FontSize="11" />
                                        </Border>

                                        <Button x:Name="OpenEditorFromResizeBtn" Style="{StaticResource SecondaryButton}" Click="OpenEditorFromResize_Click" Padding="12,7" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconCropGeometry}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="Open in Interactive Editor" FontWeight="SemiBold" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Strip Metadata Options View -->
                                    <StackPanel x:Name="MetadataOptionsView" Visibility="Collapsed">
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="Privacy Metadata Removal" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <TextBlock Text="• Removes EXIF camera &amp; lens parameters" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="• Removes GPS geographical coordinates" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="• Removes Adobe XMP metadata chunks" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="• Applies EXIF orientation to image pixels first so the image remains upright" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="• Re-encodes clean pixel buffer without device signatures" Style="{StaticResource MutedText}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Edit Image Options View -->
                                    <StackPanel x:Name="EditImageOptionsView" Visibility="Collapsed">
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Interactive Image Studio" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />
                                                <TextBlock Text="Crop, rotate, flip, and resize in an interactive canvas with instant visual feedback."
                                                           Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                <TextBlock Text="• Interactive crop rectangle with aspect-ratio locking (Free, 1:1, 4:3, 16:9, Original)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="• 90° Clockwise &amp; Counterclockwise rotation and flipping" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="• Dimension-accurate Mitchell cubic resampling" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="• Non-destructive in-memory workflow with Reset All" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="• Collision-safe export following SmartShift output policy" Style="{StaticResource MutedText}" FontSize="11" />
                                            </StackPanel>
                                        </Border>

                                        <Button x:Name="OpenEditorFromRightPanelBtn" Style="{StaticResource PrimaryButton}" Click="OpenEditorFromRightPanel_Click" Padding="14,9" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconCropGeometry}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                                                <TextBlock Text="Open Interactive Editor" FontWeight="Bold" FontSize="12.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- File Information Options View -->
                                    <StackPanel x:Name="InfoOptionsView" Visibility="Collapsed">
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Format:" Style="{StaticResource MutedText}" Margin="0,0,10,4" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoFormatText" FontWeight="SemiBold" Margin="0,0,0,4" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Dimensions:" Style="{StaticResource MutedText}" Margin="0,0,10,4" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoDimensionsText" Margin="0,0,0,4" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="File Size:" Style="{StaticResource MutedText}" Margin="0,0,10,4" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoSizeText" Margin="0,0,0,4" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Modified:" Style="{StaticResource MutedText}" Margin="0,0,10,4" />
                                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoModifiedText" Style="{StaticResource MutedText}" Margin="0,0,0,4" />

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:" Style="{StaticResource MutedText}" />
                                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InfoStatusText" Style="{StaticResource MutedText}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- PDF Compression Options View -->
                                    <StackPanel x:Name="PdfCompressOptionsView" Visibility="Collapsed">
                                        <TextBlock Text="Target Output Size" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="Set a desired goal for the compressed document. SmartShift preserves full layout, text, and vector graphics."
                                                   Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,8" TextWrapping="Wrap" />

                                        <!-- Target Size Presets -->
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button x:Name="PdfPreset500Kb" Style="{StaticResource SecondaryButton}" Content="500 KB" Padding="8,4" Margin="0,0,6,4" Click="PdfPreset500Kb_Click" />
                                            <Button x:Name="PdfPreset1Mb" Style="{StaticResource PrimaryButton}" Content="1 MB" Padding="8,4" Margin="0,0,6,4" Click="PdfPreset1Mb_Click" />
                                            <Button x:Name="PdfPreset2Mb" Style="{StaticResource SecondaryButton}" Content="2 MB" Padding="8,4" Margin="0,0,6,4" Click="PdfPreset2Mb_Click" />
                                            <Button x:Name="PdfPreset5Mb" Style="{StaticResource SecondaryButton}" Content="5 MB" Padding="8,4" Margin="0,0,6,4" Click="PdfPreset5Mb_Click" />
                                            <Button x:Name="PdfPresetCustom" Style="{StaticResource SecondaryButton}" Content="Custom" Padding="8,4" Margin="0,0,6,4" Click="PdfPresetCustom_Click" />
                                        </WrapPanel>

                                        <!-- Custom Target Size Input -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="PdfTargetSizeBox" Text="1" TextChanged="PdfTargetSizeBox_TextChanged" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="PdfUnitMbBtn" Style="{StaticResource PrimaryButton}" Content="MB" Padding="12,6" Margin="0,0,4,0" Click="PdfUnitMb_Click" />
                                                <Button x:Name="PdfUnitKbBtn" Style="{StaticResource SecondaryButton}" Content="KB" Padding="12,6" Click="PdfUnitKb_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="PdfTargetValidationHint" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12" Text="Target goal: 1.0 MB (1,048,576 bytes)" />

                                        <!-- Embedded Image Optimization Policy -->
                                        <TextBlock Text="Embedded Image Optimization" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="Applied only if lossless compression alone cannot reach the target size."
                                                   Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,0,0,12">
                                            <Button x:Name="PdfQualityBalancedBtn" Style="{StaticResource PrimaryButton}" Content="Balanced" Padding="8,4" Margin="0,0,6,4" Click="PdfQuality_Click" Tag="balanced" ToolTip="JPEG 75, max 1600px. Recommended balance of clarity and file size." />
                                            <Button x:Name="PdfQualityBestBtn" Style="{StaticResource SecondaryButton}" Content="Best Quality" Padding="8,4" Margin="0,0,6,4" Click="PdfQuality_Click" Tag="best" ToolTip="JPEG 85, max 2048px. Conservative compression preserving fine details." />
                                            <Button x:Name="PdfQualitySmallestBtn" Style="{StaticResource SecondaryButton}" Content="Smallest File" Padding="8,4" Margin="0,0,6,4" Click="PdfQuality_Click" Tag="smallest" ToolTip="JPEG 60, max 1200px. Aggressive compression for strict limits." />
                                            <Button x:Name="PdfQualityOffBtn" Style="{StaticResource SecondaryButton}" Content="Lossless Only" Padding="8,4" Margin="0,0,6,4" Click="PdfQuality_Click" Tag="off" ToolTip="Lossless stream compression only; embedded raster images remain untouched." />
                                        </WrapPanel>

                                        <!-- Preservation Guarantees Card -->
                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Preservation Guarantees" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                                <TextBlock Text="✓ Selectable text and vector graphics preserved" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Embedded fonts, annotations, and bookmarks preserved" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Page counts and dimensions kept byte-accurate" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Non-destructive: original file is never overwritten" Style="{StaticResource MutedText}" FontSize="11" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Note: Target size is a goal. SmartShift never corrupts or rasterizes text to force a file under size."
                                                   Style="{StaticResource MutedText}" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    </StackPanel>

                                    <!-- PDF Page Export Options View -->
                                    <StackPanel x:Name="PdfExportOptionsView" Visibility="Collapsed">
                                        <TextBlock Text="Target Image Format" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button x:Name="PdfExportPngBtn" Style="{StaticResource PrimaryButton}" Content="PNG" Padding="14,5" Margin="0,0,6,4" Click="PdfExportFormat_Click" Tag="png" ToolTip="Lossless PNG. Preserves crisp text, charts, and clean line art." />
                                            <Button x:Name="PdfExportJpegBtn" Style="{StaticResource SecondaryButton}" Content="JPEG" Padding="14,5" Margin="0,0,6,4" Click="PdfExportFormat_Click" Tag="jpeg" ToolTip="Standard JPEG with white background compositing. Smaller file size." />
                                        </WrapPanel>

                                        <!-- JPEG Quality Slider (shown only when JPEG selected) -->
                                        <StackPanel x:Name="PdfExportQualityHost" Visibility="Collapsed" Margin="0,0,0,10">
                                            <TextBlock Text="JPEG Quality" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="PdfExportQualitySlider" Grid.Column="0" Minimum="1" Maximum="100" Value="85"
                                                        ValueChanged="PdfExportQualitySlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox x:Name="PdfExportQualityBox" Grid.Column="1" Text="85" TextAlignment="Center"
                                                         TextChanged="PdfExportQualityBox_TextChanged" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Resolution / DPI Selection -->
                                        <TextBlock Text="Render Resolution" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="Resolution controls raster pixel density per page." Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6" />
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button x:Name="PdfExportDpi100Btn" Style="{StaticResource SecondaryButton}" Content="100 DPI" Padding="10,5" Margin="0,0,6,4" Click="PdfExportDpi_Click" Tag="100" ToolTip="Screen reading, quick thumbnails (~827 × 1169 px for A4)" />
                                            <Button x:Name="PdfExportDpi150Btn" Style="{StaticResource PrimaryButton}" Content="150 DPI" Padding="10,5" Margin="0,0,6,4" Click="PdfExportDpi_Click" Tag="150" ToolTip="Standard viewing and presentations (~1240 × 1754 px for A4)" />
                                            <Button x:Name="PdfExportDpi300Btn" Style="{StaticResource SecondaryButton}" Content="300 DPI" Padding="10,5" Margin="0,0,6,4" Click="PdfExportDpi_Click" Tag="300" ToolTip="High-resolution print and publication (~2480 × 3508 px for A4)" />
                                        </WrapPanel>

                                        <!-- Page Range Selection -->
                                        <TextBlock Text="Page Range" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox x:Name="PdfExportRangeBox" Text="all" TextChanged="PdfExportRangeBox_TextChanged" Margin="0,0,0,4" />
                                        <TextBlock x:Name="PdfExportRangeHint" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,10"
                                                   Text="Specify 'all', a single page (e.g. 1), or ranges (e.g. 1-5, 8)." />

                                        <!-- High Page / Resolution Warning Text -->
                                        <TextBlock x:Name="PdfExportWarningText" Foreground="{DynamicResource WarnBrush}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" Visibility="Collapsed" />

                                        <!-- Quality Guarantee Card -->
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="Local PDFium Rendering" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,3" />
                                                <TextBlock Text="• Fully private local rendering without cloud upload" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,2" />
                                                <TextBlock Text="• Transparent page backgrounds cleanly composited onto solid white for JPEG" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,2" />
                                                <TextBlock Text="• Preserves original document SHA-256 untouched" Style="{StaticResource MutedText}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- PDF Text Extraction Options View -->
                                    <StackPanel x:Name="PdfTextOptionsView" Visibility="Collapsed">
                                        <!-- Page Range Selection -->
                                        <TextBlock Text="Page Range" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox x:Name="PdfTextRangeBox" Text="all" TextChanged="PdfTextRangeBox_TextChanged" Margin="0,0,0,4" />
                                        <TextBlock x:Name="PdfTextRangeHint" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12"
                                                   Text="Specify 'all', a single page (e.g. 1), or ranges (e.g. 1-5, 8)." />

                                        <!-- Feature Guarantee Card -->
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="Text Extraction Guarantees" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />
                                                <TextBlock Text="✓ Extracted in natural document reading order" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Clean page separators (--- Page X ---) inserted" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ UTF-8 encoding with standard CRLF line breaks" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Honest reporting: detects scanned/empty documents without fabricating text" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Non-destructive: source PDF is strictly unmodified" Style="{StaticResource MutedText}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- PDF to Word (DOCX) Options View -->
                                    <StackPanel x:Name="PdfDocxOptionsView" Visibility="Collapsed">
                                        <TextBlock Text="Word Document Conversion" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="Converts PDF into a standard editable Microsoft Word (.docx) document."
                                                   Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,8" TextWrapping="Wrap" />

                                        <!-- Page Range Selection -->
                                        <TextBlock Text="Page Range" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox x:Name="PdfDocxRangeBox" Text="all" TextChanged="PdfDocxRangeBox_TextChanged" Margin="0,0,0,4" />
                                        <TextBlock x:Name="PdfDocxRangeHint" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,10"
                                                   Text="Specify 'all', a single page (e.g. 1), or ranges (e.g. 1-5, 8)." />

                                        <!-- Conversion Fidelity & Limitation Notice Card -->
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="Word Conversion Guarantees" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />
                                                <TextBlock Text="✓ Reconstructs paragraphs, text lines, font metrics, and bold/italic styles" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Extracts and embeds embedded raster figures into Word body" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Generates valid Office Open XML (.docx) conforming to ISO/IEC 29500" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="• Scanned/image-only PDFs are preserved as high-fidelity full-page images (OCR required for text editing)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Non-destructive: source PDF is byte-for-byte unchanged" Style="{StaticResource MutedText}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- PDF to PowerPoint (PPTX) Options View -->
                                    <StackPanel x:Name="PdfPptxOptionsView" Visibility="Collapsed">
                                        <TextBlock Text="PowerPoint Slide Mode" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="Choose how slides are generated from your PDF pages:"
                                                   Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,8" TextWrapping="Wrap" />

                                        <!-- Mode Toggle Buttons -->
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button x:Name="PdfPptxModeImageBtn" Style="{StaticResource PrimaryButton}" Content="Page-as-Image (Visual Layout)"
                                                    Padding="12,5" Margin="0,0,6,4" Click="PdfPptxMode_Click" Tag="pageAsImage"
                                                    ToolTip="Renders each page as a pixel-accurate slide image. Preserves exact layout, complex vector art, and graphics." />
                                            <Button x:Name="PdfPptxModeEditableBtn" Style="{StaticResource SecondaryButton}" Content="Editable (Text &amp; Shapes)"
                                                    Padding="12,5" Margin="0,0,6,4" Click="PdfPptxMode_Click" Tag="editable"
                                                    ToolTip="Reconstructs text boxes and picture shapes as editable PowerPoint elements. Layout fidelity may vary from original PDF." />
                                        </WrapPanel>

                                        <!-- Mode Description Card -->
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                            <TextBlock x:Name="PdfPptxModeExplanation" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"
                                                       Text="Page-as-Image: Best for presentations, brochures, and visual fidelity. Each slide is an exact high-resolution rendering of the original PDF page." />
                                        </Border>

                                        <!-- Page Range Selection -->
                                        <TextBlock Text="Page Range" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                        <TextBox x:Name="PdfPptxRangeBox" Text="all" TextChanged="PdfPptxRangeBox_TextChanged" Margin="0,0,0,4" />
                                        <TextBlock x:Name="PdfPptxRangeHint" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,10"
                                                   Text="Specify 'all', a single page (e.g. 1), or ranges (e.g. 1-5, 8)." />

                                        <!-- Guarantees Card -->
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="PowerPoint Conversion Guarantees" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />
                                                <TextBlock Text="✓ Generates 100% conforming Office Open XML (.pptx) presentation" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Preserves page order and verifies slide count against input" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Adapts slide dimensions to match PDF aspect ratio" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Non-destructive: source PDF is byte-for-byte unchanged" Style="{StaticResource MutedText}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- PDF Preview Options View -->
                                    <StackPanel x:Name="PdfPreviewOptionsView" Visibility="Collapsed">
                                        <TextBlock Text="Native Document Preview" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                        <TextBlock Text="Inspect and review PDF pages locally with instant vector-grade rendering."
                                                   Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,10" TextWrapping="Wrap" />

                                        <Button x:Name="PdfOpenPreviewBtn" Style="{StaticResource PrimaryButton}" Content="Open Preview Viewer"
                                                Padding="14,7" Margin="0,0,0,12" Click="PdfOpenPreview_Click" HorizontalAlignment="Stretch" />

                                        <!-- Document Metrics Card -->
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Document Properties" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,8" />
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="Page Count" Style="{StaticResource MutedText}" FontSize="11" />
                                                    <TextBlock x:Name="PdfPreviewDocPagesText" Text="—" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="Page Dimensions" Style="{StaticResource MutedText}" FontSize="11" />
                                                    <TextBlock x:Name="PdfPreviewDocDimsText" Text="—" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="Security" Style="{StaticResource MutedText}" FontSize="11" />
                                                    <TextBlock x:Name="PdfPreviewDocSecurityText" Text="None (Standard)" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OkBrush}" />
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock Text="Active Zoom" Style="{StaticResource MutedText}" FontSize="11" />
                                                    <TextBlock x:Name="PdfPreviewDocZoomText" Text="100%" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Privacy & Security Guarantees Card -->
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="Preview Architecture Guarantees" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />
                                                <TextBlock Text="✓ Local PDFium in-memory rendering without cloud upload" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Non-blocking background worker with serialized native handle" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ High-DPI dynamic supersampling with smooth scaling" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Zero temporary files: strictly read-only source access" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                                                <TextBlock Text="✓ Source SHA-256 integrity remains guaranteed untouched" Style="{StaticResource MutedText}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Validation Error Text -->
                                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}"
                                           TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,10" Visibility="Collapsed" />

                                <!-- Progress Bar and Progress Text -->
                                <StackPanel x:Name="ProgressHost" Visibility="Collapsed" Margin="0,0,0,12">
                                    <ProgressBar x:Name="ProgressBarCtrl" Height="4" IsIndeterminate="True"
                                                 Foreground="{DynamicResource AccentGradient}" Background="{DynamicResource SurfaceAltBrush}"
                                                 BorderThickness="0" Margin="0,0,0,6" />
                                    <TextBlock x:Name="ProgressText" Text="Processing…" Style="{StaticResource MutedText}" FontSize="11" />
                                </StackPanel>

                                <!-- Action Execution Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Click="RunAction_Click">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconPlayGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                    <AccessText Text="Run Action" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Click="CancelAction_Click">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <AccessText Text="Cancel" />
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </StackPanel>

                                <!-- ========================================== -->
                                <!-- RESULT AREA                                -->
                                <!-- ========================================== -->
                                <StackPanel x:Name="ResultCardHost" Visibility="Collapsed">
                                    <!-- Success Card -->
                                    <Border x:Name="SuccessResultCard" Background="{DynamicResource OkBgBrush}"
                                            BorderBrush="{DynamicResource OkBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Border x:Name="ResultBadgeBorder" Background="{DynamicResource OkSoftBrush}" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right">
                                                    <TextBlock x:Name="ResultBadgeText" Text="SUCCESS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" />
                                                </Border>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path x:Name="ResultStatusIcon" Data="{StaticResource IconCheckGeometry}" Fill="{DynamicResource OkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                                    <TextBlock x:Name="ResultStatusTitle" Text="Operation Complete" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" />
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- Size Difference Comparison Block -->
                                            <Border x:Name="SizeComparisonBlock" Background="#16382E" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Size Comparison" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="ResultOrigSize" Text="2.4 MB" FontWeight="SemiBold" FontSize="13" />
                                                            <TextBlock Text=" → " Foreground="{DynamicResource MutedBrush}" />
                                                            <TextBlock x:Name="ResultOutputSize" Text="850 KB" FontWeight="Bold" FontSize="13" Foreground="White" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" x:Name="DeltaBadgeBorder" Background="{DynamicResource OkSoftBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                        <TextBlock x:Name="ResultDeltaText" Text="-65.0%" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OkBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Target & Diagnostics Panel -->
                                            <Border x:Name="TargetDiagnosticsBox" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock x:Name="TargetGoalLine" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,3" />
                                                    <TextBlock x:Name="TargetDiagnosticLine" Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Dimensions & Specs -->
                                            <TextBlock x:Name="ResultDimensionsLine" Text="1920 × 1080 px · JPEG" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                                            <TextBlock x:Name="ResultNotesLine" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,8" />

                                            <!-- Original File Preserved Confirmation -->
                                            <TextBlock Text="✓ Original file remains byte-for-byte untouched on disk" FontSize="10.5" Foreground="{DynamicResource OkBrush}" Margin="0,0,0,12" />

                                            <!-- Open and Locate Action Buttons -->
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource SuccessButton}" Content="Open file" Click="OpenFile_Click" Margin="0,0,8,0">
                                                    <Button.ContentTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource IconEyeGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                                <AccessText Text="Open file" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </Button.ContentTemplate>
                                                </Button>

                                                <Button Style="{StaticResource SecondaryButton}" Content="Show in folder" Click="RevealResult_Click">
                                                    <Button.ContentTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource IconFolderGeometry}" Fill="{DynamicResource MutedBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                                <AccessText Text="Show in folder" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </Button.ContentTemplate>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Failure / Cancelled Result Card -->
                                    <Border x:Name="ErrorResultCard" Background="{DynamicResource DangerBgBrush}"
                                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="14" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="ErrorResultTitle" Text="Operation Failed" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4" />
                                            <TextBlock x:Name="ErrorResultDetail" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,8" />
                                            <TextBlock Text="The original file was not modified." FontSize="10.5" Foreground="{DynamicResource SubtleBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ==================================================== -->
                <!-- FULL WORKSPACE IMAGE EDITOR STUDIO OVERLAY           -->
                <!-- ==================================================== -->
                <Grid Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="100" x:Name="ImageEditorHost" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Top Editor Toolbar -->
                                <RowDefinition Height="Auto" />
                                <!-- Main Workspace (Tools Sidebar + Center Canvas) -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Toolbar -->
                            <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="14,10">
                                <DockPanel LastChildFill="True">
                                    <!-- Close / Cancel Editor Button -->
                                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="CloseImageEditor_Click"
                                            Padding="10,6" Margin="0,0,12,0" ToolTip="Discard unapplied edits and return to workspace (Esc)">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource TextBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Close Editor" FontWeight="SemiBold" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Reset All Edits Button -->
                                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="EditorResetAll_Click"
                                            Padding="10,6" Margin="0,0,12,0" ToolTip="Reset all edits back to original image">
                                        <TextBlock Text="Reset All" FontWeight="SemiBold" FontSize="11.5" />
                                    </Button>

                                    <!-- Save / Export Result Button -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="EditorSaveExport_Click"
                                            Padding="16,7" Margin="10,0,0,0" ToolTip="Apply edits and save to SmartShift output directory">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCheckGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Save Image" FontWeight="Bold" FontSize="12" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Status / File info & Dimensions badges -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Path Data="{StaticResource IconCropGeometry}" Fill="{DynamicResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" />
                                        <TextBlock Text="Image Editor" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />

                                        <TextBlock x:Name="EditorHeaderFileNameText" Text="" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                   MaxWidth="320" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" />

                                        <Border x:Name="EditorHeaderFormatBadgeBorder" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="EditorHeaderFormatBadge" Text="PNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>

                                        <Border Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Dimensions:" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,5,0" />
                                                <TextBlock x:Name="EditorCurrentDimensionsText" Text="1920 × 1080 px" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Main Workspace: Left Controls Sidebar + Center Crop Canvas -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <!-- Controls Sidebar: 280px wide for clean, spacious editing controls -->
                                    <ColumnDefinition Width="280" />
                                    <!-- Center Canvas Viewport: Expansive workspace filling all remaining room -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Controls Sidebar -->
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,1,0" Padding="16,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- ================= CROP SECTION ================= -->
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                <TextBlock Text="CROP &amp; RATIO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="Aspect Ratio" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button x:Name="EditorAspectFreeBtn" Style="{StaticResource PrimaryButton}" Content="Free" Padding="8,4" Margin="0,0,4,4" Click="EditorAspect_Click" Tag="free" FontSize="11" />
                                                <Button x:Name="EditorAspectOriginalBtn" Style="{StaticResource SecondaryButton}" Content="Original" Padding="8,4" Margin="0,0,4,4" Click="EditorAspect_Click" Tag="original" FontSize="11" />
                                                <Button x:Name="EditorAspect1x1Btn" Style="{StaticResource SecondaryButton}" Content="1:1" Padding="8,4" Margin="0,0,4,4" Click="EditorAspect_Click" Tag="1:1" FontSize="11" />
                                                <Button x:Name="EditorAspect4x3Btn" Style="{StaticResource SecondaryButton}" Content="4:3" Padding="8,4" Margin="0,0,4,4" Click="EditorAspect_Click" Tag="4:3" FontSize="11" />
                                                <Button x:Name="EditorAspect16x9Btn" Style="{StaticResource SecondaryButton}" Content="16:9" Padding="8,4" Margin="0,0,4,4" Click="EditorAspect_Click" Tag="16:9" FontSize="11" />
                                            </WrapPanel>

                                            <!-- Crop Dimensions Indicator -->
                                            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="Selection (pixels):" Style="{StaticResource MutedText}" FontSize="10.5" />
                                                    <TextBlock x:Name="EditorCropDimensionsText" Text="Full Image" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Crop Action Buttons -->
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" x:Name="EditorApplyCropBtn" Style="{StaticResource PrimaryButton}" Content="Apply Crop" Padding="8,6" Click="EditorApplyCrop_Click" FontSize="11.5" FontWeight="SemiBold" />
                                                <Button Grid.Column="2" x:Name="EditorResetCropSelectionBtn" Style="{StaticResource SecondaryButton}" Content="Reset Box" Padding="8,6" Click="EditorResetCropSelection_Click" FontSize="11.5" />
                                            </Grid>

                                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,14" />

                                            <!-- ================= ROTATE & FLIP SECTION ================= -->
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                <TextBlock Text="ROTATE &amp; FLIP" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="Orientation" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" x:Name="EditorRotateCcwBtn" Style="{StaticResource SecondaryButton}" Padding="4,7" Click="EditorRotateCcw_Click" ToolTip="Rotate 90° CCW">
                                                    <Path Data="{StaticResource IconRotateCcwGeometry}" Fill="{DynamicResource TextBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                </Button>
                                                <Button Grid.Column="2" x:Name="EditorRotateCwBtn" Style="{StaticResource SecondaryButton}" Padding="4,7" Click="EditorRotateCw_Click" ToolTip="Rotate 90° CW">
                                                    <Path Data="{StaticResource IconRotateCwGeometry}" Fill="{DynamicResource TextBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                </Button>
                                                <Button Grid.Column="4" x:Name="EditorFlipHBtn" Style="{StaticResource SecondaryButton}" Padding="4,7" Click="EditorFlipH_Click" ToolTip="Flip Horizontally">
                                                    <Path Data="{StaticResource IconFlipHGeometry}" Fill="{DynamicResource TextBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                </Button>
                                                <Button Grid.Column="6" x:Name="EditorFlipVBtn" Style="{StaticResource SecondaryButton}" Padding="4,7" Click="EditorFlipV_Click" ToolTip="Flip Vertically">
                                                    <Path Data="{StaticResource IconFlipVGeometry}" Fill="{DynamicResource TextBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                </Button>
                                            </Grid>

                                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,14" />

                                            <!-- ================= RESIZE SECTION ================= -->
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                <TextBlock Text="RESIZE IMAGE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="Target Dimensions" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Width (px)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                                                    <TextBox x:Name="EditorResizeWidthBox" Text="1920" TextChanged="EditorResizeWidthBox_TextChanged" FontSize="11.5" Padding="6,4" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="×" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6" FontSize="12" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Height (px)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                                                    <TextBox x:Name="EditorResizeHeightBox" Text="1080" TextChanged="EditorResizeHeightBox_TextChanged" FontSize="11.5" Padding="6,4" />
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox x:Name="EditorResizeLockAspectCheck" Content="Lock aspect ratio" IsChecked="True"
                                                      Checked="EditorResizeLockAspectCheck_Changed" Unchecked="EditorResizeLockAspectCheck_Changed"
                                                      FontSize="11.5" Margin="0,0,0,10" />

                                            <TextBlock Text="Scale Presets" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,5" />
                                            <WrapPanel Margin="0,0,0,8">
                                                <Button Style="{StaticResource SecondaryButton}" Content="25%" Padding="6,3" Margin="0,0,4,4" Click="EditorPreset25_Click" FontSize="11" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="50%" Padding="6,3" Margin="0,0,4,4" Click="EditorPreset50_Click" FontSize="11" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="75%" Padding="6,3" Margin="0,0,4,4" Click="EditorPreset75_Click" FontSize="11" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="720px" Padding="6,3" Margin="0,0,4,4" Click="EditorPreset720_Click" FontSize="11" ToolTip="Scale longest edge to 720px" />
                                                <Button Style="{StaticResource SecondaryButton}" Content="1080px" Padding="6,3" Margin="0,0,4,4" Click="EditorPreset1080_Click" FontSize="11" ToolTip="Scale longest edge to 1080px" />
                                            </WrapPanel>

                                            <TextBlock x:Name="EditorResizeValidationText" Text="" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" />

                                            <Button x:Name="EditorApplyResizeBtn" Style="{StaticResource PrimaryButton}" Content="Apply Resize" Padding="10,6" Click="EditorApplyResize_Click" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,14" />

                                            <!-- Workflow Hint Card -->
                                            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                                <TextBlock Text="Edits stay non-destructive in memory until you click 'Save Image'. Original file is never overwritten."
                                                           Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" LineHeight="15" />
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>

                                <!-- Center Canvas Viewport: Expansive Canvas -->
                                <Canvas Grid.Column="1" x:Name="EditorViewportCanvas" Background="#080C14" ClipToBounds="True"
                                        SizeChanged="EditorViewportCanvas_SizeChanged"
                                        MouseDown="EditorViewportCanvas_MouseDown"
                                        MouseMove="EditorViewportCanvas_MouseMove"
                                        MouseUp="EditorViewportCanvas_MouseUp"
                                        MouseLeave="EditorViewportCanvas_MouseLeave">

                                    <!-- Center Image Element -->
                                    <Image x:Name="EditorPreviewImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" />

                                    <!-- Exclusion Mask: 4 semi-transparent black overlays -->
                                    <Rectangle x:Name="CropMaskTop" Fill="#A0000000" IsHitTestVisible="False" />
                                    <Rectangle x:Name="CropMaskBottom" Fill="#A0000000" IsHitTestVisible="False" />
                                    <Rectangle x:Name="CropMaskLeft" Fill="#A0000000" IsHitTestVisible="False" />
                                    <Rectangle x:Name="CropMaskRight" Fill="#A0000000" IsHitTestVisible="False" />

                                    <!-- Selected Crop Box -->
                                    <Border x:Name="CropSelectionBox" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                            Background="#0DFFFFFF" Cursor="SizeAll">
                                        <!-- Golden Grid Rule of Thirds Lines -->
                                        <Grid IsHitTestVisible="False" Opacity="0.35">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#FDE68A" BorderThickness="0,0,0,1" />
                                            <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#FDE68A" BorderThickness="0,0,0,1" />
                                            <Border Grid.RowSpan="3" Grid.Column="0" BorderBrush="#FDE68A" BorderThickness="0,0,1,0" />
                                            <Border Grid.RowSpan="3" Grid.Column="1" BorderBrush="#FDE68A" BorderThickness="0,0,1,0" />
                                        </Grid>
                                    </Border>

                                    <!-- 8 Resize Handles -->
                                    <Border x:Name="HandleTopLeft" Width="10" Height="10" CornerRadius="2" Background="#EA580C" BorderBrush="White" BorderThickness="1.5" Cursor="SizeNWSE" />
                                    <Border x:Name="HandleTop" Width="10" Height="10" CornerRadius="2" Background="#EA580C" BorderBrush="White" BorderThickness="1.5" Cursor="SizeNS" />
                                    <Border x:Name="HandleTopRight" Width="10" Height="10" CornerRadius="2" Background="#EA580C" BorderBrush="White" BorderThickness="1.5" Cursor="SizeNESW" />
                                    <Border x:Name="HandleRight" Width="10" Height="10" CornerRadius="2" Background="#EA580C" BorderBrush="White" BorderThickness="1.5" Cursor="SizeWE" />
                                    <Border x:Name="HandleBottomRight" Width="10" Height="10" CornerRadius="2" Background="#EA580C" BorderBrush="White" BorderThickness="1.5" Cursor="SizeNWSE" />
                                    <Border x:Name="HandleBottom" Width="10" Height="10" CornerRadius="2" Background="#EA580C" BorderBrush="White" BorderThickness="1.5" Cursor="SizeNS" />
                                    <Border x:Name="HandleBottomLeft" Width="10" Height="10" CornerRadius="2" Background="#EA580C" BorderBrush="White" BorderThickness="1.5" Cursor="SizeNESW" />
                                    <Border x:Name="HandleLeft" Width="10" Height="10" CornerRadius="2" Background="#EA580C" BorderBrush="White" BorderThickness="1.5" Cursor="SizeWE" />

                                    <!-- Floating Dimensions Capsule -->
                                    <Border x:Name="CropDimensionsBadge" Background="#E6080C14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="8,3" IsHitTestVisible="False">
                                        <TextBlock x:Name="CropBadgeText" Text="1280 × 720 px" Foreground="#FDE68A" FontSize="10.5" FontWeight="Bold" />
                                    </Border>

                                    <!-- Loading / Processing Overlay -->
                                    <Border x:Name="EditorProcessingOverlay" Background="#B3080C14" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ProgressBar Width="120" Height="4" IsIndeterminate="True" Foreground="{DynamicResource AccentGradient}" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,0,10" />
                                            <TextBlock x:Name="EditorProcessingText" Text="Processing…" Foreground="{DynamicResource TextBrush}" FontSize="12" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================================================== -->
                <!-- FULL WORKSPACE BATCH IMAGE PROCESSING STUDIO OVERLAY -->
                <!-- ==================================================== -->
                <Grid Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="95" x:Name="BatchStudioHost" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Top Studio Toolbar -->
                                <RowDefinition Height="Auto" />
                                <!-- Main Studio Workspace (Queue List + Settings & Results) -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Toolbar -->
                            <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="14,10">
                                <DockPanel LastChildFill="True">
                                    <!-- Back / Close Button -->
                                    <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="CloseBatchStudio_Click"
                                            Padding="10,6" Margin="0,0,14,0" ToolTip="Return to single-file workspace">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Workspace" FontWeight="SemiBold" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Right: Open Output Folder -->
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="OpenOutputs_Click"
                                            Padding="12,6" Margin="8,0,0,0" ToolTip="Open the SmartShift output directory in Windows Explorer">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconFolderGeometry}" Fill="{DynamicResource MutedBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Open Outputs" FontSize="11.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Center/Left info: Title & Queue badge -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconQueueGeometry}" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="Batch Image Studio" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />
                                        <Border x:Name="BatchStudioQueueCountBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="BatchStudioQueueCountText" Text="0 images" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Main Content: Left Queue List + Right Operations & Progress -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <!-- Left Queue Panel -->
                                    <ColumnDefinition Width="420" MinWidth="340" MaxWidth="520" />
                                    <!-- Splitter -->
                                    <ColumnDefinition Width="6" />
                                    <!-- Right Settings & Progress Panel -->
                                    <ColumnDefinition Width="*" MinWidth="450" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Batch File Queue -->
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,1,0" Padding="14">
                                    <DockPanel LastChildFill="True">
                                        <!-- Queue Subheader & Action Buttons -->
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Queued Images" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>

                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource PrimaryButton}" Click="BatchAddImages_Click" Padding="10,4" Margin="0,0,6,0"
                                                        ToolTip="Add JPEG, PNG, or WebP images to the batch queue">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlusGeometry}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" />
                                                        <TextBlock Text="Add Images" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Click="BatchClearQueue_Click" Padding="8,4"
                                                        ToolTip="Clear all files from the batch queue. Disk files are not deleted.">
                                                    <TextBlock Text="Clear" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Policy Cue -->
                                        <Border DockPanel.Dock="Top" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                                            <TextBlock Text="Supported: JPEG, PNG, WebP. Duplicates excluded. Originals are never modified."
                                                       Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" LineHeight="14" />
                                        </Border>

                                        <!-- Empty Queue Cue -->
                                        <Border x:Name="BatchEmptyQueuePlaceholder" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Center" Visibility="Collapsed">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Path Data="{StaticResource IconUploadGeometry}" Fill="{DynamicResource MutedBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,0,10" HorizontalAlignment="Center" />
                                                <TextBlock Text="No images in batch queue" FontWeight="SemiBold" FontSize="12.5" TextAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="Click '+ Add Images' or drop image files onto the window." Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <Button Style="{StaticResource PrimaryButton}" Content="Add Images" Click="BatchAddImages_Click" HorizontalAlignment="Center" Padding="14,6" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Batch Files ListBox -->
                                        <ListBox x:Name="BatchFileList" BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="BatchFileList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- File Information Block -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <Border Background="{Binding FormatTagBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding Extension}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource MutedText}" FontSize="10.5" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Status Pill -->
                                                            <Border Grid.Column="1" Background="{Binding StatusBackgroundBrush}" CornerRadius="5" Padding="7,2" Margin="6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="SemiBold" />
                                                            </Border>

                                                            <!-- Remove Button -->
                                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="4"
                                                                    Click="BatchRemoveItem_Click" Tag="{Binding}" ToolTip="Remove from batch queue">
                                                                <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="9" Height="9" Stretch="Uniform" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <!-- GridSplitter -->
                                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                                <!-- Column 2: Right Configuration & Operations Panel -->
                                <Border Grid.Column="2" Padding="18">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- Section: Operation Selection -->
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                <TextBlock Text="BATCH OPERATION" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="Select Operation for All Queued Images" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />

                                            <WrapPanel Margin="0,0,0,14">
                                                <Button x:Name="BatchOpCompressBtn" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="0,0,6,6"
                                                        Click="BatchOperationSelect_Click" Tag="image.compress">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconCompressGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="Compress" FontWeight="SemiBold" FontSize="11.5" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BatchOpConvertBtn" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,6,6"
                                                        Click="BatchOperationSelect_Click" Tag="image.convert">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconConvertGeometry}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="Convert Format" FontWeight="SemiBold" FontSize="11.5" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BatchOpResizeBtn" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,6,6"
                                                        Click="BatchOperationSelect_Click" Tag="image.resize">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconResizeGeometry}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="Resize" FontWeight="SemiBold" FontSize="11.5" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="BatchOpMetadataBtn" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,6,6"
                                                        Click="BatchOperationSelect_Click" Tag="image.metadata.strip">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconShieldGeometry}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="Remove Metadata" FontWeight="SemiBold" FontSize="11.5" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>

                                            <!-- Dynamic Settings Host -->
                                            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                                <StackPanel>
                                                    <!-- PANEL: COMPRESS -->
                                                    <StackPanel x:Name="BatchCompressSettingsPanel" Visibility="Visible">
                                                        <DockPanel Margin="0,0,0,8">
                                                            <TextBlock Text="Compression Quality" FontWeight="SemiBold" FontSize="12" />
                                                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2">
                                                                <TextBlock x:Name="BatchCompressQualityBadge" Text="80%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                        </DockPanel>
                                                        <Slider x:Name="BatchCompressQualitySlider" Minimum="1" Maximum="100" Value="80"
                                                                ValueChanged="BatchCompressQualitySlider_ValueChanged" Margin="0,0,0,8" />
                                                        <WrapPanel Margin="0,0,0,6">
                                                            <Button Style="{StaticResource SecondaryButton}" Content="Lossless (95%)" Padding="7,3" Margin="0,0,4,4" Click="BatchPreset_Click" Tag="95" FontSize="10.5" />
                                                            <Button Style="{StaticResource SecondaryButton}" Content="High (80%)" Padding="7,3" Margin="0,0,4,4" Click="BatchPreset_Click" Tag="80" FontSize="10.5" />
                                                            <Button Style="{StaticResource SecondaryButton}" Content="Medium (65%)" Padding="7,3" Margin="0,0,4,4" Click="BatchPreset_Click" Tag="65" FontSize="10.5" />
                                                            <Button Style="{StaticResource SecondaryButton}" Content="Compact (45%)" Padding="7,3" Margin="0,0,4,4" Click="BatchPreset_Click" Tag="45" FontSize="10.5" />
                                                        </WrapPanel>
                                                        <TextBlock Text="Re-encodes images at chosen quality level. PNG recompression uses lossless zlib filters." Style="{StaticResource MutedText}" FontSize="10.5" LineHeight="14" />
                                                    </StackPanel>

                                                    <!-- PANEL: CONVERT -->
                                                    <StackPanel x:Name="BatchConvertSettingsPanel" Visibility="Collapsed">
                                                        <TextBlock Text="Target Format" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <WrapPanel Margin="0,0,0,10">
                                                            <Button x:Name="BatchTargetWebpBtn" Style="{StaticResource PrimaryButton}" Content="WebP" Padding="12,5" Margin="0,0,6,4" Click="BatchTargetFormat_Click" Tag="webp" FontSize="11.5" />
                                                            <Button x:Name="BatchTargetPngBtn" Style="{StaticResource SecondaryButton}" Content="PNG" Padding="12,5" Margin="0,0,6,4" Click="BatchTargetFormat_Click" Tag="png" FontSize="11.5" />
                                                            <Button x:Name="BatchTargetJpegBtn" Style="{StaticResource SecondaryButton}" Content="JPEG" Padding="12,5" Margin="0,0,6,4" Click="BatchTargetFormat_Click" Tag="jpeg" FontSize="11.5" />
                                                        </WrapPanel>
                                                        <StackPanel x:Name="BatchConvertQualityPanel">
                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBlock Text="Encoding Quality" FontWeight="SemiBold" FontSize="11.5" />
                                                                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock x:Name="BatchConvertQualityBadge" Text="85%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                                </Border>
                                                            </DockPanel>
                                                            <Slider x:Name="BatchConvertQualitySlider" Minimum="1" Maximum="100" Value="85"
                                                                    ValueChanged="BatchConvertQualitySlider_ValueChanged" Margin="0,0,0,6" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="BatchConvertHintText" Text="WebP offers modern compression with alpha support." Style="{StaticResource MutedText}" FontSize="10.5" />
                                                    </StackPanel>

                                                    <!-- PANEL: RESIZE -->
                                                    <StackPanel x:Name="BatchResizeSettingsPanel" Visibility="Collapsed">
                                                        <TextBlock Text="Target Dimensions" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Width (px)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                                                                <TextBox x:Name="BatchResizeWidthBox" Text="1280" FontSize="11.5" Padding="6,4" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="×" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6" FontSize="12" />
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Height (px)" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,3" />
                                                                <TextBox x:Name="BatchResizeHeightBox" Text="720" FontSize="11.5" Padding="6,4" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <CheckBox x:Name="BatchResizeKeepAspectCheck" Content="Lock aspect ratio (scales height proportionally)" IsChecked="True" FontSize="11" Margin="0,0,0,8" />
                                                        <TextBlock Text="Scale Presets (longest edge):" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,4" />
                                                        <WrapPanel Margin="0,0,0,6">
                                                            <Button Style="{StaticResource SecondaryButton}" Content="720px" Padding="6,3" Margin="0,0,4,4" Click="BatchResizePreset_Click" Tag="720" FontSize="10.5" />
                                                            <Button Style="{StaticResource SecondaryButton}" Content="1080px" Padding="6,3" Margin="0,0,4,4" Click="BatchResizePreset_Click" Tag="1080" FontSize="10.5" />
                                                            <Button Style="{StaticResource SecondaryButton}" Content="1440px" Padding="6,3" Margin="0,0,4,4" Click="BatchResizePreset_Click" Tag="1440" FontSize="10.5" />
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <!-- PANEL: METADATA -->
                                                    <StackPanel x:Name="BatchMetadataSettingsPanel" Visibility="Collapsed">
                                                        <TextBlock Text="EXIF, GPS &amp; Camera Data Removal" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                                        <TextBlock Text="Normalizes pixel orientation and decodes/re-encodes the image without carrying forward EXIF, GPS coordinates, camera serials, or thumbnail chunks. Transparency and pixel data are preserved."
                                                                   Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Concurrency & Output Settings -->
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Concurrency Selector -->
                                                <Border Grid.Column="0" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="Execution Concurrency" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <RadioButton x:Name="BatchSequentialRadio" Content="Sequential" IsChecked="True" FontSize="11" Margin="0,0,12,0"
                                                                         ToolTip="Processes one image at a time (lowest memory usage)" />
                                                            <RadioButton x:Name="BatchParallelRadio" Content="Parallel (2 Workers)" FontSize="11"
                                                                         ToolTip="Processes two images simultaneously with bounded concurrency" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Output Info -->
                                                <Border Grid.Column="2" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="Output Location" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4" />
                                                        <TextBlock Text="SmartShift\Outputs" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" />
                                                        <TextBlock Text="Atomic .partial writes, collision-free naming" Style="{StaticResource MutedText}" FontSize="10" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Validation Error Text -->
                                            <TextBlock x:Name="BatchValidationErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" />

                                            <!-- Action Buttons: Start & Cancel -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                <Button x:Name="BatchStartButton" Style="{StaticResource PrimaryButton}" Click="StartBatchProcess_Click"
                                                        Padding="20,9" Margin="0,0,10,0" ToolTip="Start processing all images in the batch queue">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlayGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                                                        <TextBlock Text="Start Batch Process" FontWeight="Bold" FontSize="12.5" />
                                                    </StackPanel>
                                                </Button>

                                                <Button x:Name="BatchCancelButton" Style="{StaticResource SecondaryButton}" Click="CancelBatchProcess_Click"
                                                        Padding="16,9" IsEnabled="False" ToolTip="Cancel the active batch process safely">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource DangerBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock Text="Cancel Batch" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Live Progress Card -->
                                            <Border x:Name="BatchProgressCard" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock x:Name="BatchProgressTitle" Text="Processing batch…" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock x:Name="BatchProgressPercentText" DockPanel.Dock="Right" Text="0%" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
                                                    </DockPanel>

                                                    <ProgressBar x:Name="BatchProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                                                 Foreground="{DynamicResource AccentGradient}" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,0,8" />

                                                    <TextBlock x:Name="BatchProgressStatusText" Text="Initializing…" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />

                                                    <!-- Counters -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{DynamicResource OkSoftBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                                            <TextBlock x:Name="BatchProgressSucceededText" Text="✓ 0 Succeeded" Foreground="{DynamicResource OkBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                                            <TextBlock x:Name="BatchProgressFailedText" Text="✕ 0 Failed" Foreground="{DynamicResource DangerBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="4" Padding="8,2">
                                                            <TextBlock x:Name="BatchProgressCancelledText" Text="⊘ 0 Cancelled" Foreground="{DynamicResource WarnBrush}" FontSize="10.5" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Final Summary Card -->
                                            <Border x:Name="BatchSummaryCard" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <Path Data="{StaticResource IconCheckGeometry}" Fill="{DynamicResource OkBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                                        <TextBlock x:Name="BatchSummaryTitleText" Text="Batch Processing Complete" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="BatchSummaryDetailText" Text="All files completed." Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,10" />
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Open Output Folder" Click="OpenOutputs_Click" HorizontalAlignment="Left" Padding="14,6" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Selected Item Result Inspector -->
                                            <Border x:Name="BatchSelectedInspectorCard" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="16" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="ITEM DETAILS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
                                                    <TextBlock x:Name="BatchInspectorFileName" Text="photo.jpg" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="BatchInspectorStatusMessage" Text="Completed successfully" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,10" TextWrapping="Wrap" />

                                                    <StackPanel x:Name="BatchInspectorOutputBlock" Margin="0,0,0,8" Visibility="Collapsed">
                                                        <TextBlock Text="Output File:" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,2" />
                                                        <TextBlock x:Name="BatchInspectorOutputPath" Text="C:\Outputs\photo-compressed.jpg" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button x:Name="BatchInspectorOpenFileBtn" Style="{StaticResource SecondaryButton}" Content="Open Image" Click="BatchInspectorOpenFile_Click" Padding="10,5" Margin="0,0,6,0" FontSize="11" />
                                                            <Button x:Name="BatchInspectorRevealBtn" Style="{StaticResource SecondaryButton}" Content="Show in Folder" Click="BatchInspectorReveal_Click" Padding="10,5" FontSize="11" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- SIDEBAR FLYOUT: RECENT RESULTS             -->
        <!-- ========================================== -->
        <Border x:Name="RecentResultsFlyout" Grid.Row="1" Grid.RowSpan="2"
                Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Margin="70,10,20,20" Padding="20"
                HorizontalAlignment="Left" VerticalAlignment="Top" Width="400" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.6" />
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="CloseRecentFlyout_Click" Padding="4">
                        <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <TextBlock Text="Recent Session Results" Style="{StaticResource SectionHeading}" />
                </DockPanel>
                <TextBlock Text="Outputs produced during your current session:" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                <Border x:Name="RecentFileEntry" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="RecentFileNameText" Text="No operations completed yet" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="RecentFilePathText" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,10" TextTrimming="CharacterEllipsis" Text="Results will be listed here after you run an action." />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RecentOpenBtn" Style="{StaticResource SecondaryButton}" Content="Open file" Click="OpenFile_Click" Margin="0,0,8,0" IsEnabled="False" />
                            <Button x:Name="RecentFolderBtn" Style="{StaticResource SecondaryButton}" Content="Show in folder" Click="RevealResult_Click" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource SecondaryButton}" Content="Open Output Folder" Click="OpenOutputs_Click" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- SIDEBAR FLYOUT: SETTINGS & PRIVACY         -->
        <!-- ========================================== -->
        <Border x:Name="SettingsFlyout" Grid.Row="1" Grid.RowSpan="2"
                Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Margin="70,10,20,20" Padding="20"
                HorizontalAlignment="Left" VerticalAlignment="Top" Width="420" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.6" />
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="CloseSettingsFlyout_Click" Padding="4">
                        <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <TextBlock Text="Settings &amp; Architecture" Style="{StaticResource SectionHeading}" />
                </DockPanel>
                <!-- Privacy Guarantee -->
                <Border Background="{DynamicResource OkBgBrush}" BorderBrush="{DynamicResource OkBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="100% Local-First Guarantee" FontWeight="Bold" Foreground="{DynamicResource OkBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="All document and image operations are executed directly on your local hardware. No files, logs, or metrics leave your device."
                                   Style="{StaticResource MutedText}" FontSize="11.5" />
                    </StackPanel>
                </Border>
                <!-- Output Folder -->
                <TextBlock Text="Output Directory" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="SettingsOutputDirBox" IsReadOnly="True" Margin="0,0,0,8" />
                <Button Style="{StaticResource SecondaryButton}" Content="Open Outputs in Explorer" Click="OpenOutputs_Click" Margin="0,0,0,16" />
                <!-- Engine Details -->
                <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Active Local Engines" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <TextBlock Text="• Images: SkiaSharp (JPEG, PNG, WebP)" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                        <TextBlock Text="• PDF Preview &amp; Export: PDFium / Docnet.Core" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3" />
                        <TextBlock Text="• PDF Compression &amp; Office Export: UglyToad.PdfPig &amp; OpenXml" Style="{StaticResource MutedText}" FontSize="11" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- LOADING / INGEST OVERLAY                   -->
        <!-- ========================================== -->
        <Border x:Name="LoadingOverlay" Background="#D9080C14" Visibility="Collapsed" IsHitTestVisible="True"
                Grid.Row="0" Grid.RowSpan="3" CornerRadius="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="50" Height="50" CornerRadius="25" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,0,14" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconUploadGeometry}" Fill="{DynamicResource AccentBrush}" Width="22" Height="22" Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="LoadingTitle" Foreground="White" FontSize="16" FontWeight="SemiBold" Text="Inspecting files…" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadingDetail" Foreground="#94A3B8" Margin="0,6,0,0" Text="Reading file headers. Originals are never moved." HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>