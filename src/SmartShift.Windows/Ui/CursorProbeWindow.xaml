<Window x:Class="SmartShift.Windows.Ui.CursorProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartShift Probe"
        Width="220"
        Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#E6222A35"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True">
    <Border CornerRadius="8" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="10">
        <TextBlock x:Name="ProbeText"
                   Foreground="White"
                   TextWrapping="Wrap"
                   Text="Probe drop target (inspect only)" />
    </Border>
</Window>
