                                                        <TextBlock x:Name="DocxInfoPath" Text="—" Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                        <TextBlock x:Name="DocxInfoSize" Text="—" FontSize="11" Margin="0,0,0,4" />
                                                        <TextBlock x:Name="DocxInfoStats" Text="—" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,4" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Run Action Button -->
                                            <Button x:Name="DocxRunActionBtn" Style="{StaticResource PrimaryButton}" Padding="14,10" Margin="0,0,0,12" Click="DocxRunAction_Click">
