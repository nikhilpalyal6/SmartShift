<Window x:Class="SmartShift.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartShift â€” Unified File Workspace"
        Width="1260"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgGradient}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Compact Top Navigation Bar -->
            <RowDefinition Height="Auto" />
            <!-- Notification Banner -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- TOP NAVIGATION BAR                         -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,9">
            <DockPanel LastChildFill="False">
                <!-- Brand Title and Identity -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <!-- Brand Icon with subtle gradient glow -->
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentGradient}" Margin="0,0,12,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#EA580C" BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
                        </Border.Effect>
                        <Path Data="{StaticResource IconConvertGeometry}" Fill="White" Width="17" Height="17" Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SmartShift" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}" />
                            <!-- Local Privacy Indicator Badge -->
                            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource OkBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="LOCAL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Your private file workspace Â· Zero cloud uploads" Style="{StaticResource MutedText}" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Top Right Utility Actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Browse Files Action -->
                    <Button Style="{StaticResource PrimaryButton}" Click="BrowseFiles_Click"
                            ToolTip="Browse your computer to add images or PDFs" Margin="0,0,8,0" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlusGeometry}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Browse files" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Open Output Folder Button -->
                    <Button x:Name="OpenOutputsBtn" Style="{StaticResource SecondaryButton}" Content="Open output folder" Click="OpenOutputs_Click"
                            ToolTip="Opens the SmartShift output folder in Windows File Explorer" Margin="0,0,8,0">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolderGeometry}" Fill="{DynamicResource MutedBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                    <AccessText Text="Output folder" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- Locate Last Result Button -->
                    <Button x:Name="RevealResultButton" Style="{StaticResource SecondaryButton}" Content="Locate last result"
                            Click="RevealResult_Click" Visibility="Collapsed" Margin="0,0,8,0"
                            ToolTip="Selects the last processed output file in Windows File Explorer">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconExternalGeometry}" Fill="{DynamicResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                    <AccessText Text="Locate last result" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- Diagnostics Button -->
                    <Button x:Name="DiagnosticsButton" Style="{StaticResource GhostButton}" Content="Diagnostics"
                            Click="Diagnostics_Click" Visibility="Collapsed" ToolTip="Developer Diagnostics Window">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconInfoGeometry}" Fill="{DynamicResource MutedBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                    <AccessText Text="Diagnostics" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================== -->
        <!-- NOTIFICATION BANNER                        -->
        <!-- ========================================== -->
        <Border x:Name="Banner" Grid.Row="1" Margin="16,8,16,0" CornerRadius="10" BorderThickness="1"
                BorderBrush="#2610B981" Padding="16,9" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="CloseBanner_Click" Padding="4" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                </Button>
                <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="Medium" FontSize="12.5" />
            </DockPanel>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN APPLICATION BODY                      -->
        <!-- ========================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Compact Sidebar Navigation -->
                <ColumnDefinition x:Name="SidebarColDef" Width="64" />
                <!-- Workspace Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource GlassSidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,12">
                <DockPanel LastChildFill="False">
                    <!-- Top Navigation Items -->
                    <StackPanel DockPanel.Dock="Top">
                        <!-- Workspace Item -->
                        <Button x:Name="NavWorkspaceBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavWorkspace_Click" Tag="Active" Margin="0,0,0,6"
                                ToolTip="File Workspace &amp; Processing">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHomeGeometry}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                <TextBlock x:Name="NavWorkspaceText" Text="Workspace" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Queue Item -->
                        <Button x:Name="NavQueueBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavQueue_Click" Margin="0,0,0,6"
                                ToolTip="Current Processing Queue">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconQueueGeometry}" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                    <TextBlock x:Name="NavQueueText" Text="Queue" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                                </StackPanel>
                                <Border x:Name="NavQueueBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-2,0">
                                    <TextBlock x:Name="NavQueueBadgeText" Text="0" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Multi-Image Document Builder Nav Item -->
                        <Button x:Name="NavDocBuilderBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavDocBuilder_Click" Margin="0,0,0,6"
                                ToolTip="Document Builder: Images to PDF or PPTX">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDocumentGeometry}" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                <TextBlock x:Name="NavDocBuilderText" Text="Doc Builder" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Text-to-Presentation Studio Nav Item -->
                        <Button x:Name="NavPresentationBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavPresentation_Click" Margin="0,0,0,6"
                                ToolTip="Presentation Studio: Multi-format document to editable PPTX">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPresentationGeometry}" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                <TextBlock x:Name="NavPresentationText" Text="Presentations" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavPdfMergeBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavPdfMerge_Click" Margin="0,0,0,6"
                                ToolTip="PDF Merge Studio: Reorder and merge multiple PDF documents">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExportGeometry}" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                <TextBlock x:Name="NavPdfMergeText" Text="PDF Merge" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavPdfSplitBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavPdfSplit_Click" Margin="0,0,0,6"
                                ToolTip="PDF Split Studio: Extract selected page ranges or split every page">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSplitGeometry}" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                <TextBlock x:Name="NavPdfSplitText" Text="PDF Split" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavPdfOrganizeBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavPdfOrganize_Click" Margin="0,0,0,6"
                                ToolTip="PDF Page Organizer: Reorder, rotate, delete, and organize PDF pages visually">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconOrganizerGeometry}" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                <TextBlock x:Name="NavPdfOrganizeText" Text="PDF Organizer" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        


                        <!-- Recent Files / Results -->
                        <Button x:Name="NavRecentBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavRecent_Click" Margin="0,0,0,6"
                                ToolTip="Recent Results (Current Session)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHistoryGeometry}" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                <TextBlock x:Name="NavRecentText" Text="Recent" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <!-- Settings & Privacy -->
                        <Button x:Name="NavSettingsBtn" Style="{StaticResource NavSidebarButtonStyle}" Click="NavSettings_Click"
                                ToolTip="Settings &amp; Local Engine Status">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettingsGeometry}" Fill="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" Margin="2,0,0,0" />
                                <TextBlock x:Name="NavSettingsText" Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Sidebar Controls -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <!-- Privacy Lock Indicator -->
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="6" Margin="0,0,0,8" ToolTip="All operations executed locally">
                            <Path Data="{StaticResource IconLockGeometry}" Fill="{DynamicResource OkBrush}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" />
                        </Border>

                        <!-- Sidebar Toggle Expand/Collapse -->
                        <Button Style="{StaticResource GhostButton}" Click="ToggleSidebar_Click" ToolTip="Expand or collapse sidebar" Padding="6" HorizontalAlignment="Center">
                            <Path Data="M9 5l7 7-7 7" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- WORKSPACE CONTENT AREA (3 Responsive Columns) -->
            <Grid Grid.Column="1" Margin="14">
                <Grid.ColumnDefinitions>
                    <!-- Column 0: Left File Shelf & Drop Zone -->
                    <ColumnDefinition Width="310" MinWidth="260" MaxWidth="400" />
                    <!-- Splitter -->
                    <ColumnDefinition Width="10" />
                    <!-- Column 2: Center Contextual Action & Preview Workspace -->
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <!-- Splitter -->
                    <ColumnDefinition Width="10" />
                    <!-- Column 4: Right Action Settings & Results -->
                    <ColumnDefinition Width="360" MinWidth="320" MaxWidth="460" />
                </Grid.ColumnDefinitions>

                <!-- ========================================== -->
                <!-- COLUMN 0: LEFT FILE SHELF                  -->
                <!-- ========================================== -->
                <Border Grid.Column="0" Style="{StaticResource Card}" x:Name="DropZone" Padding="12">
                    <DockPanel>
                        <!-- Shelf Header -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Workspace Files" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                                <Border x:Name="QueueCountBadge" Background="{DynamicResource SurfaceElevatedBrush}"
                                        CornerRadius="9" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="QueueCountText" Text="0 files" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                </Border>
                            </StackPanel>

                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear queue"
                                    Click="ClearQueue_Click" HorizontalAlignment="Right"
                                    ToolTip="Removes all items from this list. Does not delete any files on disk.">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconTrashGeometry}" Fill="{DynamicResource MutedBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                            <AccessText Text="Clear" FontSize="11.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </DockPanel>

                        <!-- Shelf Status Subhead -->
                        <TextBlock x:Name="QueueSummary" DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                   Text="Drop files to begin." />

                        <!-- Compact Drop Cue when files exist -->
                        <Border x:Name="CompactDropCue" DockPanel.Dock="Top" Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="9,7" Margin="0,0,0,10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconUploadGeometry}" Fill="{DynamicResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Drop more files to add" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Batch Action Button when multiple images exist in queue -->
                        <Button x:Name="ShelfBatchButton" DockPanel.Dock="Top" Style="{StaticResource PrimaryButton}"
                                Click="OpenBatchStudio_Click" Padding="10,7" Margin="0,0,0,10" Visibility="Collapsed"
                                ToolTip="Open Batch Image Studio to process multiple images in one batch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconQueueGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock x:Name="ShelfBatchButtonText" Text="Batch Process Images" FontWeight="SemiBold" FontSize="11.5" />
                            </StackPanel>
                        </Button>

                        <!-- Multi-Image Document Builder Button when images exist in queue -->
                        <Button x:Name="ShelfBuildDocButton" DockPanel.Dock="Top" Style="{StaticResource SecondaryButton}"
                                Click="OpenDocBuilder_Click" Padding="10,7" Margin="0,0,0,10" Visibility="Collapsed"
                                ToolTip="Combine images into a single PDF document or PowerPoint presentation">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconDocumentGeometry}" Fill="{DynamicResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock x:Name="ShelfBuildDocButtonText" Text="Build Document (PDF/PPTX)" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Button>

                        <!-- Queue List & Empty State Host -->
                        <Grid>
                            <!-- Large Empty State Drop Area -->
                            <Border x:Name="EmptyState" Background="{DynamicResource GlassCardBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1.5"
                                    CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,10">
                                <StackPanel HorizontalAlignment="Center" Margin="14,24">
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,0,12" HorizontalAlignment="Center">
                                        <TextBlock Text="DROP FILES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <TextBlock Text="Drop files here" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="Drag images or PDFs from Explorer."
                                               Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,0,0,14" />

                                    <!-- Browse Files Button inside Drop Zone -->
                                    <Button Style="{StaticResource PrimaryButton}" Click="BrowseFiles_Click" HorizontalAlignment="Center" Padding="16,7" Margin="0,0,0,16">
                                        <TextBlock Text="Browse Files" FontSize="12" FontWeight="SemiBold" />
                                    </Button>

                                    <!-- Supported File Type Badges -->
                                    <WrapPanel HorizontalAlignment="Center">
                                        <Border Background="#162238" CornerRadius="4" Padding="6,2.5" Margin="2">
                                            <TextBlock Text="PNG" FontSize="9.5" FontWeight="Bold" Foreground="#60A5FA" />
                                        </Border>
                                        <Border Background="#162238" CornerRadius="4" Padding="6,2.5" Margin="2">
                                            <TextBlock Text="JPEG" FontSize="9.5" FontWeight="Bold" Foreground="#FBBF24" />
                                        </Border>
                                        <Border Background="#162238" CornerRadius="4" Padding="6,2.5" Margin="2">
                                            <TextBlock Text="WEBP" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>
                                        <Border Background="#162238" CornerRadius="4" Padding="6,2.5" Margin="2">
                                            <TextBlock Text="PDF" FontSize="9.5" FontWeight="Bold" Foreground="#F87171" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="Original files are never overwritten." FontSize="10" Foreground="{DynamicResource SubtleBrush}" TextAlignment="Center" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- File List -->
                            <ListBox x:Name="FileList" Visibility="Collapsed" SelectionChanged="FileList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Real Thumbnail / Vector Icon -->
                                                    <ColumnDefinition Width="42" />
                                                    <!-- Metadata -->
                                                    <ColumnDefinition Width="*" />
                                                    <!-- Remove button -->
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Real Thumbnail or Type-Specific Icon Container -->
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6"
                                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        ClipToBounds="True" Margin="0,0,10,0" HorizontalAlignment="Left">
                                                    <Grid>
                                                        <!-- When real thumbnail is available -->
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />

                                                        <!-- Vector fallback icon when no thumbnail -->
                                                        <Path Data="{Binding CategoryIconKey, Converter={x:Null}}"
                                                              Fill="{Binding FormatTagBrush}"
                                                              Width="18" Height="18" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                </Border>

                                                <!-- File Information Block -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Background="{Binding FormatTagBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Extension}" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Remove button -->
                                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="4"
                                                        Click="RemoveFile_Click" Tag="{Binding}" ToolTip="Remove from list. Disk file is unchanged.">
                                                    <Path Data="{StaticResource IconCloseGeometry}" Fill="{DynamicResource MutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Grid Splitter -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- ========================================== -->
                <!-- COLUMN 2: CENTER ACTION & PREVIEW AREA     -->
                <!-- ========================================== -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid x:Name="RadialWorkspaceHost">
                        <!-- Warm sunset aura behind radial petal wheel -->
                        <Ellipse Width="540" Height="540" IsHitTestVisible="False" Opacity="0.18"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#F97316" Offset="0" />
                                    <GradientStop Color="#EA580C" Offset="0.45" />
                                    <GradientStop Color="#00EA580C" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- When No File Selected: Guidance State -->
                        <Border x:Name="EmptyRadialPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Visible" MaxWidth="440" Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="32,36">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="WORKSPACE READY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <TextBlock Text="Unified File Workspace" FontSize="20" FontWeight="Bold" TextAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Select a file from the shelf on the left or drop an image or PDF to inspect properties and run local operations."
                                           Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,22" />
                                <Button Style="{StaticResource PrimaryButton}" Click="BrowseFiles_Click" HorizontalAlignment="Center" Padding="20,9">
                                    <TextBlock Text="Browse Files to Start" FontSize="12.5" FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Selected File Workspace Host (Smart Header + Smart Circle) -->
                        <Grid x:Name="SmartCircleWorkspaceGrid">
                            <Grid.RowDefinitions>
                                <!-- Top Compact File Info Bar -->
                                <RowDefinition Height="Auto" />
                                <!-- Smart Circle Interactive Orbit Canvas -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Compact File Info Bar -->
                            <Border x:Name="CenterFileHeaderBar" Grid.Row="0" Background="{DynamicResource GlassPanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9"
                                    Visibility="Collapsed">
                                <DockPanel LastChildFill="True">
                                    <!-- Quick Action for PDF: View Document -->
                                    <Button DockPanel.Dock="Right" x:Name="HeroOpenPdfBtn" Style="{StaticResource SecondaryButton}"
                                            Click="HeroOpenPdf_Click" Visibility="Collapsed" VerticalAlignment="Center" Padding="11,5"
                                            ToolTip="Open interactive PDF document viewer">
                                        <TextBlock Text="View Document" FontSize="11.5" FontWeight="SemiBold" />
                                    </Button>

                                    <!-- Quick Action for Image: Edit Image -->
                                    <Button DockPanel.Dock="Right" x:Name="HeroEditImageBtn" Style="{StaticResource PrimaryButton}"
                                            Click="HeroEditImage_Click" Visibility="Collapsed" VerticalAlignment="Center" Padding="12,5" Margin="0,0,8,0"
                                            ToolTip="Open interactive image editor to crop, rotate, flip &amp; resize">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCropGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Edit Image" FontSize="11.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Quick Action for Importable Documents: Import Presentation -->
                                    <Button DockPanel.Dock="Right" x:Name="HeroImportPresentationBtn" Style="{StaticResource PrimaryButton}"
                                            Click="HeroImportPresentation_Click" Visibility="Collapsed" VerticalAlignment="Center" Padding="12,5" Margin="0,0,8,0"
                                            ToolTip="Import document headings and content into Presentation Studio">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconPptxGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Import Presentation" FontSize="11.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Quick Action for Universal Conversion: Convert -->
                                    <Button DockPanel.Dock="Right" x:Name="HeroConvertBtn" Style="{StaticResource PrimaryButton}"
                                            Click="HeroConvert_Click" Visibility="Collapsed" VerticalAlignment="Center" Padding="12,5" Margin="0,0,8,0"
                                            ToolTip="Convert this file to another supported format">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconConvertGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="Convert" FontSize="11.5" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Hotkey hint -->
                                    <TextBlock DockPanel.Dock="Right" Text="Press 1â€“7 to select action" FontSize="11" Foreground="{DynamicResource SubtleBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <!-- File Info & Specs -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="HeroFileNameText" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border x:Name="HeroFormatBadge" CornerRadius="3" Padding="5,1.5" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,6,0">
                                                <TextBlock x:Name="HeroFormatText" Text="FILE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock x:Name="HeroFileSizeText" Text="" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="HeroDimensionsText" Text="" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Active Smart Circle Orbital Canvas -->
                            <Canvas Grid.Row="1" x:Name="RadialMenuCanvas" Visibility="Collapsed"
                                    SizeChanged="RadialMenuCanvas_SizeChanged">

                                <!-- Smart Dynamic Connecting Beam (Preserved hidden for safety) -->
                                <Line x:Name="SmartConnectingBeam"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      IsHitTestVisible="False" />

                                <!-- Outer Framing Track -->
                                <Ellipse x:Name="OrbitalRing" Stroke="#40FDE68A"
                                         StrokeThickness="1" IsHitTestVisible="False" />

                                <!-- Inner Concentric Hub Rim (Golden Amber Specular Rim) -->
                                <Ellipse x:Name="InnerOrbitalRing" Stroke="#B3F59E0B"
                                         StrokeThickness="2" IsHitTestVisible="False" />

                                <!-- Ambient Breathing Halo behind Center Core -->
                                <Ellipse x:Name="CenterCoreHalo" IsHitTestVisible="False" Opacity="0.32">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#80F97316" Offset="0" />
                                            <GradientStop Color="#40EA580C" Offset="0.5" />
                                            <GradientStop Color="#00000000" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#EA580C" BlurRadius="36" ShadowDepth="0" Opacity="0.65" />
                                    </Ellipse.Effect>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.22" To="0.52" Duration="0:0:2.4">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>

                                <!-- Center Selected File Viewport Container (Smart Core - Mathematically Circular) -->
                                <Border x:Name="CenterPreviewContainer"
                                        Background="#E6111827"
                                        BorderBrush="#80F59E0B"
                                        BorderThickness="2"
                                        CornerRadius="105"
                                        ClipToBounds="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.75" />
                                    </Border.Effect>
                                    <Border.OpacityMask>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="Black" Offset="0.98" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.OpacityMask>
                                    <Grid>
                                        <!-- Center Image Preview -->
                                        <Image x:Name="CenterPreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />

                                        <!-- Center PDF / Document Placeholder -->
                                        <StackPanel x:Name="CenterDocumentPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="180">
                                            <Border x:Name="CenterDocIconBorder" Width="50" Height="50" CornerRadius="12" Background="{DynamicResource DangerSoftBrush}"
                                                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                                    Margin="0,0,0,8" HorizontalAlignment="Center">
                                                <Path x:Name="CenterDocIconPath" Data="{StaticResource IconPdfGeometry}" Fill="{DynamicResource DangerBrush}" Width="26" Height="26" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock x:Name="CenterDocFormat" Text="PDF Document" FontWeight="Bold" FontSize="13.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="CenterDocVersion" Text="%PDF-1.7" Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Top Format Pill Floating Inside Core -->
                                        <Border Background="#E6080C14" BorderBrush="#80F59E0B" BorderThickness="1"
                                                CornerRadius="8" Padding="9,3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
                                            <TextBlock x:Name="CenterPreviewLabel" Text="Source Preview" FontSize="10" FontWeight="SemiBold" Foreground="#FDE68A" />
                                        </Border>

                                        <!-- Bottom Active Action Status Capsule Inside Core -->
                                        <Border x:Name="CenterActiveActionPill" Background="#F2EA580C" BorderBrush="#FFFFFFFF" BorderThickness="1"
                                                CornerRadius="12" Padding="11,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#EA580C" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="CenterActiveActionText" Text="Ready" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Dropover Radial Petal Wheel Actions Control -->
                                <ItemsControl x:Name="RadialActionsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="0" />
                                            <Setter Property="Canvas.Top" Value="0" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DropoverPetalStyle}"
                                                    Click="RadialAction_Click"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding IsAvailable}"
                                                    AutomationProperties.Name="{Binding FullTitle}">
                                                <Button.ToolTip>
                                                    <ToolTip Background="#111827" BorderBrush="#34466D" Foreground="White">
                                                        <StackPanel MaxWidth="240">
                                                            <TextBlock Text="{Binding FullTitle}" FontWeight="Bold" FontSize="13" />
                                                            <TextBlock Text="{Binding GoalTitle}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,4" />
                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" />
                                                            <Border Background="{Binding BadgeBrush}" CornerRadius="4" Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeForeground}" FontSize="10" FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Fallback / Hidden reference for test compatibility -->
                                <ItemsControl x:Name="ModernActionCardsControl" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>

                                                <Grid x:Name="DocxWorkspaceHost" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}">
                            <Grid.RowDefinitions>
                                <!-- Top Document Header Bar -->
                                <RowDefinition Height="Auto" />
                                <!-- Main 2-Column Content Area -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Top Document Header Bar -->
                            <Border Grid.Row="0" Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="14,10">
                                <DockPanel LastChildFill="True">
                                    <!-- Quick Action Buttons on Right -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="DocxHeroPdfBtn" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="12,6" Click="DocxHeroPdf_Click" ToolTip="Convert this Word document to PDF">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconDocumentGeometry}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="Convert to PDF" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DocxHeroPptxBtn" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6" Click="DocxHeroPptx_Click" ToolTip="Convert this Word document to PowerPoint slides">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPresentationGeometry}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="Convert to PPTX" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DocxHeroCompressBtn" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="DocxHeroCompress_Click" ToolTip="Compress Word document package">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconCompressGeometry}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                <TextBlock Text="Compress" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Document Identity -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                                            <Path Data="{StaticResource IconWordGeometry}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock x:Name="DocxHeaderFileName" Text="Document.docx" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0" />
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                    <TextBlock Text="DOCX" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="DocxHeaderFileSize" Text="—" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,10,0" />
                                                <TextBlock x:Name="DocxHeaderStatus" Text="Document workspace ready" FontSize="10.5" Foreground="{DynamicResource OkBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Main 2-Column Grid -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <!-- Left: Structured Document Content Preview -->
                                    <ColumnDefinition Width="3*" MinWidth="320" />
                                    <ColumnDefinition Width="6" />
                                    <!-- Right: Document Actions & Settings Panel -->
                                    <ColumnDefinition Width="2*" MinWidth="280" MaxWidth="440" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Document Preview -->
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Stats bar -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Document Content ScrollViewer -->
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Stats Bar -->
                                        <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                    <TextBlock Text="WORDS" Style="{StaticResource MutedText}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="DocxStatWords" Text="0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                    <TextBlock Text="CHARACTERS" Style="{StaticResource MutedText}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="DocxStatChars" Text="0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                    <TextBlock Text="HEADINGS" Style="{StaticResource MutedText}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="DocxStatHeadings" Text="0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                                    <TextBlock Text="SECTIONS" Style="{StaticResource MutedText}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="DocxStatSections" Text="0" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource OkBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Scrollable Structured Content Preview -->
                                        <Border Grid.Row="1" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="14">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="DocxContentHost" Margin="0,0,8,0">
                                                    <TextBlock x:Name="DocxPreviewTitle" Text="Document Title" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />
                                                    <ItemsControl x:Name="DocxSectionsControl">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,14">
                                                                    <!-- Section Heading -->
                                                                    <Border Visibility="{Binding HeadingVisibility}" Margin="0,4,0,6">
                                                                        <TextBlock Text="{Binding Heading}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                                                                    </Border>
                                                                    <!-- Paragraphs and Bullets -->
                                                                    <ItemsControl ItemsSource="{Binding Blocks}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                                    <TextBlock Text="•" Margin="4,0,8,0" Foreground="{DynamicResource MutedBrush}"
                                                                                               Visibility="{Binding BulletVisibility}" />
                                                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                                                                                               Foreground="{DynamicResource TextBrush}" FontSize="11.5" LineHeight="16" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock x:Name="DocxEmptyPreviewHint" Text="No readable text sections discovered in this Word document."
                                                               Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Splitter -->
                                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                                <!-- Right Column: Document Actions & Settings -->
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1,0,0,0" Padding="16">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- Action Selection Tabs -->
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                <TextBlock Text="DOCUMENT ACTIONS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="Choose an operation" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                                            <WrapPanel Margin="0,0,0,14">
                                                <Button x:Name="DocxTabPdfBtn" Style="{StaticResource PrimaryButton}" Content="Convert to PDF" Padding="10,6" Margin="0,0,6,6" Click="DocxTabPdf_Click" />
                                                <Button x:Name="DocxTabPptxBtn" Style="{StaticResource SecondaryButton}" Content="Convert to PPTX" Padding="10,6" Margin="0,0,6,6" Click="DocxTabPptx_Click" />
                                                <Button x:Name="DocxTabCompressBtn" Style="{StaticResource SecondaryButton}" Content="Compress DOCX" Padding="10,6" Margin="0,0,6,6" Click="DocxTabCompress_Click" />
                                                <Button x:Name="DocxTabPresentationBtn" Style="{StaticResource SecondaryButton}" Content="Presentation Studio" Padding="10,6" Margin="0,0,6,6" Click="DocxTabPresentation_Click" />
                                                <Button x:Name="DocxTabInfoBtn" Style="{StaticResource SecondaryButton}" Content="Details" Padding="10,6" Margin="0,0,6,6" Click="DocxTabInfo_Click" />
                                            </WrapPanel>

                                            <!-- Panel: PDF Settings -->
                                            <StackPanel x:Name="DocxPdfSettingsPanel" Visibility="Visible">
                                                <TextBlock Text="PDF Conversion Options" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                                <TextBlock Text="Convert your Word document into a high-fidelity vector PDF." Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,10" />

                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="Structure Preservation Guarantee" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
                                                        <TextBlock Text="• Headings and body typography preserved" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                                        <TextBlock Text="• Tables rendered with borders and cells" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                                        <TextBlock Text="• Embedded images extracted and embedded" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                                        <TextBlock Text="• Multi-page pagination and margins applied" Style="{StaticResource MutedText}" FontSize="10.5" />
                                                    </StackPanel>
                                                </Border>

                                                <CheckBox x:Name="DocxPreferWordAppBox" Content="Prefer Microsoft Word local engine if installed" Margin="0,0,0,12"
                                                          Foreground="{DynamicResource TextBrush}" FontSize="11" ToolTip="Uses local Microsoft Word to generate exact 1:1 PDF layout" />

                                                <TextBlock Text="Output File Name" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4" />
                                                <TextBox x:Name="DocxPdfOutputNameBox" Margin="0,0,0,14" />
                                            </StackPanel>

                                            <!-- Panel: PPTX Settings -->
                                            <StackPanel x:Name="DocxPptxSettingsPanel" Visibility="Collapsed">
                                                <TextBlock Text="PowerPoint Presentation Options" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                                <TextBlock Text="Creates an editable presentation deck with deterministic slide splitting." Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,10" />

                                                <TextBlock Text="Presentation Theme" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4" />
                                                <ComboBox x:Name="DocxPptxThemeBox" Margin="0,0,0,10" SelectedIndex="0">
                                                    <ComboBoxItem Content="Dark Slate (Modern Dark)" />
                                                    <ComboBoxItem Content="Classic Navy (Corporate)" />
                                                    <ComboBoxItem Content="Modern Minimal (Clean Light)" />
                                                </ComboBox>

                                                <TextBlock Text="Aspect Ratio" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4" />
                                                <ComboBox x:Name="DocxPptxAspectBox" Margin="0,0,0,10" SelectedIndex="0">
                                                    <ComboBoxItem Content="Widescreen (16:9)" />
                                                    <ComboBoxItem Content="Standard (4:3)" />
                                                </ComboBox>

                                                <CheckBox x:Name="DocxPptxTitleSlideBox" Content="Generate title slide from document metadata" IsChecked="True"
                                                          Margin="0,0,0,12" Foreground="{DynamicResource TextBrush}" FontSize="11" />

                                                <TextBlock Text="Output File Name" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4" />
                                                <TextBox x:Name="DocxPptxOutputNameBox" Margin="0,0,0,14" />
                                            </StackPanel>

                                            <!-- Panel: Compress Settings -->
                                            <StackPanel x:Name="DocxCompressSettingsPanel" Visibility="Collapsed">
                                                <TextBlock Text="Word Document Compression" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                                                <TextBlock Text="Recompress OpenXML ZIP packaging and safely optimize embedded media." Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,10" />

                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock Text="Safe Optimization Standards" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
                                                        <TextBlock Text="• Maximum standard zlib recompression" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
                                                        <TextBlock Text="• Embedded image stream optimization" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,2" />
